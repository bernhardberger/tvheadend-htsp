{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "release/**": "deny",
      ".github/workflows/release.yml": "deny",
      "tools/publish-central-release": "deny",
      "docs/extraction/**": "deny",
      "docs/htsp-protocol/upstream.json": "deny",
      "src/main/kotlin/**/Generated*.kt": "deny",
      "api/htsp.api": "ask",
      "docs/htsp-protocol/htsp_spec.json": "ask"
    },
    "bash": {
      "*": "allow",
      "git commit*": "allow",
      "git commit --amend*": "deny",
      "git push*": "deny",
      "git tag*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "gh release*": "deny",
      "gh auth*": "deny"
    }
  }
}
