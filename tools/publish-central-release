                "GitHub finalizer before Central publish",
                "ordering is invalid",
                original
                .replace("./tools/publish-central-release --publish", "ORDER_PLACEHOLDER", 1)
                .replace("./tools/publish-central-release --finalize-github-release", "./tools/publish-central-release --publish", 1)
                .replace("ORDER_PLACEHOLDER", "./tools/publish-central-release --finalize-github-release", 1),
            ),
            (
                "one-shot gh release creation",
