class FakeGitHub:
    """In-memory GitHub Releases REST fixture for finalizer regression tests."""

    def __init__(self) -> None:
        self.releases: list[dict[str, object]] = []
        self.assets: dict[int, list[dict[str, object]]] = {}
        self.asset_bytes: dict[int, bytes] = {}
        self.next_release_id = 1
        self.next_asset_id = 100
        self.fail_after_stored_upload = False
        self.failed_once = False
        self.published_transitions = 0

    def add_release(
        self,
        identity: ReleaseIdentity,
        notes: str,
        *,
        draft: bool,
        name: str | None = None,
        tag: str | None = None,
        prerelease: bool = True,
    ) -> dict[str, object]:
        release_id = self.next_release_id
        self.next_release_id += 1
        release: dict[str, object] = {
            "id": release_id,
            "tag_name": identity.tag if tag is None else tag,
            "name": identity.tag if name is None else name,
            "body": notes,
            "draft": draft,
            "prerelease": prerelease,
            "upload_url": f"https://uploads.github.test/repos/{REPOSITORY}/releases/{release_id}/assets{{?name,label}}",
        }
        self.releases.append(release)
        self.assets[release_id] = []
        return release

    def add_asset(self, release: dict[str, object], name: str, data: bytes, *, digest: str | None = None) -> None:
        asset_id = self.next_asset_id
        self.next_asset_id += 1
        current = {
            "id": asset_id,
            "name": name,
            "size": len(data),
            "digest": f"sha256:{sha256(data)}" if digest is None else digest,
        }
        self.assets[int(release["id"])].append(current)
        self.asset_bytes[asset_id] = data

    def client(self, method: str, url: str, headers: dict[str, str], body: bytes | None) -> HttpResponse:
        if headers.get("Authorization") != "Bearer synthetic-github-token":
            return HttpResponse(401, b"{}")
        parsed = urllib.parse.urlsplit(url)
        path = parsed.path
        releases_path = f"/repos/{REPOSITORY}/releases"
        if method == "GET" and path == releases_path:
            page = urllib.parse.parse_qs(parsed.query).get("page", ["1"])[0]
            return HttpResponse(200, json.dumps(self.releases if page == "1" else []).encode())
        if method == "POST" and path == releases_path:
            model = json.loads((body or b"").decode())
            identity = ReleaseIdentity(model["tag_name"][1:], model["tag_name"], "unused")
            release = self.add_release(
                identity,
                model["body"],
                draft=model["draft"],
                name=model["name"],
                prerelease=model["prerelease"],
            )
            return HttpResponse(201, json.dumps(release).encode())
        release_match = re.fullmatch(re.escape(releases_path) + r"/([0-9]+)", path)
        if release_match:
            release_id = int(release_match.group(1))
            release = next((item for item in self.releases if item["id"] == release_id), None)
            if release is None:
                return HttpResponse(404, b"{}")
            if method == "GET":
                return HttpResponse(200, json.dumps(release).encode())
            if method == "PATCH":
                model = json.loads((body or b"").decode())
                if release["draft"] and model.get("draft") is False:
                    self.published_transitions += 1
                release.update({key: value for key, value in model.items() if key != "make_latest"})
                return HttpResponse(200, json.dumps(release).encode())
        assets_match = re.fullmatch(re.escape(releases_path) + r"/([0-9]+)/assets", path)
        if assets_match and method == "GET":
            return HttpResponse(200, json.dumps(self.assets[int(assets_match.group(1))]).encode())
        delete_match = re.fullmatch(re.escape(releases_path) + r"/assets/([0-9]+)", path)
        if delete_match and method == "DELETE":
            asset_id = int(delete_match.group(1))
            for release_assets in self.assets.values():
                release_assets[:] = [item for item in release_assets if item["id"] != asset_id]
            self.asset_bytes.pop(asset_id, None)
            return HttpResponse(204, b"")
        upload_match = re.fullmatch(re.escape(releases_path) + r"/([0-9]+)/assets", path)
        if parsed.netloc == "uploads.github.com" and upload_match and method == "POST":
            name = urllib.parse.parse_qs(parsed.query).get("name", [""])[0]
            release = next(item for item in self.releases if item["id"] == int(upload_match.group(1)))
            self.add_asset(release, name, body or b"")
            if self.fail_after_stored_upload and not self.failed_once:
                self.failed_once = True
                return HttpResponse(500, b"{}")
            return HttpResponse(201, b"{}")
        return HttpResponse(404, b"{}")


def github_finalizer_regression_tests(
    identity: ReleaseIdentity,
    output: Path,
    commit: str,
    originals: tuple[Original, ...],
) -> list[str]:
    errors: list[str] = []
    required = globals().get("github_release_inputs")
    finalize = globals().get("finalize_github_release_state")
    if required is None or finalize is None:
        return ["self-test requires draft-first idempotent GitHub finalizer mode"]
    expected, notes = required(output, identity, commit, originals)

    absent = FakeGitHub()
    finalize(identity, commit, expected, notes, "synthetic-github-token", absent.client)
    if len(absent.releases) != 1 or absent.releases[0]["draft"] is not False:
        errors.append("absent GitHub release did not converge through a draft to publication")
    if set(item["name"] for item in absent.assets[1]) != set(expected) or absent.published_transitions != 1:
        errors.append("absent GitHub release did not upload exactly 22 assets before one publish transition")

    interrupted = FakeGitHub()
    interrupted.fail_after_stored_upload = True
    expect_error(
        errors,
        "injected partial GitHub asset upload failure",
        lambda: finalize(identity, commit, expected, notes, "synthetic-github-token", interrupted.client),
    )
    if not interrupted.releases or interrupted.releases[0]["draft"] is not True or interrupted.published_transitions:
        errors.append("failed partial GitHub upload published the draft")
    finalize(identity, commit, expected, notes, "synthetic-github-token", interrupted.client)
    if interrupted.releases[0]["draft"] is not False or set(item["name"] for item in interrupted.assets[1]) != set(expected):
        errors.append("GitHub finalizer rerun did not converge after partial upload")

    repair = FakeGitHub()
    repair_release = repair.add_release(identity, notes, draft=True)
    first_name = sorted(expected)[0]
    repair.add_asset(repair_release, first_name, b"wrong")
    finalize(identity, commit, expected, notes, "synthetic-github-token", repair.client)
    repaired_assets = repair.assets[int(repair_release["id"])]
    repaired = next(item for item in repaired_assets if item["name"] == first_name)
    if not exact_github_asset(repaired, first_name, expected[first_name]) or repair_release["draft"] is not False:
        errors.append("wrong expected draft asset was not replaced before publication")

    unexpected_draft = FakeGitHub()
    unexpected_release = unexpected_draft.add_release(identity, notes, draft=True)
    unexpected_draft.add_asset(unexpected_release, "unexpected", b"x")
    expect_error(
        errors,
        "unexpected draft GitHub asset",
        lambda: finalize(identity, commit, expected, notes, "synthetic-github-token", unexpected_draft.client),
    )
    if unexpected_release["draft"] is not True:
        errors.append("unexpected GitHub draft asset did not fail before publication")

    duplicate_asset = FakeGitHub()
    duplicate_asset_release = duplicate_asset.add_release(identity, notes, draft=True)
    duplicate_asset.add_asset(duplicate_asset_release, first_name, expected[first_name])
    duplicate_asset.add_asset(duplicate_asset_release, first_name, expected[first_name])
    expect_error(
        errors,
        "duplicate draft GitHub asset name",
        lambda: finalize(identity, commit, expected, notes, "synthetic-github-token", duplicate_asset.client),
    )

    published = FakeGitHub()
    exact_release = published.add_release(identity, notes, draft=False)
    for name, data in expected.items():
        published.add_asset(exact_release, name, data)
    finalize(identity, commit, expected, notes, "synthetic-github-token", published.client)
    if published.published_transitions:
        errors.append("exact published GitHub prerelease rerun was not idempotent")

    def rejected(label: str, mutate: Callable[[FakeGitHub, dict[str, object]], None]) -> None:
        fixture = FakeGitHub()
        release = fixture.add_release(identity, notes, draft=False)
        for name, data in expected.items():
            fixture.add_asset(release, name, data)
        mutate(fixture, release)
        expect_error(errors, label, lambda: finalize(identity, commit, expected, notes, "synthetic-github-token", fixture.client))
        if fixture.published_transitions:
            errors.append(f"{label} unexpectedly mutated published state")

    rejected("unexpected published GitHub asset", lambda fixture, release: fixture.add_asset(release, "unexpected", b"x"))
    rejected("wrong published GitHub asset bytes", lambda fixture, _release: fixture.assets[1][0].update(size=999))
    rejected("wrong published GitHub asset digest", lambda fixture, _release: fixture.assets[1][0].update(digest="sha256:" + "0" * 64))
    rejected("wrong published GitHub notes", lambda _fixture, release: release.update(body="wrong"))
    rejected("wrong published GitHub tag", lambda _fixture, release: release.update(tag_name="v9.9.9"))
    rejected("wrong published GitHub title", lambda _fixture, release: release.update(name="wrong"))
    rejected("wrong published GitHub type", lambda _fixture, release: release.update(prerelease=False))

    duplicate = FakeGitHub()
    duplicate.add_release(identity, notes, draft=True)
    duplicate.add_release(identity, notes, draft=True)
    expect_error(errors, "duplicate GitHub release for exact tag", lambda: finalize(identity, commit, expected, notes, "synthetic-github-token", duplicate.client))

    missing = output / "release-notes.md"
    saved = missing.read_bytes()
    missing.unlink()
    try:
        expect_error(errors, "missing finalizer output", lambda: required(output, identity, commit, originals))
    finally:
        missing.write_bytes(saved)
    return errors


def setup_regression_tests() -> list[str]:
    errors: list[str] = []
    baseline = setup_errors(ROOT)
    if baseline:
        return ["self-test setup baseline failed: " + "; ".join(baseline)]
    with tempfile.TemporaryDirectory() as temporary:
        fixture = Path(temporary) / "repository"
        shutil.copytree(ROOT, fixture, symlinks=True, ignore=shutil.ignore_patterns(".git", "build", "__pycache__"))
        workflow_path = fixture / ".github/workflows/release.yml"
        original = workflow_path.read_text(encoding="utf-8")
        cases = (
            (
                "missing GitHub finalizer invocation",
                "invoke GitHub finalizer mode",
                original.replace("./tools/publish-central-release --finalize-github-release", "true", 1),
            ),
            (
                "Central secret exposed to GitHub finalizer",
                "release secret references",
                original.replace(
                    "          GH_TOKEN: ${{ github.token }}",
