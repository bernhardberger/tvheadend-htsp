def digest(data: bytes, algorithm: str = "sha256") -> str:
    return hashlib.new(algorithm, data).hexdigest()


def candidate_digest_errors(data: bytes, expected: str | None, label: str) -> list[str]:
    if expected is None:
        return [f"{label}: expected candidate TAR SHA-256 is required"]
    if not SHA_PATTERN.fullmatch(expected):
        return [f"{label}: expected candidate TAR SHA-256 must be exactly 64 lowercase hex characters"]
    actual = digest(data)
    if actual != expected:
        return [f"{label}: candidate TAR SHA-256 mismatch; expected {expected}, found {actual}"]
    return []


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")


def safe_path(name: str) -> bool:
    if not name or name.startswith("/") or "\\" in name:
        return False
    parts = name.split("/")
    return all(part not in {"", ".", ".."} for part in parts)


def tar_bytes(entries: list[tuple[str, bytes]]) -> bytes:
    output = io.BytesIO()
    with tarfile.open(fileobj=output, mode="w", format=tarfile.USTAR_FORMAT) as archive:
        for name, content in entries:
            info = tarfile.TarInfo(name)
            info.size = len(content)
            info.mode = 0o644
            info.uid = 0
            info.gid = 0
            info.uname = ""
            info.gname = ""
            info.mtime = 0
            archive.addfile(info, io.BytesIO(content))
    return output.getvalue()


def archive_entries(data: bytes, expected: tuple[str, ...], label: str) -> tuple[list[str], dict[str, bytes]]:
    errors: list[str] = []
    values: dict[str, bytes] = {}
    if len(data) > MAX_ARCHIVE:
        return [f"{label}: archive exceeds {MAX_ARCHIVE} bytes"], values
    try:
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:") as archive:
            members = archive.getmembers()
            names = [member.name for member in members]
            if len(names) != len(set(names)):
                errors.append(f"{label}: duplicate member")
            if len({name.casefold() for name in names}) != len(names):
                errors.append(f"{label}: case collision")
            for member in members:
                if not safe_path(member.name):
                    errors.append(f"{label}: unsafe path {member.name!r}")
                if member.type != tarfile.REGTYPE or not member.isreg():
                    errors.append(f"{label}: every member must be a regular file: {member.name!r}")
                    continue
                if member.pax_headers or member.sparse:
                    errors.append(f"{label}: sparse or extended members are forbidden: {member.name!r}")
                if member.mode != 0o644 or member.mode & 0o111:
                    errors.append(f"{label}: member mode must be 0644 and non-executable: {member.name!r}")
                if member.uid != 0 or member.gid != 0 or member.uname or member.gname or member.mtime != 0:
                    errors.append(f"{label}: member metadata is not canonical: {member.name!r}")
                if member.size < 0 or member.size > MAX_MEMBER:
                    errors.append(f"{label}: member size is unsafe: {member.name!r}")
                    continue
                stream = archive.extractfile(member)
                if stream is None:
                    errors.append(f"{label}: regular member is unreadable: {member.name!r}")
                    continue
                content = stream.read(MAX_MEMBER + 1)
                if len(content) != member.size:
                    errors.append(f"{label}: member size changed while reading: {member.name!r}")
                if member.name not in values:
                    values[member.name] = content
    except (OSError, EOFError, tarfile.TarError) as error:
        return [f"{label}: malformed TAR: {error}"], {}
    if tuple(names) != expected:
        errors.append(f"{label}: inventory or order mismatch: {names}")
    if not errors and data != tar_bytes([(name, values[name]) for name in expected]):
        errors.append(f"{label}: archive encoding is not canonical deterministic TAR")
    return errors, values


def object_model(data: bytes, label: str, errors: list[str]) -> dict[str, object] | None:
    try:
        value = json.loads(data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        errors.append(f"{label}: malformed UTF-8 JSON: {error}")
        return None
    if not isinstance(value, dict) or not all(isinstance(key, str) for key in value):
        errors.append(f"{label}: root must be a JSON object with string keys")
        return None
    if canonical_json(value) != data:
        errors.append(f"{label}: JSON is not canonical")
    return value


def exact_keys(value: dict[str, object], keys: set[str], label: str, errors: list[str]) -> None:
    if set(value) != keys:
        errors.append(f"{label}: fields are {sorted(value)}, expected {sorted(keys)}")


def candidate_manifest_errors(model: dict[str, object], originals: dict[str, bytes]) -> list[str]:
    errors: list[str] = []
    exact_keys(model, {"schema", "coordinate", "version", "source", "ci", "originals"}, "candidate manifest", errors)
    if model.get("schema") != 1 or model.get("coordinate") != COORDINATE or model.get("version") != RELEASE_VERSION:
        errors.append("candidate manifest: schema, coordinate, or version mismatch")
    source = model.get("source")
    if not isinstance(source, dict):
        errors.append("candidate manifest: source must be an object")
    else:
        exact_keys(source, {"commit", "tree"}, "candidate source", errors)
        if not all(isinstance(source.get(key), str) and OBJECT_PATTERN.fullmatch(str(source[key])) for key in ("commit", "tree")):
            errors.append("candidate manifest: source commit and tree must be full lowercase object IDs")
    ci = model.get("ci")
    expected_ci_keys = {"repository", "workflow", "run_id", "run_attempt", "job", "event", "ref"}
    if not isinstance(ci, dict):
        errors.append("candidate manifest: CI provenance must be an object")
    else:
        exact_keys(ci, expected_ci_keys, "candidate CI provenance", errors)
        if (
            ci.get("repository") != "bernhardberger/tvheadend-htsp"
            or ci.get("workflow") != "CI"
            or ci.get("job") != "verify"
            or ci.get("event") != "push"
            or ci.get("ref") != "refs/heads/main"
        ):
            errors.append("candidate manifest: CI repository, workflow, job, event, or ref mismatch")
        for key in ("run_id", "run_attempt"):
            if not isinstance(ci.get(key), str) or not re.fullmatch(r"[1-9][0-9]*", str(ci.get(key))):
                errors.append(f"candidate manifest: CI {key} is missing or invalid")
    inventory = model.get("originals")
    if not isinstance(inventory, list) or len(inventory) != len(ORIGINAL_PATHS):
        errors.append("candidate manifest: originals must contain exactly five entries")
    else:
        listed: list[str] = []
        for index, entry in enumerate(inventory):
            if not isinstance(entry, dict):
                errors.append(f"candidate manifest: original {index} must be an object")
                continue
            exact_keys(entry, {"path", "size", "sha256"}, f"candidate original {index}", errors)
            path = entry.get("path")
            if not isinstance(path, str):
                errors.append(f"candidate manifest: original {index} path must be a string")
            if not isinstance(entry.get("size"), int) or isinstance(entry.get("size"), bool) or int(entry.get("size", -1)) < 0:
                errors.append(f"candidate manifest: original {index} size must be a nonnegative integer")
            if not isinstance(entry.get("sha256"), str) or not SHA_PATTERN.fullmatch(str(entry.get("sha256"))):
                errors.append(f"candidate manifest: original {index} SHA-256 is malformed")
            listed.append(str(path))
            content = originals.get(str(path))
            if content is None:
                errors.append(f"candidate manifest: unknown original path {path!r}")
                continue
            if entry.get("size") != len(content) or entry.get("sha256") != digest(content):
                errors.append(f"candidate manifest: stale or changed bytes for {path}")
        if tuple(listed) != ORIGINAL_PATHS:
            errors.append(f"candidate manifest: original path inventory mismatch: {listed}")
    return errors


def verify_candidate_bytes(data: bytes) -> tuple[list[str], dict[str, bytes], dict[str, object] | None]:
    expected = (MANIFEST_PATH, *ORIGINAL_PATHS)
    errors, entries = archive_entries(data, expected, "release candidate")
    model: dict[str, object] | None = None
    if MANIFEST_PATH in entries:
        model = object_model(entries[MANIFEST_PATH], "candidate manifest", errors)
    if model is not None:
        errors.extend(candidate_manifest_errors(model, {path: entries[path] for path in ORIGINAL_PATHS if path in entries}))
    return sorted(set(errors)), entries, model


def project_version() -> tuple[str | None, list[str]]:
    path = ROOT / "build.gradle.kts"
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        return None, [f"build version unavailable: {error}"]
    matches = re.findall(r'^version = "([^"]+)"$', text, re.M)
    if len(matches) != 1 or matches[0] not in {SNAPSHOT_VERSION, RELEASE_VERSION}:
        return None, [f"build version must be exactly {SNAPSHOT_VERSION} or {RELEASE_VERSION}: {matches}"]
    return matches[0], []


def git_output(*arguments: str) -> tuple[str | None, str | None]:
    try:
        result = subprocess.run(
            ("git", *arguments), cwd=ROOT, check=False, stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env={"PATH": os.environ.get("PATH", "")},
        )
    except OSError as error:
        return None, str(error)
    if result.returncode != 0:
        return None, result.stderr.strip() or f"git exited {result.returncode}"
    return result.stdout.strip(), None


def source_checkout_errors(status: str, head: str, tree: str, expected_head: str, expected_tree: str) -> list[str]:
    if status:
        return ["candidate creation requires a clean checkout"]
    if head != expected_head or tree != expected_tree:
        return ["candidate source commit/tree differs from the trusted CI provenance"]
    return []


def trusted_ci_provenance() -> tuple[dict[str, object] | None, list[str]]:
    errors: list[str] = []
    expected = {
        "GITHUB_ACTIONS": "true", "CI": "true",
        "GITHUB_REPOSITORY": "bernhardberger/tvheadend-htsp",
        "GITHUB_WORKFLOW": "CI", "GITHUB_JOB": "verify",
        "GITHUB_EVENT_NAME": "push", "GITHUB_REF": "refs/heads/main",
    }
    for name, value in expected.items():
        if os.environ.get(name) != value:
            errors.append(f"candidate creation requires trusted CI {name}={value}")
    commit = os.environ.get("GITHUB_SHA", "")
    tree = os.environ.get("RELEASE_SOURCE_TREE", "")
    run_id = os.environ.get("GITHUB_RUN_ID", "")
    attempt = os.environ.get("GITHUB_RUN_ATTEMPT", "")
    if not OBJECT_PATTERN.fullmatch(commit):
        errors.append("candidate creation requires full lowercase GITHUB_SHA")
    if not OBJECT_PATTERN.fullmatch(tree):
        errors.append("candidate creation requires full lowercase RELEASE_SOURCE_TREE")
    if not re.fullmatch(r"[1-9][0-9]*", run_id) or not re.fullmatch(r"[1-9][0-9]*", attempt):
        errors.append("candidate creation requires numeric CI run ID and attempt")
    status, status_error = git_output("status", "--porcelain=v1", "--untracked-files=all")
    head, head_error = git_output("rev-parse", "HEAD")
    actual_tree, tree_error = git_output("rev-parse", "HEAD^{tree}")
    if status_error or head_error or tree_error:
        errors.append(f"candidate creation cannot inspect checkout: {status_error or head_error or tree_error}")
    else:
        errors.extend(source_checkout_errors(status, head, actual_tree, commit, tree))
    if errors:
        return None, errors
    return {
        "source": {"commit": commit, "tree": tree},
        "ci": {
            "repository": expected["GITHUB_REPOSITORY"], "workflow": expected["GITHUB_WORKFLOW"],
            "run_id": run_id, "run_attempt": attempt, "job": expected["GITHUB_JOB"],
            "event": expected["GITHUB_EVENT_NAME"], "ref": expected["GITHUB_REF"],
        },
    }, []


def staged_originals() -> tuple[dict[str, bytes], list[str]]:
    errors: list[str] = []
    version_dir = ROOT.joinpath("build/local-maven", *GROUP.split("."), ARTIFACT, RELEASE_VERSION)
    current = ROOT
    for part in version_dir.relative_to(ROOT).parts:
        current /= part
        if current.is_symlink():
            return {}, [f"staging path traverses symlink: {current}"]
    if not version_dir.is_dir():
        return {}, [f"release staging directory is missing: {version_dir}"]
    allowed = set(ORIGINAL_NAMES) | {name + ".sha256" for name in ORIGINAL_NAMES}
    actual: set[str] = set()
    originals: dict[str, bytes] = {}
    for entry in version_dir.iterdir():
        if entry.is_symlink() or not entry.is_file():
            errors.append(f"staging contains non-regular entry: {entry.name}")
            continue
        actual.add(entry.name)
    if actual != allowed:
        errors.append(f"release staging inventory mismatch; missing={sorted(allowed - actual)}, extra={sorted(actual - allowed)}")
    for name, path in zip(ORIGINAL_NAMES, ORIGINAL_PATHS):
        artifact = version_dir / name
        sidecar = version_dir / (name + ".sha256")
        if not artifact.is_file() or artifact.is_symlink() or not sidecar.is_file() or sidecar.is_symlink():
            continue
        try:
            artifact_size = artifact.stat().st_size
            sidecar_size = sidecar.stat().st_size
        except OSError as error:
            errors.append(f"staged original metadata is unreadable: {name}: {error}")
            continue
        if artifact_size > MAX_MEMBER:
            errors.append(f"staged original is oversized: {name}")
            continue
        if sidecar_size != 65:
            errors.append(f"staged original has stale or malformed SHA-256 evidence: {name}")
            continue
        try:
            content = artifact.read_bytes()
            sidecar_content = sidecar.read_bytes()
        except OSError as error:
            errors.append(f"staged original is unreadable: {name}: {error}")
            continue
        expected = (digest(content) + "\n").encode("ascii")
        if sidecar_content != expected:
            errors.append(f"staged original has stale or malformed SHA-256 evidence: {name}")
        originals[path] = content
    return originals, errors


def candidate_bytes(originals: dict[str, bytes], provenance: dict[str, object]) -> bytes:
    manifest = {
        "schema": 1, "coordinate": COORDINATE, "version": RELEASE_VERSION,
        "source": provenance["source"], "ci": provenance["ci"],
        "originals": [
            {"path": path, "size": len(originals[path]), "sha256": digest(originals[path])}
            for path in ORIGINAL_PATHS
        ],
    }
    return tar_bytes([(MANIFEST_PATH, canonical_json(manifest)), *((path, originals[path]) for path in ORIGINAL_PATHS)])


def safe_output_path(argument: str) -> tuple[Path | None, list[str]]:
    expected = (ROOT / f"build/release/{ARTIFACT}-{RELEASE_VERSION}-candidate.tar").absolute()
    requested = Path(argument)
    if not requested.is_absolute():
        requested = ROOT / requested
    requested = requested.absolute()
    if requested != expected:
        return None, [f"candidate output must be exactly {expected}"]
    if requested.exists() or requested.is_symlink():
        return None, [f"candidate output already exists: {requested}"]
    current = ROOT
    for part in requested.relative_to(ROOT).parts[:-1]:
        current /= part
        if current.exists() and current.is_symlink():
            return None, [f"candidate output path traverses symlink: {current}"]
    return requested, []


def exclusive_write(path: Path, content: bytes) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        path.chmod(0o644)
    except BaseException:
        try:
            path.unlink()
        except OSError:
            pass
        raise


def prepare(output: str, allow_snapshot_noop: bool) -> tuple[list[str], str | None]:
    version, errors = project_version()
    if errors:
        return errors, None
    if version == SNAPSHOT_VERSION:
        if allow_snapshot_noop:
            return [], None
        return [f"release candidate requires version {RELEASE_VERSION}, found {SNAPSHOT_VERSION}"], None
    errors.extend(public_material_errors())
    output_path, output_errors = safe_output_path(output)
    errors.extend(output_errors)
    provenance, provenance_errors = trusted_ci_provenance()
    errors.extend(provenance_errors)
    originals, staging_errors = staged_originals()
    errors.extend(staging_errors)
    if errors or output_path is None or provenance is None or set(originals) != set(ORIGINAL_PATHS):
        return errors or ["release staging did not provide exactly five originals"], None
    data = candidate_bytes(originals, provenance)
    verification, _, _ = verify_candidate_bytes(data)
    if verification:
        return ["created candidate failed internal verification: " + "; ".join(verification)], None
    try:
        exclusive_write(output_path, data)
        completed = output_path.read_bytes()
    except OSError as error:
        try:
            output_path.unlink()
        except OSError:
            pass
        return [f"candidate output failed closed: {error}"], None
    if completed != data:
        try:
            output_path.unlink()
        except OSError:
            pass
        return ["candidate output failed final write/readback comparison"], None
    return [], digest(completed)


def fingerprint_value(
    key_path: Path = KEY_PATH,
    fingerprint_path: Path = FINGERPRINT_PATH,
) -> tuple[str | None, list[str]]:
    missing = [path for path in (key_path, fingerprint_path) if not path.is_file() or path.is_symlink()]
    if missing:
        return None, [
            "tracked public OpenPGP key and primary fingerprint are missing; owner must add "
            "release/openpgp/public-key.asc and release/openpgp/primary-fingerprint.txt"
        ]
    try:
        value = fingerprint_path.read_text(encoding="ascii")
    except (OSError, UnicodeError) as error:
        return None, [f"primary fingerprint metadata is unreadable: {error}"]
    if not FINGERPRINT_PATTERN.fullmatch(value.rstrip("\n")) or value != value.rstrip("\n") + "\n":
        return None, ["primary fingerprint metadata must be one full uppercase 40-hex fingerprint and newline"]
    fingerprint = value.rstrip("\n")
    if fingerprint != APPROVED_FINGERPRINT:
        return None, ["primary fingerprint metadata does not match the independently approved fingerprint"]
    return fingerprint, []


def decode_colon(value: str) -> str:
    return re.sub(r"\\x([0-9A-Fa-f]{2})", lambda match: chr(int(match.group(1), 16)), value)


def colon_key_errors(text: str, expected_fingerprint: str) -> list[str]:
    errors: list[str] = []
    if expected_fingerprint != APPROVED_FINGERPRINT:
        errors.append("public key identity does not match the independently approved fingerprint")
    records = [line.split(":") for line in text.splitlines() if line]
    primary_indexes = [index for index, fields in enumerate(records) if fields[0] == "pub"]
    if len(primary_indexes) != 1:
        return [f"public key material must contain exactly one primary key, found {len(primary_indexes)}"]
    index = primary_indexes[0]
    primary = records[index]
    following = records[index + 1:]
    fingerprints = [fields[9] for fields in following if fields[0] == "fpr" and len(fields) > 9]
    if fingerprints != [expected_fingerprint]:
        errors.append("public key primary fingerprint does not match tracked metadata")
    validity = primary[1] if len(primary) > 1 else ""
    expiry = primary[6] if len(primary) > 6 else ""
    capabilities = primary[11] if len(primary) > 11 else ""
    bits = primary[2] if len(primary) > 2 else ""
    algorithm = primary[3] if len(primary) > 3 else ""
    if validity.lower() in {"i", "n", "d", "r", "e"}:
        errors.append("public key validity is invalid, never-valid, disabled, revoked, or expired")
    if expiry not in {"", "0"}:
        errors.append("public key must have no expiry")
    if "s" not in capabilities.lower():
        errors.append("primary public key must be signing-capable")
    if algorithm != "1":
        errors.append("primary public key algorithm must be RSA (GnuPG algorithm 1)")
    if bits != "4096":
        errors.append("primary public key must be exactly 4096 bits")
    if any(fields[0] == "sub" for fields in records):
        errors.append("public key must contain no subkeys")
    uid_records = [fields for fields in following if fields[0] == "uid" and len(fields) > 9]
    uids = [decode_colon(fields[9]) for fields in uid_records]
    if uids != [PUBLIC_UID]:
        errors.append(f"public key must have exactly the approved UID {PUBLIC_UID!r}")
    if any(len(fields) < 2 or fields[1].lower() in {"i", "n", "d", "r", "e"} for fields in uid_records):
        errors.append("approved public UID validity must not be invalid, never-valid, disabled, revoked, or expired")
    return errors


def run(command: tuple[str, ...], home: Path | None = None) -> subprocess.CompletedProcess[str]:
    environment = {"PATH": os.environ.get("PATH", ""), "LC_ALL": "C"}
    if home is not None:
        environment["GNUPGHOME"] = str(home)
    try:
        return subprocess.run(
            command, check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, env=environment,
        )
    except OSError as error:
        return subprocess.CompletedProcess(command, 127, "", str(error))


def armor_errors(armor: bytes) -> list[str]:
    try:
        text = armor.decode("ascii")
    except UnicodeError:
        return ["tracked OpenPGP material must be ASCII armor"]
    begin = "-----BEGIN PGP PUBLIC KEY BLOCK-----\n"
    end = "-----END PGP PUBLIC KEY BLOCK-----\n"
    markers = re.findall(r"(?m)^-----(?:BEGIN|END) PGP [A-Z0-9 ]+-----$", text)
    if (
        not text.startswith(begin)
        or not text.endswith(end)
        or text.count("-----BEGIN PGP PUBLIC KEY BLOCK-----") != 1
        or text.count("-----END PGP PUBLIC KEY BLOCK-----") != 1
        or markers != [begin.rstrip("\n"), end.rstrip("\n")]
        or "\r" in text
        or "-----BEGIN PGP PRIVATE KEY BLOCK-----" in text
        or "-----BEGIN PGP SECRET KEY BLOCK-----" in text
        or "PRIVATE KEY" in text
        or "SECRET KEY" in text
    ):
        return ["tracked OpenPGP material must be one public-only armored key block"]
    return []


def packet_errors(text: str, returncode: int) -> list[str]:
    secret_packet = re.compile(r"(?im)^\s*:secret\s+(?:sub\s+)?key\s+packet:")
    if returncode != 0 or secret_packet.search(text):
        return ["tracked OpenPGP material is malformed or contains private-key packets"]
    return []


def signature_armor_errors(signature: bytes) -> list[str]:
    try:
        text = signature.decode("ascii")
    except UnicodeError:
        return ["detached signature must be ASCII armor"]
    if (
        text.count("-----BEGIN PGP SIGNATURE-----") != 1
        or text.count("-----END PGP SIGNATURE-----") != 1
        or not text.startswith("-----BEGIN PGP SIGNATURE-----\n")
        or not text.endswith("-----END PGP SIGNATURE-----\n")
    ):
        return ["detached signature must be exactly one ASCII-armored block"]
    return []


def public_key_home(
    parent: Path,
    key_path: Path = KEY_PATH,
    fingerprint_path: Path = FINGERPRINT_PATH,
    gpg_results: tuple[subprocess.CompletedProcess[str], ...] | None = None,
) -> tuple[Path | None, str | None, list[str]]:
    fingerprint, errors = fingerprint_value(key_path, fingerprint_path)
    if errors or fingerprint is None:
        return None, None, errors
    try:
        if key_path.stat().st_size > 1024 * 1024:
            return None, None, ["tracked public OpenPGP material is oversized"]
        armor = key_path.read_bytes()
    except OSError as error:
        return None, None, [f"public key material is unreadable: {error}"]
    errors.extend(armor_errors(armor))
    if errors:
        return None, None, errors
    home = parent / "public-gnupg"
    home.mkdir(mode=0o700)
    if gpg_results is not None and len(gpg_results) != 3:
        return None, None, ["public-material test evidence must contain exactly three GPG results"]
    packets = gpg_results[0] if gpg_results is not None else run(("gpg", "--batch", "--list-packets", str(key_path)), home)
    errors.extend(packet_errors(packets.stdout + packets.stderr, packets.returncode))
    if errors:
        return None, None, errors
    imported = gpg_results[1] if gpg_results is not None else run(("gpg", "--batch", "--import", str(key_path)), home)
    if imported.returncode != 0:
        return None, None, ["tracked public OpenPGP key cannot be imported into an isolated verifier"]
    listing = gpg_results[2] if gpg_results is not None else run(("gpg", "--batch", "--with-colons", "--list-keys"), home)
    if listing.returncode != 0:
        return None, None, ["tracked public OpenPGP key cannot be listed from the isolated verifier"]
    errors.extend(colon_key_errors(listing.stdout, fingerprint))
    return (home if not errors else None), fingerprint, errors


def public_material_errors(
    key_path: Path = KEY_PATH,
    fingerprint_path: Path = FINGERPRINT_PATH,
    gpg_results: tuple[subprocess.CompletedProcess[str], ...] | None = None,
) -> list[str]:
    with tempfile.TemporaryDirectory() as temporary:
        workspace = Path(temporary)
        workspace.chmod(0o700)
        _, _, errors = public_key_home(workspace, key_path, fingerprint_path, gpg_results)
        return errors


def setup_public_material_errors(
    key_path: Path = KEY_PATH,
    fingerprint_path: Path = FINGERPRINT_PATH,
    gpg_results: tuple[subprocess.CompletedProcess[str], ...] | None = None,
) -> list[str]:
    key_exists = key_path.exists() or key_path.is_symlink()
    fingerprint_exists = fingerprint_path.exists() or fingerprint_path.is_symlink()
    if key_exists != fingerprint_exists:
        return ["public key export and primary fingerprint metadata must be added together"]
    if not key_exists:
        return []
    return public_material_errors(key_path, fingerprint_path, gpg_results)


def validsig_errors(status: str, expected_fingerprint: str) -> list[str]:
    lines = [line.split() for line in status.splitlines() if line.startswith("[GNUPG:] ")]
    forbidden = {"BADSIG", "ERRSIG", "REVKEYSIG", "EXPKEYSIG", "EXPSIG", "NO_PUBKEY"}
    if any(len(fields) > 1 and fields[1] in forbidden for fields in lines):
        return ["detached signature status reports an invalid signer or signature"]
    valid = [fields for fields in lines if len(fields) > 2 and fields[1] == "VALIDSIG"]
    if len(valid) != 1:
        return [f"detached signature must report exactly one VALIDSIG, found {len(valid)}"]
    signer = valid[0][2]
    primary = valid[0][-1]
    if signer != expected_fingerprint or primary != expected_fingerprint:
        return ["VALIDSIG signer and primary fingerprint must both match the tracked primary fingerprint"]
    return []


def portal_zip_bytes(entries: list[tuple[str, bytes]]) -> bytes:
    output = io.BytesIO()
    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_STORED, allowZip64=False) as archive:
        for name, content in entries:
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_STORED
            info.create_system = 3
            info.external_attr = 0o100644 << 16
            info.flag_bits = 0
            archive.writestr(info, content)
    return output.getvalue()


def portal_entries(data: bytes, expected: tuple[str, ...]) -> tuple[list[str], dict[str, bytes]]:
    errors: list[str] = []
    values: dict[str, bytes] = {}
    if len(data) > MAX_ARCHIVE:
        return ["Portal ZIP is oversized"], values
    try:
        with zipfile.ZipFile(io.BytesIO(data), "r") as archive:
            infos = archive.infolist()
            names = [info.filename for info in infos]
            if len(names) != len(set(names)):
                errors.append("Portal ZIP contains duplicate members")
            if len({name.casefold() for name in names}) != len(names):
                errors.append("Portal ZIP contains case-colliding members")
            if tuple(names) != expected:
                errors.append(f"Portal ZIP inventory or order mismatch: {names}")
            total_size = sum(max(info.file_size, 0) for info in infos)
            if total_size > MAX_ARCHIVE:
                errors.append("Portal ZIP expanded inventory is oversized")
            for info in infos:
                mode = (info.external_attr >> 16) & 0o177777
                if not safe_path(info.filename):
                    errors.append(f"Portal ZIP contains unsafe path {info.filename!r}")
                if info.is_dir() or mode != 0o100644 or mode & 0o111:
                    errors.append(f"Portal ZIP member must be a regular non-executable 0644 file: {info.filename!r}")
                if info.compress_type != zipfile.ZIP_STORED or info.date_time != (1980, 1, 1, 0, 0, 0) or info.flag_bits & 0x1:
                    errors.append(f"Portal ZIP metadata/compression is not canonical: {info.filename!r}")
                if info.file_size > MAX_MEMBER:
                    errors.append(f"Portal ZIP member is oversized: {info.filename!r}")
            if not errors:
                for info in infos:
                    with warnings.catch_warnings():
                        warnings.simplefilter("ignore", UserWarning)
                        values[info.filename] = archive.read(info)
    except (OSError, EOFError, zipfile.BadZipFile, RuntimeError) as error:
        return [f"malformed Portal ZIP: {error}"], {}
    if not errors and data != portal_zip_bytes([(name, values[name]) for name in expected]):
        errors.append("Portal ZIP is not canonical and deterministic")
    return errors, values


def signed_paths() -> tuple[str, ...]:
    values: list[str] = []
    for path in ORIGINAL_PATHS:
        values.extend((path, path + ".asc", path + ".md5", path + ".sha1", path + ".sha256"))
    return tuple(values)


def portal_paths() -> tuple[str, ...]:
    values: list[str] = []
    for path in ORIGINAL_PATHS:
        values.extend((path, path + ".asc", path + ".md5", path + ".sha1"))
    return tuple(values)


def verify_signed_bundle_bytes(
    data: bytes,
    direct_portal_data: bytes,
    expected_fingerprint: str,
    expected_candidate_sha256: str,
    signature_verifier: Callable[[bytes, bytes], list[str]],
) -> list[str]:
    expected = (SIGNED_MANIFEST_PATH, CANDIDATE_COPY_PATH, PORTAL_ZIP_PATH, *signed_paths())
    errors, entries = archive_entries(data, expected, "signed bundle")
    candidate_data = entries.get(CANDIDATE_COPY_PATH, b"")
    errors.extend(candidate_digest_errors(candidate_data, expected_candidate_sha256, "embedded release candidate"))
    candidate_errors, candidate_entries, candidate_model = verify_candidate_bytes(candidate_data)
    errors.extend(f"preserved candidate: {error}" for error in candidate_errors)
    zip_data = entries.get(PORTAL_ZIP_PATH, b"")
    zip_errors, zip_entries = portal_entries(zip_data, portal_paths())
    errors.extend(zip_errors)
    direct_zip_errors, _ = portal_entries(direct_portal_data, portal_paths())
    errors.extend(f"direct Portal ZIP: {error}" for error in direct_zip_errors)
    if direct_portal_data != zip_data:
        errors.append("direct Portal ZIP differs from the ZIP embedded in signed evidence")
    model = object_model(entries.get(SIGNED_MANIFEST_PATH, b""), "signed evidence", errors)
    if model is None or candidate_model is None:
        return sorted(set(errors))
    exact_keys(
        model,
        {"schema", "coordinate", "version", "fingerprint", "candidate", "source", "ci", "signer_tool_sha256", "portal_zip", "originals"},
        "signed evidence", errors,
    )
    if model.get("schema") != 1 or model.get("coordinate") != COORDINATE or model.get("version") != RELEASE_VERSION:
        errors.append("signed evidence: schema, coordinate, or version mismatch")
    if model.get("fingerprint") != expected_fingerprint:
        errors.append("signed evidence: primary fingerprint mismatch")
    if model.get("source") != candidate_model.get("source") or model.get("ci") != candidate_model.get("ci"):
        errors.append("signed evidence: source or CI provenance differs from the candidate")
    candidate_record = model.get("candidate")
    if candidate_record != {"path": CANDIDATE_COPY_PATH, "size": len(candidate_data), "sha256": digest(candidate_data), "manifest_sha256": digest(candidate_entries.get(MANIFEST_PATH, b""))}:
        errors.append("signed evidence: candidate archive/manifest evidence mismatch")
    portal_record = model.get("portal_zip")
    if portal_record != {"path": PORTAL_ZIP_PATH, "size": len(zip_data), "sha256": digest(zip_data)}:
        errors.append("signed evidence: Portal ZIP evidence mismatch")
    signer_path = ROOT / "tools/sign-central-bundle"
    expected_signer = digest(signer_path.read_bytes()) if signer_path.is_file() and not signer_path.is_symlink() else ""
    if model.get("signer_tool_sha256") != expected_signer:
        errors.append("signed evidence: signer-tool SHA-256 does not match this exact checkout")
    inventory = model.get("originals")
    if not isinstance(inventory, list) or len(inventory) != 5:
        errors.append("signed evidence: originals must contain exactly five entries")
        return sorted(set(errors))
    for index, path in enumerate(ORIGINAL_PATHS):
        original = entries.get(path, b"")
        candidate_original = candidate_entries.get(path, b"")
        portal_original = zip_entries.get(path, b"")
        signature = entries.get(path + ".asc", b"")
        portal_signature = zip_entries.get(path + ".asc", b"")
        errors.extend(f"signed bundle: {path}: {error}" for error in signature_armor_errors(signature))
        hashes = {algorithm: digest(original, algorithm) for algorithm in ("md5", "sha1", "sha256")}
        if original != candidate_original or original != portal_original:
            errors.append(f"signed bundle: original bytes changed or were not returned: {path}")
        if signature != portal_signature:
            errors.append(f"signed bundle: Portal signature differs: {path}")
        for algorithm, value in hashes.items():
            sidecar = entries.get(path + "." + algorithm, b"")
            if sidecar != (value + "\n").encode("ascii"):
                errors.append(f"signed bundle: {algorithm} checksum mismatch for {path}")
            if algorithm != "sha256" and zip_entries.get(path + "." + algorithm, b"") != sidecar:
                errors.append(f"signed bundle: Portal {algorithm} checksum differs for {path}")
        errors.extend(f"signed bundle: {path}: {error}" for error in signature_verifier(signature, original))
        record = inventory[index]
        expected_record = {
            "path": path,
            "size": len(original),
            "sha256_before": digest(candidate_original),
            "sha256_after": digest(original),
            "sha256_returned": digest(portal_original),
            "sha256_portal": digest(portal_original),
            "signature": {"path": path + ".asc", "size": len(signature), "sha256": digest(signature)},
            "checksums": {
                algorithm: {"path": path + "." + algorithm, "value": hashes[algorithm]}
                for algorithm in ("md5", "sha1", "sha256")
            },
        }
        if record != expected_record:
            errors.append(f"signed evidence: original record mismatch for {path}")
    return sorted(set(errors))


def verify_detached_with_home(home: Path, fingerprint: str, signature: bytes, original: bytes, workspace: Path, index: int) -> list[str]:
    original_path = workspace / f"original-{index}"
    signature_path = workspace / f"signature-{index}"
    for path, content in ((original_path, original), (signature_path, signature)):
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
    result = run(("gpg", "--batch", "--status-fd", "1", "--verify", str(signature_path), str(original_path)), home)
    errors = validsig_errors(result.stdout, fingerprint)
    if result.returncode != 0 and not errors:
        errors.append(f"gpg signature verification exited {result.returncode}")
    return errors


def bounded_regular_bytes(path: Path, label: str) -> tuple[bytes | None, list[str]]:
    try:
        before = path.lstat()
    except OSError as error:
        return None, [f"{label} is unavailable: {error}"]
    if not stat.S_ISREG(before.st_mode):
        return None, [f"{label} must be a regular non-symlink file: {path}"]
    if before.st_size < 0 or before.st_size > MAX_ARCHIVE:
        return None, [f"{label} exceeds {MAX_ARCHIVE} bytes: {path}"]
    flags = os.O_RDONLY | os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
        with os.fdopen(descriptor, "rb") as stream:
            opened = os.fstat(stream.fileno())
            if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
                return None, [f"{label} changed identity during safe open: {path}"]
            data = stream.read(MAX_ARCHIVE + 1)
    except OSError as error:
        return None, [f"{label} is unreadable without following links: {error}"]
    if len(data) != opened.st_size or len(data) > MAX_ARCHIVE:
        return None, [f"{label} changed size during bounded read: {path}"]
    return data, []


def signed_output_readback(
    evidence_path: Path,
    portal_path: Path,
    expected_evidence: bytes | None = None,
    expected_portal: bytes | None = None,
) -> tuple[bytes | None, bytes | None, list[str]]:
    evidence, errors = bounded_regular_bytes(evidence_path, "signed evidence TAR")
    portal, portal_errors = bounded_regular_bytes(portal_path, "direct Portal ZIP")
    errors.extend(portal_errors)
    if evidence is not None and expected_evidence is not None and evidence != expected_evidence:
        errors.append("final signed evidence TAR differs from verified in-memory bytes")
    if portal is not None and expected_portal is not None and portal != expected_portal:
        errors.append("final direct Portal ZIP differs from verified in-memory bytes")
    return evidence, portal, sorted(set(errors))


def verify_signed_file(path: Path, portal_path: Path, expected_candidate_sha256: str) -> list[str]:
    data, direct_portal_data, errors = signed_output_readback(path, portal_path)
    if errors or data is None or direct_portal_data is None:
        return errors
    expected = (SIGNED_MANIFEST_PATH, CANDIDATE_COPY_PATH, PORTAL_ZIP_PATH, *signed_paths())
    preflight, entries = archive_entries(data, expected, "signed bundle")
    preflight.extend(candidate_digest_errors(entries.get(CANDIDATE_COPY_PATH, b""), expected_candidate_sha256, "embedded release candidate"))
    embedded_portal = entries.get(PORTAL_ZIP_PATH, b"")
    preflight.extend(f"direct Portal ZIP: {error}" for error in portal_entries(direct_portal_data, portal_paths())[0])
    if direct_portal_data != embedded_portal:
        preflight.append("direct Portal ZIP differs from the ZIP embedded in signed evidence")
    if preflight:
        return sorted(set(preflight))
    with tempfile.TemporaryDirectory() as temporary:
        workspace = Path(temporary)
        workspace.chmod(0o700)
        home, fingerprint, errors = public_key_home(workspace)
        if errors or home is None or fingerprint is None:
            return errors
        counter = iter(range(5))
        return verify_signed_bundle_bytes(
            data, direct_portal_data, fingerprint, expected_candidate_sha256,
            lambda signature, original: verify_detached_with_home(home, fingerprint, signature, original, workspace, next(counter)),
        )


