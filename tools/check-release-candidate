def mutate_tar(data: bytes, mutation: Callable[[list[tuple[tarfile.TarInfo, bytes]]], None]) -> bytes:
    entries: list[tuple[tarfile.TarInfo, bytes]] = []
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:") as archive:
        for member in archive.getmembers():
            stream = archive.extractfile(member)
            entries.append((member, stream.read() if stream else b""))
    mutation(entries)
    output = io.BytesIO()
    with tarfile.open(fileobj=output, mode="w", format=tarfile.USTAR_FORMAT) as archive:
        for member, content in entries:
            if member.isreg():
                member.size = len(content)
            archive.addfile(member, io.BytesIO(content) if member.isreg() else None)
    return output.getvalue()


def mutate_zip(data: bytes, mutation: Callable[[list[tuple[zipfile.ZipInfo, bytes]]], None]) -> bytes:
    entries: list[tuple[zipfile.ZipInfo, bytes]] = []
    with zipfile.ZipFile(io.BytesIO(data), "r") as archive:
        for info in archive.infolist():
            entries.append((info, archive.read(info)))
    mutation(entries)
    output = io.BytesIO()
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", UserWarning)
        with zipfile.ZipFile(output, "w", allowZip64=False) as archive:
            for info, content in entries:
                archive.writestr(info, content)
    return output.getvalue()


def set_tar_name(entries: list[tuple[tarfile.TarInfo, bytes]], index: int, value: str) -> None:
    entries[index][0].name = value


def set_tar_type(entries: list[tuple[tarfile.TarInfo, bytes]], index: int, value: bytes) -> None:
    entries[index][0].type = value


