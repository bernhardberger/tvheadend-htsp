    entries[index][0].mode = value


def set_tar_uid(entries: list[tuple[tarfile.TarInfo, bytes]], index: int, value: int) -> None:
    entries[index][0].uid = value


def set_zip_name(entries: list[tuple[zipfile.ZipInfo, bytes]], index: int, value: str) -> None:
    entries[index][0].filename = value


def set_zip_attributes(entries: list[tuple[zipfile.ZipInfo, bytes]], index: int, value: int) -> None:
    entries[index][0].external_attr = value


def synthetic_signed_bundle(candidate: bytes, fingerprint: str) -> bytes:
    candidate_errors, candidate_entries, candidate_model = verify_candidate_bytes(candidate)
    assert not candidate_errors and candidate_model is not None
    signed: list[tuple[str, bytes]] = []
    portal: list[tuple[str, bytes]] = []
    records: list[dict[str, object]] = []
    for path in ORIGINAL_PATHS:
        original = candidate_entries[path]
        signature = (
            "-----BEGIN PGP SIGNATURE-----\n"
            + "synthetic:" + path + "\n"
            + "-----END PGP SIGNATURE-----\n"
        ).encode("ascii")
        hashes = {algorithm: digest(original, algorithm) for algorithm in ("md5", "sha1", "sha256")}
        signed.extend(((path, original), (path + ".asc", signature)))
        portal.extend(((path, original), (path + ".asc", signature)))
        for algorithm in ("md5", "sha1", "sha256"):
            sidecar = (hashes[algorithm] + "\n").encode("ascii")
            signed.append((path + "." + algorithm, sidecar))
            if algorithm != "sha256":
                portal.append((path + "." + algorithm, sidecar))
        records.append({
            "path": path, "size": len(original),
            "sha256_before": digest(original), "sha256_after": digest(original),
            "sha256_returned": digest(original), "sha256_portal": digest(original),
            "signature": {"path": path + ".asc", "size": len(signature), "sha256": digest(signature)},
            "checksums": {algorithm: {"path": path + "." + algorithm, "value": hashes[algorithm]} for algorithm in ("md5", "sha1", "sha256")},
        })
    portal_data = portal_zip_bytes(portal)
    evidence = {
        "schema": 1, "coordinate": COORDINATE, "version": RELEASE_VERSION,
        "fingerprint": fingerprint, "source": candidate_model["source"], "ci": candidate_model["ci"],
        "candidate": {"path": CANDIDATE_COPY_PATH, "size": len(candidate), "sha256": digest(candidate), "manifest_sha256": digest(candidate_entries[MANIFEST_PATH])},
        "signer_tool_sha256": digest((ROOT / "tools/sign-central-bundle").read_bytes()),
        "portal_zip": {"path": PORTAL_ZIP_PATH, "size": len(portal_data), "sha256": digest(portal_data)},
        "originals": records,
    }
    return tar_bytes([(SIGNED_MANIFEST_PATH, canonical_json(evidence)), (CANDIDATE_COPY_PATH, candidate), (PORTAL_ZIP_PATH, portal_data), *signed])


