def setup_errors() -> list[str]:
    errors: list[str] = []
    required = (
        "tools/check-release-candidate", "tools/sign-central-bundle", "release/openpgp/README.md",
        "tools/verify-htsp", ".github/workflows/ci.yml", "docs/releasing.md", "AGENTS.md", "build.gradle.kts",
    )
    texts: dict[str, str] = {}
    for relative in required:
        path = ROOT / relative
        if path.is_symlink() or not path.is_file():
            errors.append(f"release setup requires regular file {relative}")
            continue
        try:
            texts[relative] = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            errors.append(f"release setup cannot read {relative}: {error}")
    errors.extend(setup_public_material_errors())
    ci = texts.get(".github/workflows/ci.yml", "")
    if active_yaml_lines(ci) != EXPECTED_CI_ACTIVE:
        errors.append("release CI active YAML must match the exact approved steps, actions, commands, conditions, and inputs")
    build = texts.get("build.gradle.kts", "")
    for token in ("signing {", "com.vanniktech", "nmcp", "sonatype", "credentials {"):
        if token in build:
            errors.append(f"Gradle release policy forbids remote/signing configuration: {token}")
    checker = texts.get("tools/check-release-candidate", "")
    signer = texts.get("tools/sign-central-bundle", "")
    errors.extend(release_python_ast_errors("tools/check-release-candidate", checker))
    errors.extend(release_python_ast_errors("tools/sign-central-bundle", signer))
    verifier = texts.get("tools/verify-htsp", "")
    bytecode_policy = "export PYTHONDONTWRITEBYTECODE=1"
    invocation_positions = [position for position in (verifier.find("./tools/"), verifier.find("python3 "), verifier.find("./gradlew ")) if position >= 0]
    if (
        verifier.count(bytecode_policy) != 1
        or not invocation_positions
        or verifier.find(bytecode_policy) > min(invocation_positions)
    ):
        errors.append("release verifier must export exact PYTHONDONTWRITEBYTECODE=1 before every checker, generator, or build invocation")
    if 'parser.add_argument("--candidate-sha256", required=True)' not in signer:
        errors.append("signer must require the public candidate TAR SHA-256")
    evidence_write = signer.find("policy.exclusive_write(target, bundle)")
    portal_write = signer.find("policy.exclusive_write(portal_target, portal_data)")
    if evidence_write < 0 or portal_write < 0 or evidence_write > portal_write:
        errors.append("signer must write evidence before the directly uploadable Portal ZIP")
    output_contract = 'print(f"CANDIDATE_TAR_' + 'SHA256={candidate_sha256}")'
    if output_contract not in texts.get("tools/check-release-candidate", ""):
        errors.append("candidate preparation must log its final readback TAR SHA-256")
    return sorted(set(errors))


