            signer_cases = {
                "network import", "passphrase environment", "extra signing environment",
                "copied signing environment", "missing signer bytecode suppression",
                "late signer bytecode suppression", "signing command clear",
                "signing command extend", "signing command append",
                "signing command slice replacement",
                "signing command item replacement", "signing command alias mutation",
                "loaded policy function rebinding", "loaded policy alias function rebinding",
                "loaded policy nested code mutation", "signer candidate digest validation in dead code",
                "signing subprocess inherited environment", "signing environment rebinding",
                "signing environment aliasing",
            }
            relative = "tools/sign-central-bundle" if name in signer_cases else "tools/check-release-candidate"
            if not release_python_ast_errors(relative, source):
                errors.append(f"self-test accepted release Python AST bypass: {name}")
        signing_comment = signer_text.replace(
            "def signing_environment() -> dict[str, str]:\n",
            "def signing_environment() -> dict[str, str]:\n    # Portal token and --passphrase-file are forbidden examples only.\n",
        )
        if release_python_ast_errors("tools/sign-central-bundle", signing_comment):
            errors.append("self-test rejected harmless signing-environment comment")
        harmless_reflective_string = checker_text + '\nREFLECTIVE_POLICY_EXAMPLE = \'getattr(sys.modules["os"], "system") and __builtins__\'\n'
        if release_python_ast_errors("tools/check-release-candidate", harmless_reflective_string):
            errors.append("self-test rejected harmless reflective-policy string")
        ci_text = (ROOT / ".github/workflows/ci.yml").read_text(encoding="utf-8")
        if active_yaml_lines(ci_text) != EXPECTED_CI_ACTIVE:
            errors.append("self-test rejected current exact active CI fixture")
        if active_yaml_lines(ci_text + "\n# Portal token\n# --passphrase-file\n") != EXPECTED_CI_ACTIVE:
            errors.append("self-test rejected harmless CI comments")
        if active_yaml_lines(ci_text.replace("compression-level: 0", "compression-level: 0 # Portal token")) != EXPECTED_CI_ACTIVE:
            errors.append("self-test rejected harmless inline CI comment")
        if active_yaml_lines(ci_text + "\n      - name: hostile\n        run: curl example.invalid\n") == EXPECTED_CI_ACTIVE:
            errors.append("self-test accepted extra active CI run command")
    return errors


def regular_input(argument: str, label: str) -> tuple[Path | None, list[str]]:
    path = Path(argument)
    if not path.is_absolute():
        path = ROOT / path
    path = path.absolute()
    if path.is_symlink() or not path.is_file():
        return None, [f"{label} must be a regular non-symlink file: {path}"]
    try:
        if path.stat().st_size > MAX_ARCHIVE:
            return None, [f"{label} exceeds {MAX_ARCHIVE} bytes: {path}"]
    except OSError as error:
        return None, [f"{label} metadata is unreadable: {error}"]
    return path, []


def main() -> int:
    parser = argparse.ArgumentParser()
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--self-test", action="store_true")
    modes.add_argument("--check-setup", action="store_true")
    modes.add_argument("--prepare", action="store_true")
    modes.add_argument("--prepare-if-release", action="store_true")
    modes.add_argument("--verify-candidate", metavar="PATH")
    modes.add_argument("--verify-signed-bundle", metavar="PATH")
    parser.add_argument("--output")
    parser.add_argument("--candidate-sha256")
    parser.add_argument("--portal-zip")
    arguments = parser.parse_args()
    success = "Release-channel policy passed"
    if arguments.self_test:
        if arguments.output or arguments.candidate_sha256 is not None or arguments.portal_zip:
            parser.error("--output, --candidate-sha256, and --portal-zip are invalid with --self-test")
        errors = self_test()
        success = "Release candidate and signed-bundle hostile self-tests passed"
    elif arguments.check_setup:
        if arguments.output or arguments.candidate_sha256 is not None or arguments.portal_zip:
            parser.error("--output, --candidate-sha256, and --portal-zip are invalid with --check-setup")
        errors = setup_errors()
        success = "Release-channel static/setup policy passed"
    elif arguments.prepare or arguments.prepare_if_release:
        if not arguments.output:
            parser.error("candidate preparation requires --output")
        if arguments.candidate_sha256 is not None:
            parser.error("candidate preparation rejects --candidate-sha256")
        if arguments.portal_zip:
            parser.error("candidate preparation rejects --portal-zip")
        errors, candidate_sha256 = prepare(arguments.output, arguments.prepare_if_release)
        version, _ = project_version()
        success = "Snapshot candidate preparation skipped by policy" if arguments.prepare_if_release and version == SNAPSHOT_VERSION else "Release candidate prepared and internally verified"
        if not errors and candidate_sha256 is not None:
            print(f"CANDIDATE_TAR_SHA256={candidate_sha256}")
    elif arguments.verify_candidate:
        if arguments.output:
            parser.error("--output is valid only with candidate preparation")
        if arguments.portal_zip:
            parser.error("--portal-zip is valid only with --verify-signed-bundle")
        if arguments.candidate_sha256 is None:
            parser.error("--verify-candidate requires --candidate-sha256")
        path, errors = regular_input(arguments.verify_candidate, "release candidate")
        if path is not None:
            try:
                candidate_data = path.read_bytes()
                errors.extend(candidate_digest_errors(candidate_data, arguments.candidate_sha256, "release candidate"))
                if not errors:
                    errors.extend(public_material_errors())
                if not errors:
                    verification, _, _ = verify_candidate_bytes(candidate_data)
                    errors.extend(verification)
            except OSError as error:
                errors.append(f"release candidate is unreadable: {error}")
        success = "Release candidate verified"
    else:
        if arguments.output:
            parser.error("--output is valid only with candidate preparation")
        if arguments.candidate_sha256 is None:
            parser.error("--verify-signed-bundle requires --candidate-sha256")
        if not arguments.portal_zip:
            parser.error("--verify-signed-bundle requires --portal-zip")
        path, errors = regular_input(arguments.verify_signed_bundle, "signed bundle")
        portal_path, portal_errors = regular_input(arguments.portal_zip, "direct Portal ZIP")
        errors.extend(portal_errors)
        if path is not None and portal_path is not None and not errors:
            errors.extend(verify_signed_file(path, portal_path, arguments.candidate_sha256))
        success = "Signed Central bundle verified with tracked public material"
    for error in sorted(set(errors)):
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(success)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
