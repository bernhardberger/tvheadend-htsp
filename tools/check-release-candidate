            ("loaded policy nested code mutation", signer_text.replace("    candidate_path, errors = policy.regular_input", "    policy.candidate_digest_errors.__code__ = (lambda *_: []).__code__\n    candidate_path, errors = policy.regular_input", 1)),
            ("signer candidate digest validation in dead code", signer_text.replace('    errors.extend(policy.candidate_digest_errors(candidate_data, candidate_sha256, "release candidate"))', '    if False:\n        errors.extend(policy.candidate_digest_errors(\n            candidate_data, candidate_sha256, "release candidate"\n        ))', 1)),
