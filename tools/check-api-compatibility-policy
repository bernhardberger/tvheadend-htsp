def markdown_fence(line: str) -> tuple[str, int, str] | None:
    candidate = line
    while True:
        candidate = candidate.lstrip(" \t")
        if candidate.startswith(">"):
            candidate = candidate[1:]
            continue
        list_marker = re.match(r"(?:[-+*]|[0-9]+[.)])[ \t]+", candidate)
        if list_marker is not None:
            candidate = candidate[list_marker.end():]
            continue
        break
    if not candidate or candidate[0] not in {"`", "~"}:
        return None
    marker = candidate[0]
    run_length = len(candidate) - len(candidate.lstrip(marker))
    if run_length < 3:
        return None
    remainder = candidate[run_length:]
    if marker == "`" and "`" in remainder:
        return None
    return marker, run_length, remainder


def is_indented_markdown_code(line: str) -> bool:
    candidate = line
    while True:
        leading_spaces = len(candidate) - len(candidate.lstrip(" "))
        prefix = candidate[:leading_spaces]
        remainder = candidate[leading_spaces:]
        if leading_spaces <= 3 and remainder.startswith(">"):
            candidate = remainder[1:]
            if candidate.startswith(" "):
                candidate = candidate[1:]
            continue
        if "\t" in prefix or leading_spaces >= 4:
            return bool(remainder)
        return remainder.startswith("\t")


def markdown_without_comments_and_block_code(document: str) -> str:
    without_comments = re.sub(r"(?s)<!--.*?(?:-->|\Z)", "", document)
    visible_lines: list[str] = []
    open_fence: tuple[str, int] | None = None
    for line in without_comments.splitlines():
        fence = markdown_fence(line)
        if open_fence is not None:
            if (
                fence is not None
                and fence[0] == open_fence[0]
                and fence[1] >= open_fence[1]
                and not fence[2].strip()
            ):
                open_fence = None
            continue
        if fence is not None:
            open_fence = fence[0], fence[1]
            continue
        if is_indented_markdown_code(line):
            continue
        visible_lines.append(line)
    return "\n".join(visible_lines)


HIDDEN_RAW_HTML_BLOCK = re.compile(
    r"<(?P<template_tag>template)\b[^<>]*>.*?</(?P=template_tag)\s*>"
    r"|<(?P<hidden_tag>[A-Za-z][A-Za-z0-9:-]*)\b"
    r"(?=[^<>]*\bhidden\b)[^<>]*>.*?</(?P=hidden_tag)\s*>",
    re.IGNORECASE | re.DOTALL,
)


def without_hidden_raw_html(markdown: str) -> str:
    previous = markdown
    while True:
        filtered = HIDDEN_RAW_HTML_BLOCK.sub("", previous)
        if filtered == previous:
            return filtered
        previous = filtered


def visible_markdown(document: str) -> str:
    return without_hidden_raw_html(
        markdown_without_comments_and_block_code(document),
    )


def normalized_visible_markdown(document: str) -> str:
    return re.sub(r"\s+", " ", visible_markdown(document)).strip()


def without_inline_code_spans(markdown: str) -> str:
    output: list[str] = []
    index = 0
    while index < len(markdown):
        if markdown[index] != "`":
            output.append(markdown[index])
            index += 1
            continue

        opening_end = index
        while opening_end < len(markdown) and markdown[opening_end] == "`":
            opening_end += 1
        delimiter_length = opening_end - index
        search_from = opening_end
        closing_end: int | None = None
        while search_from < len(markdown):
            closing_start = markdown.find("`", search_from)
            if closing_start < 0:
                break
            candidate_end = closing_start
            while candidate_end < len(markdown) and markdown[candidate_end] == "`":
                candidate_end += 1
            if candidate_end - closing_start == delimiter_length:
                closing_end = candidate_end
                break
            search_from = candidate_end

        if closing_end is None:
            output.append(markdown[index:opening_end])
            index = opening_end
            continue

        output.extend(
            "\n" if character == "\n" else " "
            for character in markdown[index:closing_end]
        )
        index = closing_end
    return "".join(output)


RAW_HTML_ELEMENT = re.compile(
    r"<\s*/?\s*[A-Za-z][A-Za-z0-9:-]*"
    r"(?:\s+[^<>]*?)?\s*/?\s*>",
    re.IGNORECASE | re.DOTALL,
)


def contains_visible_raw_html_element(document: str) -> bool:
    markdown = markdown_without_comments_and_block_code(document)
    markdown_without_inline_code = without_inline_code_spans(markdown)
    return RAW_HTML_ELEMENT.search(markdown_without_inline_code) is not None


def resolved_link_target(source_path: str, target: str) -> str:
    target_without_fragment = target.split("#", 1)[0]
    if re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://", target_without_fragment):
        return target_without_fragment.rstrip("/")
    return posixpath.normpath(
        posixpath.join(posixpath.dirname(source_path), target_without_fragment),
    )


def visible_link_count(document: str, source_path: str, expected: str) -> int:
    link_pattern = re.compile(
        r"(?<!!)\[[^\]\n]+\]\(\s*([^\s)]+)"
        r"(?:\s+(?:\"[^\"]*\"|'[^']*'))?\s*\)",
    )
    link_visible_markdown = without_inline_code_spans(visible_markdown(document))
    return sum(
        resolved_link_target(source_path, match.group(1)) == expected
        for match in link_pattern.finditer(link_visible_markdown)
    )


def require_visible_link(
    errors: list[str],
    document: str,
    source_path: str,
    target: str,
    description: str,
    label: str,
) -> None:
    count = visible_link_count(document, source_path, target)
    if count != 1:
        errors.append(
            f"{label}: visible {description} links total {count}, expected 1",
        )


def require_visible_claim(
    errors: list[str],
    normalized_document: str,
    claim: str,
    description: str,
    label: str,
) -> None:
    if claim not in normalized_document:
        errors.append(f"{label}: missing visible {description}")


def require_visible_heading(
    errors: list[str],
    document: str,
    heading: str,
    description: str,
    label: str,
) -> None:
    headings = re.findall(r"(?m)^#{1,6} [^\n]+$", visible_markdown(document))
    count = headings.count(heading)
    if count != 1:
        errors.append(
            f"{label}: expected visible {description} heading {heading!r} exactly "
            f"once, found {count}",
        )


def reject_accepted_contract_contradictions(
    errors: list[str],
    normalized_document: str,
    record_name: str,
    label: str,
) -> None:
    for description, pattern in ACCEPTED_CONTRACT_CONTRADICTIONS:
        if re.search(pattern, normalized_document, re.IGNORECASE):
            errors.append(f"{label}: {record_name} contradictory {description}")


