#!/usr/bin/env python3
"""Verify the standalone HTSP provisional major-zero versioning policy."""

from __future__ import annotations

import re
import sys
from dataclasses import dataclass, replace
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
GROUP = "at.bernhardberger.tvheadend"
ARTIFACT = "htsp"
VERSION = "0.1.0-SNAPSHOT"
RELEASE = "0.1.0"
SNAPSHOT_COORDINATE = f"{GROUP}:{ARTIFACT}:{VERSION}"
RELEASE_COORDINATE = f"{GROUP}:{ARTIFACT}:{RELEASE}"
COORDINATE = SNAPSHOT_COORDINATE
MODES = (VERSION, RELEASE)
PATHS = (
    "docs/versioning.md",
    "docs/releasing.md",
    "README.md",
    "docs/README.md",
    "CHANGELOG.md",
    "build.gradle.kts",
)

COMMON_VERSIONING_CLAIMS = (
    "While the major version is zero, the public API and behavior are provisional.",
    "A known breaking change requires the next minor version, not a patch version.",
    "Patch versions are reserved for backward-compatible fixes.",
    "No source, binary, or behavioral compatibility is promised for the provisional 0.x line.",
)
SNAPSHOT_VERSIONING_CLAIMS = (
    f"The current coordinate is `{COORDINATE}`.",
    f"`{VERSION}` is a mutable, checkout-local snapshot.",
    "It is not available from any public repository.",
    "An immutable release must use a new version; published release bytes must never be replaced.",
    *COMMON_VERSIONING_CLAIMS,
    f"The planned first release is `{RELEASE}`, an ordinary provisional major-zero release.",
    "It has not been published.",
    "Major zero communicates the initial-development compatibility status without a Maven alpha suffix.",
    "Local checks and CI staging do not establish publication, distribution, Java 17 runtime support, or release readiness.",
)
RELEASE_VERSIONING_CLAIMS = (
    f"The current immutable release coordinate is `{RELEASE_COORDINATE}`.",
    f"`{RELEASE}` is the first provisional major-zero release.",
    "Release bytes for this coordinate are immutable and must never be replaced.",
    "Availability from Maven Central or any other public repository is independently verified external state.",
    "This repository does not claim that publication or availability has occurred.",
    *COMMON_VERSIONING_CLAIMS,
    f"Read the `{RELEASE}` release notes before using it as a baseline.",
    "Local checks and candidate CI do not establish publication, availability, distribution, Java 17 runtime support, or release readiness.",
)
SNAPSHOT_RELEASING_CLAIMS = (
    f"`{RELEASE}` is the planned first provisional major-zero release.",
    "It has not been released or published.",
    f"Release notes for `{RELEASE}` define only the initial provisional baseline.",
    "They do not promise compatibility or support.",
    "Major zero communicates that status; the Maven version does not need an alpha suffix.",
    "This repository currently stages snapshots only to checkout-local `build/local-maven` in CI.",
    "External publication, signing, tagging, and release creation require separate owner authorization.",
    f"The eventual release uses the `v{RELEASE}` tag vocabulary.",
    "A GitHub Release may independently use its optional pre-release marker as a later Gate C action",
    "that marker does not change the ordinary Maven version or tag vocabulary.",
)
RELEASE_RELEASING_CLAIMS = (
    f"`{RELEASE}` is the first provisional major-zero release.",
    f"Release notes for `{RELEASE}` define only the initial provisional baseline.",
    "They do not promise compatibility or support.",
    "Major zero communicates that status; the Maven version does not need an alpha suffix.",
    "Local staging does not establish external publication or availability.",
    "Publication and availability are independently verified external state.",
    "This repository does not claim that publication has occurred.",
    f"For the current release that tag is `v{RELEASE}`.",
    "The GitHub prerelease marker does not change the Maven version or tag vocabulary.",
)
SNAPSHOT_CHANGELOG_CLAIMS = (
    f"This unreleased entry records the checkout-local `{VERSION}` baseline.",
    "It is not a release, publication, compatibility baseline, or support promise.",
    "The initial provisional baseline contains the standalone Kotlin/JVM HTSP v44 protocol library and its typed outcome API.",
)
RELEASE_CHANGELOG_CLAIMS = (
    f"This release entry records the `{RELEASE}` initial provisional baseline.",
    "It does not promise source, binary, or behavioral compatibility or support.",
    "The initial provisional baseline contains the standalone Kotlin/JVM HTSP v44 protocol library and its typed outcome API.",
    "Publication and availability are independently verified external state and are not established by this entry.",
)
VERSIONING_CLAIMS = SNAPSHOT_VERSIONING_CLAIMS
RELEASING_CLAIMS = SNAPSHOT_RELEASING_CLAIMS
CHANGELOG_CLAIMS = SNAPSHOT_CHANGELOG_CLAIMS


@dataclass(frozen=True)
class Documents:
    versioning: str
    releasing: str
    readme: str
    index: str
    changelog: str
    build: str
    regular_files: frozenset[str]


def visible_markdown(document: str) -> str:
    """Remove comments, fenced/indented code, and hidden raw HTML."""
    text = re.sub(r"(?s)<!--.*?(?:-->|\Z)", "", document)
    text = re.sub(
        r"(?is)<template\b[^<>]*>.*?</template\s*>|"
        r"<(?P<tag>[A-Za-z][A-Za-z0-9:-]*)\b(?=[^<>]*\bhidden\b)[^<>]*>"
        r".*?</(?P=tag)\s*>",
        "",
        text,
    )
    lines: list[str] = []
    fence: tuple[str, int] | None = None
    for line in text.splitlines():
        match = re.match(r"^\s*([`~]{3,})(.*)$", line)
        if fence is not None:
            if match and match.group(1)[0] == fence[0] and len(match.group(1)) >= fence[1] and not match.group(2).strip():
                fence = None
            continue
        if match:
            fence = (match.group(1)[0], len(match.group(1)))
            continue
        if line.startswith("    ") or line.startswith("\t"):
            continue
        lines.append(line)
    return "\n".join(lines)


def normalized(document: str) -> str:
    return re.sub(r"\s+", " ", visible_markdown(document)).strip()


def link_count(document: str, target: str) -> int:
    return len(re.findall(rf"(?<!!)\[[^\]\n]+\]\({re.escape(target)}(?:#[^)]+)?\)", visible_markdown(document)))


def dependency_block(document: str) -> list[str]:
    return re.findall(r"<!-- dependency-static:htsp -->\s*```kotlin\n(.*?)```", document, re.S)


def require_claims(errors: list[str], document: str, claims: tuple[str, ...], label: str) -> None:
    text = normalized(document)
    for claim in claims:
        if re.sub(r"\s+", " ", claim).strip() not in text:
            errors.append(f"{label}: missing visible claim: {claim}")


def validate(documents: Documents, label: str) -> list[str]:
    errors: list[str] = []
    for path in PATHS:
        if path not in documents.regular_files:
            errors.append(f"{label}: required input is not a regular file: {path}")

    assignments = re.findall(r'(?m)^group\s*=\s*"([^"]+)"\s*$', documents.build)
    if assignments != [GROUP]:
        errors.append(f"{label}: configured groups {assignments} do not match {[GROUP]}")
    assignments = re.findall(r'(?m)^version\s*=\s*"([^"]+)"\s*$', documents.build)
    mode = assignments[0] if len(assignments) == 1 and assignments[0] in MODES else None
    if mode is None:
        errors.append(f"{label}: configured versions {assignments} do not select exactly one of {list(MODES)}")

    headings = (
        (documents.versioning, "# Versioning and compatibility", "versioning"),
        (documents.releasing, "# Releasing", "releasing"),
        (documents.changelog, "# Changelog", "changelog"),
    )
    for document, heading, name in headings:
        count = re.findall(r"(?m)^#{1,6} [^\n]+$", visible_markdown(document)).count(heading)
        if count != 1:
            errors.append(f"{label}: {name} heading {heading!r} occurs {count} times")
    if mode is not None:
        changelog_heading = "## [Unreleased]" if mode == VERSION else f"## [{RELEASE}]"
        if re.findall(r"(?m)^## \[[^\n]+\]$", visible_markdown(documents.changelog)) != [changelog_heading]:
            errors.append(f"{label}: {mode} changelog must contain exactly the visible heading {changelog_heading}")
        versioning_claims = SNAPSHOT_VERSIONING_CLAIMS if mode == VERSION else RELEASE_VERSIONING_CLAIMS
        releasing_claims = SNAPSHOT_RELEASING_CLAIMS if mode == VERSION else RELEASE_RELEASING_CLAIMS
        changelog_claims = SNAPSHOT_CHANGELOG_CLAIMS if mode == VERSION else RELEASE_CHANGELOG_CLAIMS
        mode_label = "snapshot" if mode == VERSION else "release"
        require_claims(errors, documents.versioning, versioning_claims, f"{label}: {mode_label} versioning")
        require_claims(errors, documents.releasing, releasing_claims, f"{label}: {mode_label} releasing")
        require_claims(errors, documents.changelog, changelog_claims, f"{label}: {mode_label} changelog")

    links = (
        (documents.readme, "docs/versioning.md", "README versioning"),
        (documents.readme, "docs/releasing.md", "README releasing"),
        (documents.readme, "CHANGELOG.md", "README changelog"),
        (documents.index, "versioning.md", "index versioning"),
        (documents.index, "releasing.md", "index releasing"),
        (documents.index, "../CHANGELOG.md", "index changelog"),
    )
    for document, target, description in links:
        count = link_count(document, target)
        if count < 1:
            errors.append(f"{label}: visible {description} links total {count}, expected at least 1")

    if mode is not None:
        readme = normalized(documents.readme)
        if mode == VERSION:
            readme_claims = (
                f"The checkout currently uses the mutable, local-only snapshot `{COORDINATE}`.",
                "It is not available from Maven Central or another public repository.",
            )
            index_claim = "unreleased, non-normative baseline notes"
            dependency_coordinate = COORDINATE
            mode_label = "snapshot"
        else:
            readme_claims = (
                f"The Gradle dependency uses the exact immutable release coordinate `{RELEASE_COORDINATE}`.",
                "Availability from Maven Central or another public repository must be independently verified; this repository does not claim that publication has occurred.",
            )
            index_claim = f"the `{RELEASE}` initial provisional baseline notes"
            dependency_coordinate = RELEASE_COORDINATE
            mode_label = "release"
        for claim in readme_claims:
            if claim not in readme:
                errors.append(f"{label}: README missing visible {mode_label} status: {claim}")
        if index_claim not in normalized(documents.index):
            errors.append(f"{label}: documentation index missing visible {mode_label} changelog status: {index_claim}")
        expected_dependency = f'dependencies {{\n    implementation("{dependency_coordinate}")\n}}\n'
        blocks = dependency_block(documents.readme)
        if blocks != [expected_dependency]:
            errors.append(f"{label}: README {mode_label} dependency block does not use exactly {dependency_coordinate}")

    combined = " ".join(normalized(item) for item in (
        documents.versioning, documents.releasing, documents.readme,
        documents.index, documents.changelog,
    ))
    contradictions = (
        (r"\b(?:snapshot|coordinate) (?:is|has been) (?:publicly |externally )?(?:published|available)\b", "public snapshot availability"),
        (r"\b(?:release bytes|released artifacts?) (?:may|can) be (?:replaced|overwritten|republished)\b", "mutable release policy"),
        (r"\bknown breaking changes? (?:may|can|will) use (?:a )?patch", "patch-level breaking-change policy"),
        (r"\b(?:the )?(?:API|0\.x line) (?:is|remains) (?:fully )?stable\b", "stable API claim"),
        (r"\b(?:0\.1\.0|the planned first release) (?:is|has been) released\b", "false first-release claim"),
        (r"\b(?:local checks|CI staging) (?:prove|establish|make) [^.]{0,60}(?:release readiness|published|distribution readiness)\b", "overstated local evidence"),
        (r"\bMaven (?:version|coordinate) (?:must|needs? to) (?:use|include|retain) (?:an? )?alpha suffix\b", "required Maven alpha suffix"),
        (r"\bGitHub (?:Release )?pre-release marker (?:changes|determines) (?:the )?(?:Maven (?:version|coordinate)|coordinate|tag vocabulary)\b", "GitHub marker changes release identity"),
        (r"\b(?:0\.1\.0|the release|release coordinate) (?:is|has been) (?:publicly |externally )?(?:published|available)\b", "false release publication or availability"),
        (r"\b0\.1\.0-(?:alpha|beta|rc)(?:[.-][0-9A-Za-z]+)*\b", "legacy prerelease version"),
    )
    for pattern, description in contradictions:
        if re.search(pattern, combined, re.IGNORECASE):
            errors.append(f"{label}: contradictory {description}")
    return errors


def synthetic_documents(mode: str) -> Documents:
    if mode not in MODES:
        raise ValueError(f"unsupported synthetic mode: {mode}")
    release_mode = mode == RELEASE
    versioning_claims = RELEASE_VERSIONING_CLAIMS if release_mode else SNAPSHOT_VERSIONING_CLAIMS
    releasing_claims = RELEASE_RELEASING_CLAIMS if release_mode else SNAPSHOT_RELEASING_CLAIMS
    changelog_claims = RELEASE_CHANGELOG_CLAIMS if release_mode else SNAPSHOT_CHANGELOG_CLAIMS
    coordinate = RELEASE_COORDINATE if release_mode else COORDINATE
    versioning = "# Versioning and compatibility\n\n" + "\n\n".join(versioning_claims) + "\n"
    releasing = "# Releasing\n\n" + "\n\n".join(releasing_claims) + "\n"
    heading = f"## [{RELEASE}]" if release_mode else "## [Unreleased]"
    changelog = f"# Changelog\n\n{heading}\n\n" + "\n\n".join(changelog_claims) + "\n"
    if release_mode:
        status = (
            f"The Gradle dependency uses the exact immutable release coordinate `{coordinate}`. "
            "Availability from Maven Central or another public repository must be independently verified; "
            "this repository does not claim that publication has occurred."
        )
        index_status = f"the `{RELEASE}` initial provisional baseline notes"
    else:
        status = (
            f"The checkout currently uses the mutable, local-only snapshot `{coordinate}`. "
            "It is not available from Maven Central or another public repository."
        )
        index_status = "unreleased, non-normative baseline notes"
    readme = (
        "# HTSP\n\n" + status + "\n\n"
        "<!-- dependency-static:htsp -->\n```kotlin\n"
        f"dependencies {{\n    implementation(\"{coordinate}\")\n}}\n```\n\n"
        "[Versioning](docs/versioning.md) [Releasing](docs/releasing.md) [Changelog](CHANGELOG.md)\n"
    )
    index = f"# Documentation\n\n[Versioning](versioning.md) [Releasing](releasing.md) [Changelog](../CHANGELOG.md): {index_status}\n"
    return Documents(versioning, releasing, readme, index, changelog,
                     f'group = "{GROUP}"\nversion = "{mode}"\n', frozenset(PATHS))


def replace_once(document: str, old: str, new: str) -> str:
    if old not in document:
        raise AssertionError(f"self-test fixture lacks {old!r}")
    return document.replace(old, new, 1)


def self_test() -> list[str]:
    errors: list[str] = []
    if VERSION != "0.1.0-SNAPSHOT" or RELEASE != "0.1.0":
        errors.append("self-test rejected the legacy alpha-pinned documentation contract")
    baseline = synthetic_documents(VERSION)
    if validate(baseline, "synthetic baseline"):
        errors.append("self-test rejected valid standalone publication policy")
    release_baseline = synthetic_documents(RELEASE)
    if validate(release_baseline, "synthetic release baseline"):
        errors.append("self-test rejected valid exact-release publication policy")
    legacy_release = "0.1.0-" + "alpha.1"
    mutations: list[tuple[str, Documents, str]] = [
        ("wrong group", replace(baseline, build=replace_once(baseline.build, GROUP, "example.invalid")), "configured groups"),
        ("wrong artifact", replace(baseline, versioning=replace_once(baseline.versioning, f":{ARTIFACT}:", ":wrong:")), "current coordinate"),
        ("wrong version", replace(baseline, build=replace_once(baseline.build, VERSION, "0.2.0-SNAPSHOT")), "configured versions"),
        ("legacy alpha snapshot", replace(baseline, build=replace_once(baseline.build, VERSION, legacy_release + "-SNAPSHOT")), "configured versions"),
        ("multiple root versions", replace(baseline, build=baseline.build + f'version = "{RELEASE}"\n'), "configured versions"),
        ("dynamic root version", replace(baseline, build=replace_once(baseline.build, f'version = "{VERSION}"', 'version = providers.gradleProperty("releaseVersion").get()')), "configured versions"),
        ("mutable release", replace(baseline, versioning=baseline.versioning + "\nRelease bytes may be replaced.\n"), "mutable release policy"),
        ("remote snapshot", replace(baseline, readme=baseline.readme + "\nThe snapshot is publicly available.\n"), "public snapshot availability"),
        ("patch breaking change", replace(baseline, versioning=baseline.versioning + "\nKnown breaking changes may use a patch.\n"), "patch-level breaking-change policy"),
        ("false released baseline", replace(baseline, releasing=baseline.releasing + f"\n{RELEASE} is released.\n"), "false first-release claim"),
        ("required alpha suffix", replace(baseline, releasing=baseline.releasing + "\nThe Maven version must include an alpha suffix.\n"), "required Maven alpha suffix"),
        ("GitHub marker changes coordinate", replace(baseline, releasing=baseline.releasing + "\nThe GitHub pre-release marker changes the Maven coordinate.\n"), "GitHub marker changes release identity"),
        ("missing release document", replace(baseline, regular_files=baseline.regular_files - {"docs/releasing.md"}), "not a regular file"),
        ("README link hidden", replace(baseline, readme=replace_once(baseline.readme, "[Versioning](docs/versioning.md)", "<!-- [Versioning](docs/versioning.md) -->")), "README versioning links total 0"),
        ("claim only in fence", replace(baseline, versioning=replace_once(baseline.versioning, VERSIONING_CLAIMS[4], f"```text\n{VERSIONING_CLAIMS[4]}\n```")), "public API and behavior are provisional"),
        ("release build with snapshot documentation", replace(baseline, build=replace_once(baseline.build, VERSION, RELEASE)), "release"),
        ("snapshot build with release documentation", replace(release_baseline, build=replace_once(release_baseline.build, RELEASE, VERSION)), "snapshot"),
        ("release false publication", replace(release_baseline, readme=release_baseline.readme + "\nThe release is published.\n"), "publication"),
        ("release false availability", replace(release_baseline, readme=release_baseline.readme + "\nThe release is available from Maven Central.\n"), "availability"),
        ("release mutable bytes", replace(release_baseline, versioning=release_baseline.versioning + "\nRelease bytes may be replaced.\n"), "mutable release policy"),
        ("release missing notes", replace(release_baseline, releasing=replace_once(release_baseline.releasing, "Release notes", "Baseline notes")), "Release notes"),
        ("release GitHub marker changes identity", replace(release_baseline, releasing=release_baseline.releasing + "\nThe GitHub pre-release marker changes the Maven coordinate.\n"), "GitHub marker changes release identity"),
        ("release legacy alpha documentation", replace(release_baseline, versioning=replace_once(release_baseline.versioning, RELEASE_COORDINATE, f"{GROUP}:{ARTIFACT}:{legacy_release}")), "legacy prerelease version"),
    ]
    for name, mutated, expected in mutations:
        actual = validate(mutated, f"synthetic {name}")
        if not any(expected in error for error in actual):
            errors.append(f"self-test accepted {name} without {expected!r}")
    return errors


def read_documents() -> tuple[Documents, list[str]]:
    errors: list[str] = []
    contents: dict[str, str] = {}
    regular: set[str] = set()
    for relative in PATHS:
        candidate = ROOT / relative
        current = ROOT
        symlink = False
        for component in relative.split("/"):
            current /= component
            if current.is_symlink():
                errors.append(f"{relative}: symlinked path component is forbidden: {current.relative_to(ROOT)}")
                symlink = True
                break
        if symlink or not candidate.is_file():
            contents[relative] = ""
            continue
        regular.add(relative)
        try:
            contents[relative] = candidate.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            errors.append(f"{relative}: cannot read UTF-8 input: {error}")
            contents[relative] = ""
    return Documents(
        contents["docs/versioning.md"], contents["docs/releasing.md"],
        contents["README.md"], contents["docs/README.md"],
        contents["CHANGELOG.md"], contents["build.gradle.kts"], frozenset(regular),
    ), errors


def main() -> int:
    if sys.argv[1:] not in ([], ["--self-test"]):
        print("usage: check-api-compatibility-policy [--self-test]", file=sys.stderr)
        return 2
    if sys.argv[1:]:
        errors = self_test()
        success = "API compatibility policy hostile self-tests passed"
        detail = "exact snapshot/release documentation modes and provisional major-zero rules are fail-closed"
    else:
        documents, errors = read_documents()
        errors.extend(validate(documents, "current checkout"))
        success = "API compatibility policy passed"
        versions = re.findall(r'(?m)^version\s*=\s*"([^"]+)"\s*$', documents.build)
        detail = (
            "local-only mutable snapshot, provisional 0.x, immutable-release, and initial-baseline rules are fail-closed"
            if versions == [VERSION]
            else "exact immutable release-document state and provisional major-zero rules are fail-closed"
        )
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(success + ": " + detail)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
