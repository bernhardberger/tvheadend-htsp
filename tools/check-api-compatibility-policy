        )

    template_wrapped_root = root_link_pattern.sub(
        lambda match: f"<template>{match.group(0)}</template>",
        documents.root_readme,
        count=1,
    )
    if template_wrapped_root == documents.root_readme:
        errors.append(
            "governance self-test could not template-wrap the root policy link"
        )
    else:
        template_hidden_documents = replace(
            documents,
            root_readme=template_wrapped_root,
        )
        mutations.append(
            (
                "template-hidden root policy link",
                template_hidden_documents,
                "visible raw HTML element",
            ),
        )
        mutations.append(
            (
                "template-hidden root policy link visibility",
                template_hidden_documents,
                "root 0.x policy links total 0",
            ),
        )

    hidden_compatibility_claim = replace_normalized_phrase(
        documents.authority,
        NO_COMPATIBILITY_PROMISE,
        f"<div hidden>{NO_COMPATIBILITY_PROMISE}</div>",
    )
    if hidden_compatibility_claim == documents.authority:
        errors.append(
            "governance self-test could not hide the compatibility boundary in HTML"
        )
    else:
        hidden_claim_documents = replace(
            documents,
            authority=hidden_compatibility_claim,
        )
        mutations.append(
            (
                "hidden-HTML compatibility boundary",
                hidden_claim_documents,
                "visible raw HTML element",
            ),
        )
        mutations.append(
            (
                "hidden-HTML compatibility boundary visibility",
                hidden_claim_documents,
                "0.x no-compatibility-promise boundary",
            ),
        )

    code_wrapped_root = root_link_pattern.sub(
        lambda match: f"`{match.group(0)}`",
        documents.root_readme,
        count=1,
    )
    if code_wrapped_root == documents.root_readme:
