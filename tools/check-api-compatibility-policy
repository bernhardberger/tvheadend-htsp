def first_symlinked_repository_component(
    root: Path,
    relative_path: str,
) -> str | None:
    candidate = root
    components: list[str] = []
    for component in relative_path.split("/"):
        components.append(component)
        candidate /= component
        if candidate.is_symlink():
            return "/".join(components)
    return None


def read_documents(errors: list[str], root: Path = ROOT) -> Documents:
    contents: dict[str, str] = {}
    regular_files: set[str] = set()
    for path in REQUIRED_REGULAR_INPUTS:
        candidate = root / path
        symlinked_component = first_symlinked_repository_component(root, path)
        if symlinked_component is not None:
            errors.append(
                f"{path}: required governance input traverses symlinked repository "
                f"path component: {symlinked_component}",
            )
            contents[path] = ""
            continue
        if not candidate.is_file():
            contents[path] = ""
            continue
        regular_files.add(path)
        try:
            contents[path] = candidate.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            errors.append(f"{path}: unable to read required governance input: {error}")
            contents[path] = ""
    return Documents(
        authority=contents[AUTHORITY_PATH],
        root_readme=contents[ROOT_README_PATH],
        documentation_index=contents[DOCUMENTATION_INDEX_PATH],
        changelog=contents[CHANGELOG_PATH],
        migration_guide=contents[MIGRATION_GUIDE_PATH],
        build_config=contents[BUILD_CONFIG_PATH],
        regular_files=frozenset(regular_files),
    )


def ancestor_symlink_self_test_errors() -> list[str]:
    with tempfile.TemporaryDirectory() as temporary_directory:
        sandbox = Path(temporary_directory)
        synthetic_root = sandbox / "repository"
        outside_docs = sandbox / "outside-docs"
        synthetic_root.mkdir()
        outside_docs.mkdir()
        (synthetic_root / "docs").symlink_to(
            outside_docs,
            target_is_directory=True,
        )

        for path in REQUIRED_REGULAR_INPUTS:
            if path.startswith("docs/"):
                candidate = outside_docs / path.removeprefix("docs/")
            else:
                candidate = synthetic_root / path
            candidate.parent.mkdir(parents=True, exist_ok=True)
            candidate.write_bytes(b"app" + b"/libs\n")

        synthetic_errors: list[str] = []
        synthetic_documents = read_documents(synthetic_errors, synthetic_root)
        symlinked_inputs = tuple(
            path for path in REQUIRED_REGULAR_INPUTS if path.startswith("docs/")
        )
        expected_errors = [
            f"{path}: required governance input traverses symlinked repository "
            "path component: docs"
            for path in symlinked_inputs
        ]
        if (
            synthetic_errors == expected_errors
            and not set(symlinked_inputs) & synthetic_documents.regular_files
        ):
            return []
    return [
        "governance ancestor-symlink self-test failed to reject the first "
        "symlinked component without accepting outside-root marker content"
    ]


def main() -> int:
    errors: list[str] = []
    documents = read_documents(errors)
    errors.extend(validate_documents(documents, "current repository policy"))
    if not errors:
        verify_mutation_coverage(documents, errors)
    errors.extend(ancestor_symlink_self_test_errors())

    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1

    print(
        "0.x API compatibility governance passed: provisional compatibility, "
        "evidence limits, migration expectations, and readiness boundaries",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
