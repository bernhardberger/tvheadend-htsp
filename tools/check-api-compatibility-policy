    stale_build = documents.build_config.replace(
        f'val sdkPublicationVersion = "{EXPECTED_VERSION}"',
        'val sdkPublicationVersion = "0.2.0-SNAPSHOT"',
        1,
    )
    if stale_build == documents.build_config:
        errors.append("governance self-test could not create stale configured version")
    else:
        mutations.append(
            (
                "stale configured version",
                replace(documents, build_config=stale_build),
                "configured SDK versions",
            ),
        )

    missing_testing_abi = documents.authority.replace(
        "  `sdk/client-testing/api/client-testing.api`,\n",
