    index_link_pattern = re.compile(
        r"(?<!!)\[[^\]\n]+\]\(semantic-versioning-and-api-compatibility\.md\)",
    )
    code_wrapped_index = index_link_pattern.sub(
        lambda match: f"`{match.group(0)}`",
