        )

    root_link_pattern = re.compile(
        r"(?<!!)\[[^\]\n]+\]\(docs/semantic-versioning-and-api-compatibility\.md\)",
    )
    hidden_root = root_link_pattern.sub(
        lambda match: f"<!-- {match.group(0)} -->",
