def replace_normalized_phrase(text: str, phrase: str, replacement: str) -> str:
    pattern = r"\s+".join(re.escape(part) for part in phrase.split())
    return re.sub(pattern, lambda _: replacement, text, count=1)


def verify_mutation_coverage(documents: Documents, errors: list[str]) -> None:
    mutations: list[tuple[str, Documents, str]] = []

    def mutate_document(
        name: str,
        field_name: str,
        phrase: str,
        replacement: str,
        required_error: str,
    ) -> None:
        original = getattr(documents, field_name)
        mutated = replace_normalized_phrase(
            original,
            phrase,
            replacement,
        )
        if mutated == original:
            errors.append(f"governance self-test could not create {name}")
            return
        mutations.append(
            (
                name,
                replace(documents, **{field_name: mutated}),
                required_error,
            ),
        )

    def mutate_authority(
        name: str,
        phrase: str,
        replacement: str,
        required_error: str,
    ) -> None:
        mutate_document(name, "authority", phrase, replacement, required_error)

    def hide_link(
        name: str,
        field_name: str,
        pattern: re.Pattern[str],
        required_error: str,
    ) -> None:
        original = getattr(documents, field_name)
        mutated = pattern.sub(
            lambda match: f"<!-- {match.group(0)} -->",
            original,
            count=1,
        )
        if mutated == original:
            errors.append(f"governance self-test could not hide {name}")
            return
        mutations.append(
            (
                f"comment-hidden {name}",
                replace(documents, **{field_name: mutated}),
                required_error,
            ),
        )

    mutate_authority(
        "comment-and-fence-only compatibility boundary",
        NO_COMPATIBILITY_PROMISE,
        (
            f"<!-- {NO_COMPATIBILITY_PROMISE} -->\n\n"
            f"```text\n{NO_COMPATIBILITY_PROMISE}\n```"
        ),
        "0.x no-compatibility-promise boundary",
    )
    mutate_authority(
        "fence-only migration requirement",
        MIGRATION_REQUIREMENT,
        f"\n\n~~~text\n{MIGRATION_REQUIREMENT}\n~~~\n\n",
        "breaking-change migration requirement",
    )
    mutate_authority(
        "stale policy version coordinate",
        EXPECTED_VERSION,
        "0.2.0-SNAPSHOT",
        "visible policy version coordinates",
    )
    mutate_authority(
        "comment-and-fence-only documentation maintenance rule",
        MAINTENANCE_RULE,
        f"<!-- {MAINTENANCE_RULE} -->\n\n```text\n{MAINTENANCE_RULE}\n```",
        "accepted-slice documentation maintenance rule",
    )
    mutate_document(
        "comment-and-fence-only change-history status",
        "changelog",
        CHANGELOG_CURRENT_SNAPSHOT,
        (
            f"<!-- {CHANGELOG_CURRENT_SNAPSHOT} -->\n\n"
            f"~~~text\n{CHANGELOG_CURRENT_SNAPSHOT}\n~~~"
        ),
        "change-history current-snapshot status",
    )
    mutate_document(
        "comment-and-fence-only migration authority boundary",
        "migration_guide",
        MIGRATION_AUTHORITY_BOUNDARY,
        (
            f"<!-- {MIGRATION_AUTHORITY_BOUNDARY} -->\n\n"
            f"```text\n{MIGRATION_AUTHORITY_BOUNDARY}\n```"
        ),
        "migration-guide subordinate-authority boundary",
    )
    mutate_document(
        "stale change-history snapshot coordinate",
        "changelog",
        EXPECTED_VERSION,
        "0.2.0-SNAPSHOT",
        "change-history current-snapshot status",
    )
    mutate_document(
        "stale migration-guide snapshot coordinate",
        "migration_guide",
        EXPECTED_VERSION,
        "0.2.0-SNAPSHOT",
        "migration-guide current-snapshot target",
    )

    for field_name, record_name, error_prefix in (
        ("changelog", "change-history", "change-history"),
        ("migration_guide", "migration-guide", "migration-guide"),
    ):
        for claim, description, weakened_claim in ACCEPTED_CONTRACT_CLAIMS:
            required_error = f"{error_prefix} {description}"
            mutate_document(
                f"removed {record_name} {description}",
                field_name,
                claim,
                "Contract intentionally omitted.",
                required_error,
            )
            mutate_document(
                f"weakened {record_name} {description}",
                field_name,
                claim,
                weakened_claim,
                required_error,
            )
            mutate_document(
                f"additively contradicted {record_name} {description}",
                field_name,
