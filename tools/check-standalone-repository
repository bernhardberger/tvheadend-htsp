def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read(path: Path, errors: list[str]) -> str:
    try:
        if path.is_symlink() or not path.is_file():
            raise OSError("not a regular file")
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        errors.append(f"{path}: required UTF-8 file is unavailable ({error})")
        return ""


def kotlin_tokens(text: str) -> tuple[list[tuple[str, str, int, int]], str | None]:
    """Tokenize only the Kotlin syntax needed to locate a bounded task body."""
    tokens: list[tuple[str, str, int, int]] = []
    index = 0
    while index < len(text):
        character = text[index]
        if character.isspace():
            index += 1
            continue
        if text.startswith("//", index):
            newline = text.find("\n", index + 2)
            index = len(text) if newline < 0 else newline + 1
            continue
        if text.startswith("/*", index):
            depth = 1
            index += 2
            while index < len(text) and depth:
                if text.startswith("/*", index):
                    depth += 1
                    index += 2
                elif text.startswith("*/", index):
                    depth -= 1
                    index += 2
                else:
                    index += 1
            if depth:
                return tokens, "unclosed block comment"
            continue
        if text.startswith('"""', index):
            start = index
            closing = text.find('"""', index + 3)
            if closing < 0:
                return tokens, "unclosed triple-quoted string"
            index = closing + 3
            tokens.append(("string", text[start:index], start, index))
            continue
        if character in {'"', "'"}:
            start = index
            quote = character
            index += 1
            while index < len(text):
                if text[index] == "\\":
                    index += 2
                elif text[index] == quote:
                    index += 1
                    tokens.append(("string" if quote == '"' else "character", text[start:index], start, index))
                    break
                elif text[index] == "\n":
                    return tokens, "unclosed quoted literal"
                else:
                    index += 1
            else:
                return tokens, "unclosed quoted literal"
            continue
        if character.isalpha() or character == "_":
            start = index
            index += 1
            while index < len(text) and (text[index].isalnum() or text[index] == "_"):
                index += 1
            tokens.append(("identifier", text[start:index], start, index))
            continue
        tokens.append(("symbol", character, index, index + 1))
        index += 1
    return tokens, None


def matching_brace(tokens: list[tuple[str, str, int, int]], opening: int) -> int | None:
    depth = 0
    for index in range(opening, len(tokens)):
        value = tokens[index][1]
        if value == "{":
            depth += 1
        elif value == "}":
            depth -= 1
            if depth == 0:
                return index
    return None


def kotlin_brace_balance_error(tokens: list[tuple[str, str, int, int]]) -> str | None:
    depth = 0
    for token in tokens:
        if token[1] == "{":
            depth += 1
        elif token[1] == "}":
            depth -= 1
            if depth < 0:
                return "build Kotlin structure is unbalanced: unmatched closing brace"
    if depth != 0:
        return "build Kotlin structure is unbalanced: unmatched opening brace"
    return None


def direct_dependency_task_errors(build: str) -> list[str]:
    tokens, lexical_error = kotlin_tokens(build)
    if lexical_error is not None:
        return [f"target task declaration malformed: {lexical_error}"]
    brace_balance_error = kotlin_brace_balance_error(tokens)

    target = '"verifyProductionDependencyGraph"'
    declarations: list[tuple[int, int]] = []
    for index in range(len(tokens) - 4):
        if (
            tokens[index][0:2] == ("identifier", "tasks")
            and tokens[index + 1][1] == "."
            and tokens[index + 2][0:2] == ("identifier", "register")
            and tokens[index + 3][1] == "("
            and tokens[index + 4][0:2] == ("string", target)
        ):
            declarations.append((index, index + 4))
    if not declarations:
        return ["target task declaration missing"]
    if len(declarations) != 1:
        return ["target task declaration duplicated"]

    declaration, name = declarations[0]
    if name + 2 >= len(tokens) or tokens[name + 1][1] != ")" or tokens[name + 2][1] != "{":
        return ["target task declaration malformed"]

    task_open = name + 2
    task_close = matching_brace(tokens, task_open)
    if task_close is None:
        return ["target task body is unbalanced"]
    if brace_balance_error is not None:
        return [brace_balance_error]

    prefix_depth = {"{": 0, "(": 0, "[": 0}
    closing_to_opening = {"}": "{", ")": "(", "]": "["}
    for token in tokens[:declaration]:
        value = token[1]
        if value in prefix_depth:
            prefix_depth[value] += 1
        elif value in closing_to_opening:
            opening = closing_to_opening[value]
            prefix_depth[opening] -= 1
    previous = tokens[declaration - 1][1] if declaration else None
    if any(prefix_depth.values()) or previous == ".":
        return ["target task declaration must be a standalone top-level expression"]
    if previous in {"=", "by"}:
        return ["target task declaration must be an uncaptured top-level expression"]

    task_depth = 1
    do_last_identifiers: list[int] = []
    for index in range(task_open + 1, task_close):
        value = tokens[index][1]
        if tokens[index][0:2] == ("identifier", "doLast") and task_depth == 1:
            do_last_identifiers.append(index)
        if value == "{":
            task_depth += 1
        elif value == "}":
            task_depth -= 1
    if (
        len(do_last_identifiers) != 1
        or tokens[do_last_identifiers[0] - 1][1] == "."
        or do_last_identifiers[0] + 1 >= task_close
        or tokens[do_last_identifiers[0] + 1][1] != "{"
    ):
        return ["target task action must be one unqualified doLast"]
    do_last_open = do_last_identifiers[0] + 1
    do_last_close = matching_brace(tokens, do_last_open)
    if do_last_close is None or do_last_close >= task_close:
        return ["target task body is unbalanced"]

    task_tokens = tokens[task_open + 1:task_close]
    for index in range(len(task_tokens) - 2):
        values = tuple(token[1] for token in task_tokens[index:index + 3])
        if values == ("enabled", "=", "false"):
            return ["target task executable bypass forbidden: enabled = false"]
        if values == ("return", "@", "doLast"):
            return ["target task executable bypass forbidden: return@doLast"]
    for index, token in enumerate(task_tokens):
        if token[0:2] != ("identifier", "onlyIf"):
            continue
        opening = index + 1
        while opening < len(task_tokens) and task_tokens[opening][1] != "{":
            opening += 1
        if opening < len(task_tokens):
            closing = matching_brace(task_tokens, opening)
            if closing is not None and [item[0:2] for item in task_tokens[opening + 1:closing]] == [
                ("identifier", "false")
            ]:
                return ["target task executable bypass forbidden: onlyIf false"]

    target_name_tokens = [
        token for token in tokens
        if token[0] == "string" and token[1] in {target, f'"""{target[1:-1]}"""'}
    ]
    if len(target_name_tokens) != 1:
        return ["target task reconfiguration outside declaration is forbidden"]

    expected_tokens, expected_error = kotlin_tokens(DIRECT_DEPENDENCY_TASK_BODY_CONTRACT)
    if expected_error is not None:
        raise AssertionError(f"invalid pinned target task contract: {expected_error}")
    if [token[0:2] for token in task_tokens] != [token[0:2] for token in expected_tokens]:
        return ["target task body contract mismatch"]
    trailing_tokens = tokens[task_close + 1:]
    if trailing_tokens:
        if trailing_tokens[0][1] == ".":
            return ["target task declaration must be a standalone final expression"]
        return ["executable tokens after target task are forbidden"]
    return []


def category_files(root: Path) -> dict[str, list[Path]]:
    return {
        "production": sorted((root / "src/main/kotlin").rglob("*.kt")),
        "tests": sorted((root / "src/test/kotlin").rglob("*.kt")),
        "golden": sorted((root / "src/test/resources").rglob("*.hex")),
        "api": [root / "api/htsp.api"],
        "protocol evidence": sorted(
            path for path in (root / "docs/htsp-protocol").iterdir()
            if path.name != "README.md"
        ) if (root / "docs/htsp-protocol").is_dir() else [],
        "generated": sorted((root / "src/main/kotlin").rglob("Generated*.kt")),
    }


def category_digest(root: Path, paths: list[Path]) -> str:
    manifest = "".join(
        f"{sha256(path)}  {path.relative_to(root).as_posix()}\n" for path in paths
    )
    return hashlib.sha256(manifest.encode()).hexdigest()


def topology_errors(root: Path) -> list[str]:
    errors: list[str] = []
    try:
        mode = root.lstat().st_mode
    except OSError as error:
        return [f"repository topology is unavailable: {error}"]
    if stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
        return ["repository root must be a real directory"]
    actual_root = {entry.name for entry in os.scandir(root)}
    if actual_root != ROOT_ENTRIES:
        errors.append(
            f"root topology mismatch; missing={sorted(ROOT_ENTRIES - actual_root)}, "
            f"extra={sorted(actual_root - ROOT_ENTRIES)}"
        )

    files: set[str] = set()
    for directory, names, names_files in os.walk(root, followlinks=False):
        current = Path(directory)
        relative_directory = current.relative_to(root)
        if relative_directory == Path(".git"):
            names[:] = []
            continue
        names[:] = sorted(name for name in names if name != "__pycache__" and not (
            relative_directory == Path(".") and name == ".git"
        ))
        if relative_directory != Path(".") and not names and not names_files:
            errors.append(f"{relative_directory.as_posix()}: empty directory is not allowed")
        for name in [*names, *(name for name in names_files if not name.endswith(".pyc"))]:
            path = current / name
            relative = path.relative_to(root).as_posix()
            try:
                entry_mode = path.lstat().st_mode
            except OSError:
                errors.append(f"{relative}: topology entry cannot be inspected")
                continue
            if stat.S_ISLNK(entry_mode):
                errors.append(f"{relative}: topology must not contain symlinks or escapes")
                if name in names:
                    names.remove(name)
            elif name in names and not stat.S_ISDIR(entry_mode):
                errors.append(f"{relative}: topology directory must be real")
            elif name in names_files and not stat.S_ISREG(entry_mode):
                errors.append(f"{relative}: topology file must be regular")
            elif name in names_files:
                files.add(relative)

    fixed = {
        ".gitattributes", ".gitignore", "AGENTS.md", "CONTRIBUTING.md", "LICENSE",
        "NOTICE.md", "README.md", "build.gradle.kts", "gradlew", "gradlew.bat",
        "settings.gradle.kts", ".github/workflows/ci.yml", "api/htsp.api",
        "gradle/wrapper/gradle-wrapper.jar", "gradle/wrapper/gradle-wrapper.properties",
        *DOC_FILES, *TOOL_FILES, *FIXTURE_FILES,
    }
    dynamic = {
        path for path in files if (
            (path.startswith("src/main/kotlin/") and path.endswith(".kt"))
            or (path.startswith("src/test/kotlin/") and path.endswith(".kt"))
            or (path.startswith("src/test/resources/") and path.endswith(".hex"))
        )
    }
    if files != fixed | dynamic:
        errors.append(
            f"file topology mismatch; missing={sorted((fixed | dynamic) - files)}, "
            f"extra={sorted(files - fixed - dynamic)}"
        )
    for executable in {"gradlew", *TOOL_FILES}:
        path = root / executable
        try:
            if path.stat().st_mode & 0o111 == 0:
                errors.append(f"{executable}: required executable mode is missing")
        except OSError:
            pass
    return errors


def immutable_errors(root: Path) -> list[str]:
    errors: list[str] = []
    for label, paths in category_files(root).items():
        expected_count, expected_digest = IMMUTABLE[label]
        regular = [path for path in paths if path.is_file() and not path.is_symlink()]
        actual_digest = category_digest(root, regular)
        if len(regular) != expected_count or actual_digest != expected_digest:
            errors.append(
                f"immutable {label} drift: count={len(regular)}/{expected_count}, "
                f"digest={actual_digest}/{expected_digest}"
            )
    return errors


def attributes_errors(root: Path) -> list[str]:
    errors: list[str] = []
    attributes = read(root / ".gitattributes", errors)
    if attributes != ATTRIBUTES_POLICY:
        errors.append(
            ".gitattributes: exact policy mismatch; expected gradlew.bat text eol=lf"
        )
    return errors


def wrapper_errors(root: Path) -> list[str]:
    errors = attributes_errors(root)
    for relative, expected in WRAPPER_HASHES.items():
        path = root / relative
        if not path.is_file() or path.is_symlink() or sha256(path) != expected:
            errors.append(f"wrapper hash mismatch: {relative}")
    properties = read(root / "gradle/wrapper/gradle-wrapper.properties", errors)
    required = (
        f"distributionUrl={DIST_URL}", f"distributionSha256Sum={DIST_HASH}",
        "validateDistributionUrl=true",
    )
    for value in required:
        if properties.count(value) != 1:
            errors.append(f"wrapper properties must contain exactly one {value}")
    provenance = read(root / "docs/wrapper-provenance.md", errors)
    for value in (*WRAPPER_HASHES.values(), DIST_HASH, "68e20fba3b21579ea9eea6271a4dae0d6b0b12a8"):
        if provenance.count(value) != 1:
            errors.append(f"wrapper provenance pin mismatch: {value}")
    for value in (
        "## Version-neutral launcher and wrapper JAR",
        "## Official distribution pin",
        DIST_URL.replace(r"\:", ":"),
    ):
        if provenance.count(value) != 1:
            errors.append(f"wrapper provenance separation mismatch: {value}")
    return errors


def fenced_block(text: str, marker: str) -> str | None:
    matches = re.findall(
        rf"<!-- {re.escape(marker)} -->\s*```kotlin\n(.*?)```",
        text,
        flags=re.S,
    )
    return matches[0] if len(matches) == 1 else None


