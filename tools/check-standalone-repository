def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read(root: Path, relative: str, errors: list[str]) -> str:
    path = root / relative
    try:
        if not stat.S_ISREG(path.lstat().st_mode):
            raise OSError("not a regular file")
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        errors.append(f"{relative}: required UTF-8 regular file unavailable ({error})")
        return ""


def category_files(root: Path) -> dict[str, list[Path]]:
    protocol = root / "docs/htsp-protocol"
    return {
        "production": sorted((root / "src/main/kotlin").rglob("*.kt")),
        "tests": sorted((root / "src/test/kotlin").rglob("*.kt")),
        "golden": sorted((root / "src/test/resources").rglob("*.hex")),
        "api": [root / "api/htsp.api"],
        "protocol evidence": sorted(path for path in protocol.iterdir() if path.name != "README.md") if protocol.is_dir() else [],
        "generated": sorted((root / "src/main/kotlin").rglob("Generated*.kt")),
        "generators": sorted(protocol.glob("generate_*.py")) if protocol.is_dir() else [],
    }


def category_digest(root: Path, paths: list[Path]) -> str:
    manifest = "".join(f"{sha256_file(path)}  {path.relative_to(root).as_posix()}\n" for path in paths)
    return hashlib.sha256(manifest.encode()).hexdigest()


def immutable_errors(root: Path) -> list[str]:
    errors: list[str] = []
    for label, paths in category_files(root).items():
        regular = [path for path in paths if path.is_file() and not path.is_symlink()]
        expected_count, expected_digest = IMMUTABLE[label]
        digest = category_digest(root, regular)
        if len(regular) != expected_count or digest != expected_digest:
            errors.append(f"immutable {label} drift: count={len(regular)}/{expected_count}, digest={digest}/{expected_digest}")
    for relative, expected in POLICY_HASHES.items():
        path = root / relative
        if not path.is_file() or path.is_symlink() or sha256_file(path) != expected:
            errors.append(f"immutable license, attribution, or public-key drift: {relative}")
    return errors


def topology_errors(root: Path) -> list[str]:
    errors: list[str] = []
    try:
        if stat.S_ISLNK(root.lstat().st_mode) or not root.is_dir():
            return ["repository root must be a real directory"]
    except OSError as error:
        return [f"repository root unavailable: {error}"]
    actual_root = {entry.name for entry in os.scandir(root)}
    if actual_root != ROOT_ENTRIES:
        errors.append(f"root topology mismatch; missing={sorted(ROOT_ENTRIES - actual_root)}, extra={sorted(actual_root - ROOT_ENTRIES)}")
    files: set[str] = set()
    for directory, directories, names in os.walk(root, followlinks=False):
        current = Path(directory)
        relative_directory = current.relative_to(root)
        if relative_directory == Path(".git"):
            directories[:] = []
            continue
        if relative_directory == Path(".opencode"):
            directories[:] = [name for name in directories if name != "node_modules"]
            names[:] = [
                name for name in names
                if name not in {".gitignore", "bun.lock", "package-lock.json", "package.json"}
            ]
        directories[:] = sorted(name for name in directories if not (relative_directory == Path(".") and name == ".git"))
        for name in list(directories):
            path = current / name
            relative = path.relative_to(root).as_posix()
            if path.is_symlink():
                errors.append(f"{relative}: symlink/escape is forbidden")
                directories.remove(name)
            elif name == "__pycache__":
                errors.append(f"{relative}: Python cache directory is forbidden")
        for name in names:
            path = current / name
            relative = path.relative_to(root).as_posix()
            try:
                regular = stat.S_ISREG(path.lstat().st_mode)
            except OSError:
                regular = False
            if not regular:
                errors.append(f"{relative}: expected regular file")
            else:
                files.add(relative)
            if name.endswith(".pyc"):
                errors.append(f"{relative}: Python cache bytecode is forbidden")
    fixed = {
        ".gitattributes", ".gitignore", ".github/workflows/ci.yml",
        ".github/workflows/release.yml", ".opencode/opencode.json", "AGENTS.md", "CHANGELOG.md",
        "CONTRIBUTING.md", "HANDOFF.md", "LICENSE", "NOTICE.md", "README.md", "api/htsp.api",
        "build.gradle.kts", "gradle.properties", "gradlew", "gradlew.bat", "settings.gradle.kts",
        "detekt.yml",
        "gradle/gradle-daemon-jvm.properties", "gradle/libs.versions.toml",
        "gradle/verification-metadata.xml",
        "gradle/wrapper/gradle-wrapper.jar", "gradle/wrapper/gradle-wrapper.properties",
        *DOC_FILES, *TOOL_FILES, *FIXTURE_FILES, *OPENPGP_FILES,
    }
    dynamic = {path for path in files if (
        (path.startswith("src/main/kotlin/") and path.endswith(".kt"))
        or (path.startswith("src/test/kotlin/") and path.endswith(".kt"))
        or (path.startswith("src/test/resources/") and path.endswith(".hex"))
    )}
    expected = fixed | dynamic
    if files != expected:
        errors.append(f"file topology mismatch; missing={sorted(expected - files)}, extra={sorted(files - expected)}")
    if len(files) != 113:
        errors.append(f"tracked-source topology must contain 113 files, found {len(files)}")
    for executable in {"gradlew", *TOOL_FILES}:
        path = root / executable
        if path.is_file() and path.stat().st_mode & 0o111 == 0:
            errors.append(f"{executable}: executable mode is missing")
    for workflow in (".github/workflows/ci.yml", ".github/workflows/release.yml"):
        path = root / workflow
        if path.is_file() and path.stat().st_mode & 0o111:
            errors.append(f"{workflow}: workflow must not be executable")
    return errors


