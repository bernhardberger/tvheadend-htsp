def yaml_active_line(line: str) -> str:
    single = False
    double = False
    escaped = False
    for index, character in enumerate(line):
        if escaped:
            escaped = False
            continue
        if character == "\\" and double:
            escaped = True
        elif character == "'" and not double:
            single = not single
        elif character == '"' and not single:
            double = not double
        elif character == "#" and not single and not double and (index == 0 or line[index - 1].isspace()):
            return line[:index].rstrip()
    return line.rstrip()


def ci_verify_errors(root: Path) -> list[str]:
    errors: list[str] = []
    ci = read(root, ".github/workflows/ci.yml", errors)
    verify = read(root, "tools/verify-htsp", errors)
    active_ci = tuple(active for line in ci.splitlines() if (active := yaml_active_line(line)).strip())
    if active_ci != CI_ACTIVE_POLICY:
        errors.append("CI exact active-YAML policy mismatch")
    if re.search(r"\bhtsp-0\.1\.0-(?:alpha|beta|rc)(?:[.-][0-9A-Za-z]+)*", "\n".join(active_ci)):
        errors.append("stale alpha version or filename is forbidden in active CI policy")
    bytecode_policy = "export PYTHONDONTWRITEBYTECODE=1"
    first_invocation = min(
        position for position in (verify.find("./tools/"), verify.find("python3 "), verify.find("./gradlew "))
        if position >= 0
    )
    bytecode_position = verify.find(bytecode_policy)
    if verify.count(bytecode_policy) != 1 or bytecode_position < 0 or bytecode_position > first_invocation:
        errors.append("verifier must export exact PYTHONDONTWRITEBYTECODE=1 before every checker, generator, or build invocation")
    required_order = [
        "./tools/check-standalone-repository --self-test",
        "./tools/check-standalone-repository",
        "./tools/check-release-candidate --self-test",
        "./tools/check-release-candidate --check-setup",
        "./tools/check-api-compatibility-policy --self-test",
        "./tools/check-api-compatibility-policy",
        "./tools/check-published-jvm-compatibility --self-test",
        "if [ \"${1-}\" = \"--non-gradle\" ]; then",
        "./gradlew --no-daemon clean build test check checkLegacyAbi verifyClassMajor61 verifyProductionDependencyGraph stageLocalPublication",
        "./tools/check-published-jvm-compatibility --write-manifest build/publication-first.json",
        "rm -rf build/local-maven",
        "./gradlew --no-daemon stageLocalPublication",
        "./tools/check-published-jvm-compatibility --compare-manifest build/publication-first.json",
        "./gradlew --no-daemon --refresh-dependencies -p consumer-contract clean compileKotlin verifyConsumerDependencyGraph",
    ]
    positions = [verify.find(value) for value in required_order]
    if any(position < 0 for position in positions) or positions != sorted(positions):
        errors.append("verifier P3-E2 stage/inspect/recreate/compare/consumer ordering mismatch")
    if verify.count("./tools/check-api-compatibility-policy") != 2 or verify.count("./tools/check-published-jvm-compatibility") != 4 or verify.count("./tools/check-release-candidate") != 2:
        errors.append("verifier P3-E2 checker activation count mismatch")
    if verify.count("./gradlew ") != 3 or verify.count("--no-daemon") != 3:
        errors.append("every and only the three verifier Gradle calls must use --no-daemon")
    non_gradle = verify.find('if [ "${1-}" = "--non-gradle" ]; then')
    first_gradle = verify.find("./gradlew ")
    if non_gradle < 0 or first_gradle < non_gradle:
        errors.append("--non-gradle must exit before staging, artifact inspection, and consumer compilation")
    for token in ("credentials {", "gh ", "git push", "publishToMavenLocal", "secrets.", "curl ", "wget ", "ssh "):
        if token in verify:
            errors.append(f"verifier forbidden outbound/signing/credential operation: {token}")
    return errors


