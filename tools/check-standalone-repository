def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def portable_ast_dump(node: ast.AST) -> str:
    try:
        return ast.dump(node, include_attributes=False, show_empty=True)
    except TypeError:
        return ast.dump(node, include_attributes=False)


def read(root: Path, relative: str, errors: list[str]) -> str:
    path = root / relative
    try:
        if path.is_symlink() or not path.is_file():
            raise OSError("not a regular file")
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        errors.append(f"{relative}: required UTF-8 regular file unavailable ({error})")
        return ""


def category_files(root: Path) -> dict[str, list[Path]]:
    protocol = root / "docs/htsp-protocol"
    return {
        "production": sorted((root / "src/main/kotlin").rglob("*.kt")),
        "tests": sorted((root / "src/test/kotlin").rglob("*.kt")),
        "golden": sorted((root / "src/test/resources").rglob("*.hex")),
        "api": [root / "api/htsp.api"],
        "protocol evidence": sorted(path for path in protocol.iterdir() if path.name != "README.md") if protocol.is_dir() else [],
        "generated": sorted((root / "src/main/kotlin").rglob("Generated*.kt")),
        "generators": sorted(protocol.glob("generate_*.py")) if protocol.is_dir() else [],
    }


def category_digest(root: Path, paths: list[Path]) -> str:
    manifest = "".join(f"{sha256(path)}  {path.relative_to(root).as_posix()}\n" for path in paths)
    return hashlib.sha256(manifest.encode()).hexdigest()


def immutable_errors(root: Path) -> list[str]:
    errors: list[str] = []
    for label, paths in category_files(root).items():
        regular = [path for path in paths if path.is_file() and not path.is_symlink()]
        expected_count, expected_digest = IMMUTABLE[label]
        actual_digest = category_digest(root, regular)
        if len(regular) != expected_count or actual_digest != expected_digest:
            errors.append(f"immutable {label} drift: count={len(regular)}/{expected_count}, digest={actual_digest}/{expected_digest}")
    return errors


def topology_errors(root: Path) -> list[str]:
    errors: list[str] = []
    try:
        if stat.S_ISLNK(root.lstat().st_mode) or not root.is_dir():
            return ["repository root must be a real directory"]
    except OSError as error:
        return [f"repository root unavailable: {error}"]
    actual_root = {entry.name for entry in os.scandir(root)}
    if actual_root != ROOT_ENTRIES:
        errors.append(f"root topology mismatch; missing={sorted(ROOT_ENTRIES - actual_root)}, extra={sorted(actual_root - ROOT_ENTRIES)}")
    files: set[str] = set()
    for directory, directories, names in os.walk(root, followlinks=False):
        current = Path(directory)
        relative_directory = current.relative_to(root)
        if relative_directory == Path(".git"):
            directories[:] = []
            continue
        directories[:] = sorted(name for name in directories if not (relative_directory == Path(".") and name == ".git"))
        for name in directories:
            if name == "__pycache__":
                errors.append(f"{(current / name).relative_to(root).as_posix()}: Python cache directory is forbidden")
        for name in names:
            if name.endswith(".pyc"):
                errors.append(f"{(current / name).relative_to(root).as_posix()}: Python cache bytecode is forbidden")
        for name in [*directories, *names]:
            path = current / name
            relative = path.relative_to(root).as_posix()
            mode = path.lstat().st_mode
            if stat.S_ISLNK(mode):
                errors.append(f"{relative}: symlink/escape is forbidden")
                if name in directories:
                    directories.remove(name)
            elif name in directories and not stat.S_ISDIR(mode):
                errors.append(f"{relative}: expected real directory")
            elif name in names and not stat.S_ISREG(mode):
                errors.append(f"{relative}: expected regular file")
            elif name in names:
                files.add(relative)
    fixed = {
        ".gitattributes", ".gitignore", ".github/workflows/ci.yml", "AGENTS.md",
        "CHANGELOG.md", "CONTRIBUTING.md", "LICENSE", "NOTICE.md", "README.md",
        "api/htsp.api", "build.gradle.kts", "gradlew", "gradlew.bat",
        "settings.gradle.kts", "gradle/wrapper/gradle-wrapper.jar",
        "gradle/wrapper/gradle-wrapper.properties", *DOC_FILES, *TOOL_FILES,
        *FIXTURE_FILES, *OPENPGP_REQUIRED,
    }
    present_openpgp = OPENPGP_OPTIONAL & files
    if present_openpgp and present_openpgp != OPENPGP_OPTIONAL:
        errors.append("public OpenPGP key and primary fingerprint metadata must be tracked together")
    fixed |= present_openpgp
    dynamic = {path for path in files if (
        (path.startswith("src/main/kotlin/") and path.endswith(".kt"))
        or (path.startswith("src/test/kotlin/") and path.endswith(".kt"))
        or (path.startswith("src/test/resources/") and path.endswith(".hex"))
    )}
    if files != fixed | dynamic:
        errors.append(f"file topology mismatch; missing={sorted((fixed | dynamic) - files)}, extra={sorted(files - fixed - dynamic)}")
    for executable in {"gradlew", *TOOL_FILES}:
        path = root / executable
        if path.is_file() and path.stat().st_mode & 0o111 == 0:
            errors.append(f"{executable}: executable mode is missing")
    return errors


def wrapper_errors(root: Path) -> list[str]:
    errors: list[str] = []
    if read(root, ".gitattributes", errors) != ATTRIBUTES_POLICY:
        errors.append(".gitattributes: exact wrapper/text policy mismatch")
    for relative, expected in WRAPPER_HASHES.items():
        path = root / relative
        if not path.is_file() or path.is_symlink() or sha256(path) != expected:
            errors.append(f"wrapper hash mismatch: {relative}")
    properties = read(root, "gradle/wrapper/gradle-wrapper.properties", errors)
    for value in (f"distributionUrl={DIST_URL}", f"distributionSha256Sum={DIST_HASH}", "validateDistributionUrl=true"):
        if properties.count(value) != 1:
            errors.append(f"wrapper properties mismatch: {value}")
    provenance = read(root, "docs/wrapper-provenance.md", errors)
    for value in (*WRAPPER_HASHES.values(), DIST_HASH, "68e20fba3b21579ea9eea6271a4dae0d6b0b12a8"):
        if provenance.count(value) != 1:
            errors.append(f"wrapper provenance pin mismatch: {value}")
    return errors


def fenced_block(text: str, marker: str) -> str | None:
    matches = re.findall(rf"<!-- {re.escape(marker)} -->\s*```kotlin\n(.*?)```", text, re.S)
    return matches[0] if len(matches) == 1 else None


