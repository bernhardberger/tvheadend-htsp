        'freeCompilerArgs.add("-Xjdk-release=17")': 2,
        "JavaVersion.VERSION_17": 2,
        "options.release.set(17)": 1,
    }
    for value, count in fixture_required_counts.items():
        if fixture_build.count(value) != count:
            errors.append(f"consumer fixture build policy mismatch: {value}")
    fixture_settings = read(root / "consumer-contract/settings.gradle.kts", errors)
    fixture_combined = fixture_build + "\n" + fixture_settings
    forbidden = (
        "mavenLocal", "includeBuild", "ProjectDependency", "FileCollectionDependency",
        "project(", "files(", "fileTree(", "flatDir", "exclusiveContent", "local-maven",
        "maven-publish", "publishing {", "signing",
    )
    for token in forbidden:
        if token in fixture_combined:
            errors.append(f"consumer fixture repository/dependency bypass is forbidden: {token}")
    if fixture_settings.count("mavenCentral()") != 2:
        errors.append("consumer fixture must use only its two declared Maven Central repositories")
    if (
        fixture_settings.count("gradlePluginPortal()") != 1
        or fixture_settings.count("RepositoriesMode.FAIL_ON_PROJECT_REPOS") != 1
        or fixture_settings.count('rootProject.name = "htsp-consumer-contract"') != 1
    ):
        errors.append("consumer fixture settings policy mismatch")
    return errors


