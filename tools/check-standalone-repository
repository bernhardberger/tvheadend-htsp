def package_errors(root: Path) -> list[str]:
    errors: list[str] = []
    packages: set[str] = set()
    for source in sorted((root / "src/main/kotlin").rglob("*.kt")):
        text = read(root, source.relative_to(root).as_posix(), errors)
        match = re.search(r"(?m)^package\s+([A-Za-z0-9_.]+)\s*$", text)
        if match:
            packages.add(match.group(1))
    if packages != PACKAGES:
        errors.append(f"production package set mismatch: {sorted(packages)}")
    return errors


def portable_temp_errors(root: Path) -> list[str]:
    errors: list[str] = []
    for relative in TEMP_CHECKERS:
        text = read(root, relative, errors)
        try:
            tree = ast.parse(text, filename=relative)
        except SyntaxError as error:
            errors.append(f"{relative}: cannot inspect temporary-directory policy ({error})")
            continue
        parents = {
            child: parent
            for parent in ast.walk(tree)
            for child in ast.iter_child_nodes(parent)
        }
        tempfile_imports = [
            (node, alias)
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.name == "tempfile" or alias.name.startswith("tempfile.")
        ]
        canonical_import = (
            len(tempfile_imports) == 1
            and tempfile_imports[0][1].name == "tempfile"
            and tempfile_imports[0][1].asname is None
            and len(tempfile_imports[0][0].names) == 1
        )
        imported_factories = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom)
            and (node.module == "tempfile" or (node.module or "").startswith("tempfile."))
        ]
        alternate_tempfile_import_bindings = [
            alias
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.asname == "tempfile"
        ] + [
            alias
            for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom)
            for alias in node.names
            if (alias.asname or alias.name) == "tempfile"
        ]
        tempfile_rebindings = [
            node for node in ast.walk(tree)
            if (
                isinstance(node, ast.Name)
                and not isinstance(node.ctx, ast.Load)
                and node.id == "tempfile"
            ) or (
                isinstance(node, ast.arg) and node.arg == "tempfile"
            ) or (
                isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
                and node.name == "tempfile"
            ) or (
                isinstance(node, ast.ExceptHandler) and node.name == "tempfile"
            )
        ]
        loaded_modules = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Name)
            and isinstance(node.ctx, ast.Load)
            and node.id == "tempfile"
        ]
        attributes = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Attribute)
            and isinstance(node.ctx, ast.Load)
            and node.attr == "TemporaryDirectory"
        ]
        bare_factories = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Name)
            and isinstance(node.ctx, ast.Load)
            and node.id == "TemporaryDirectory"
        ]
        forbidden_builtin_calls = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Call)
            and isinstance(node.func, ast.Name)
            and node.func.id in {"getattr", "setattr", "__import__"}
        ]
        importlib_bindings = {
            alias.asname or "importlib"
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.name == "importlib"
        }
        imported_import_module_bindings = {
            alias.asname or alias.name
            for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom) and node.module == "importlib"
            for alias in node.names
            if alias.name == "import_module"
        }
        dynamic_imports = [
            node for node in ast.walk(tree)
            if (
                isinstance(node, ast.Attribute)
                and isinstance(node.ctx, ast.Load)
                and node.attr == "import_module"
                and isinstance(node.value, ast.Name)
                and node.value.id in importlib_bindings
            ) or (
                isinstance(node, ast.Name)
                and isinstance(node.ctx, ast.Load)
                and node.id in imported_import_module_bindings
            )
        ]
        sys_bindings = {
            alias.asname or "sys"
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.name == "sys"
        }
        imported_sys_modules_bindings = {
            alias.asname or alias.name
            for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom) and node.module == "sys"
            for alias in node.names
            if alias.name == "modules"
        }
        module_lookups = [
            node for node in ast.walk(tree)
            if (
                isinstance(node, ast.Attribute)
                and isinstance(node.ctx, ast.Load)
                and node.attr == "modules"
                and isinstance(node.value, ast.Name)
                and node.value.id in sys_bindings
            ) or (
                isinstance(node, ast.Name)
                and isinstance(node.ctx, ast.Load)
                and node.id in imported_sys_modules_bindings
            )
        ]
        functions = [
            node for node in ast.walk(tree)
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == "self_test"
        ]
        call = parents.get(attributes[0]) if len(attributes) == 1 else None
        item = parents.get(call) if isinstance(call, ast.Call) else None
        statement = parents.get(item) if isinstance(item, ast.withitem) else None
        anchored = (
            canonical_import
            and len(loaded_modules) == 1
            and len(attributes) == 1
            and attributes[0].value is loaded_modules[0]
            and isinstance(call, ast.Call)
            and call.func is attributes[0]
            and isinstance(item, ast.withitem)
            and item.context_expr is call
            and isinstance(statement, ast.With)
            and len(statement.items) == 1
            and len(functions) == 1
            and parents.get(statement) is functions[0]
            and not bare_factories
            and not imported_factories
            and not alternate_tempfile_import_bindings
            and not tempfile_rebindings
            and not forbidden_builtin_calls
            and not dynamic_imports
            and not module_lookups
        )
        if not anchored:
            errors.append(
                f"{relative}: temporary-directory policy requires one direct "
                "with tempfile.TemporaryDirectory() context in self_test and no alternate access"
            )
        elif call.args or call.keywords:
            errors.append(f"{relative}: tempfile.TemporaryDirectory must use the platform default base")
    return errors


def visible_markdown(document: str) -> str:
    text = re.sub(r"(?s)<!--.*?(?:-->|\Z)", "", document)
    text = re.sub(
        r"(?is)<template\b[^<>]*>.*?</template\s*>|"
        r"<(?P<tag>[A-Za-z][A-Za-z0-9:-]*)\b(?=[^<>]*\bhidden\b)[^<>]*>"
        r".*?</(?P=tag)\s*>",
        "",
        text,
    )
    lines: list[str] = []
    fence: tuple[str, int] | None = None
    for line in text.splitlines():
        match = re.match(r"^\s*([`~]{3,})(.*)$", line)
        if fence is not None:
            if match and match.group(1)[0] == fence[0] and len(match.group(1)) >= fence[1] and not match.group(2).strip():
                fence = None
            continue
        if match:
            fence = (match.group(1)[0], len(match.group(1)))
            continue
        if line.startswith("    ") or line.startswith("\t"):
            continue
        lines.append(line)
    return "\n".join(lines)


def normalized_markdown(document: str) -> str:
    return re.sub(r"\s+", " ", visible_markdown(document)).strip()


def api_policy_static_errors(root: Path) -> list[str]:
    relative = "tools/check-api-compatibility-policy"
    errors: list[str] = []
    errors.extend(api_policy_fingerprint_contract_errors(root))
    source = read(root, relative, errors)
    try:
        tree = ast.parse(source, filename=relative)
    except SyntaxError as error:
        return errors + [f"{relative}: dual-mode API policy cannot parse ({error})"]
    normalized_ast_hash = hashlib.sha256(portable_ast_dump(tree).encode()).hexdigest()
    if normalized_ast_hash != API_POLICY_AST_HASH:
        errors.append(f"{relative}: dual-mode API policy normalized AST mismatch")
    assignments = {
        target.id: node.value
        for node in tree.body
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        for target in node.targets
        if isinstance(target, ast.Name)
    }
    expected_values = {"VERSION": "0.1.0-SNAPSHOT", "RELEASE": "0.1.0"}
    for name, expected in expected_values.items():
        node = assignments.get(name)
        if not isinstance(node, ast.Constant) or node.value != expected:
            errors.append(f"{relative}: dual-mode API policy {name} must be exactly {expected}")
    expected_modes = ast.parse("(VERSION, RELEASE)", mode="eval").body
    if "MODES" not in assignments or ast.dump(assignments["MODES"], include_attributes=False) != ast.dump(expected_modes, include_attributes=False):
        errors.append(f"{relative}: dual-mode API policy must select only snapshot and exact release modes")
    functions = {
        name: [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == name]
        for name in ("validate", "synthetic_documents", "self_test", "main")
    }
    if any(len(nodes) != 1 for nodes in functions.values()):
        errors.append(f"{relative}: dual-mode API policy function inventory mismatch")
        return errors
    synthetic = functions["synthetic_documents"][0]
    if [argument.arg for argument in synthetic.args.args] != ["mode"]:
        errors.append(f"{relative}: synthetic API policy fixture must require one explicit mode")
    self_calls = {
        ast.dump(node, include_attributes=False)
        for node in ast.walk(functions["self_test"][0])
        if isinstance(node, ast.Call)
    }
    for expression in ("synthetic_documents(VERSION)", "synthetic_documents(RELEASE)"):
        expected = ast.dump(ast.parse(expression, mode="eval").body, include_attributes=False)
        if expected not in self_calls:
            errors.append(f"{relative}: hostile self-test must execute {expression}")
    validate_source = ast.dump(functions["validate"][0], include_attributes=False)
    for required in ("SNAPSHOT_VERSIONING_CLAIMS", "RELEASE_VERSIONING_CLAIMS", "SNAPSHOT_RELEASING_CLAIMS", "RELEASE_RELEASING_CLAIMS", "SNAPSHOT_CHANGELOG_CLAIMS", "RELEASE_CHANGELOG_CLAIMS"):
        if required not in validate_source:
            errors.append(f"{relative}: semantic validation does not preserve {required}")
    imports = {
        (node.module or "", alias.name)
        for node in ast.walk(tree)
        if isinstance(node, ast.ImportFrom)
        for alias in node.names
    } | {
        ("", alias.name)
        for node in ast.walk(tree)
        if isinstance(node, ast.Import)
        for alias in node.names
    }
    expected_imports = {
        ("__future__", "annotations"), ("", "re"), ("", "sys"),
        ("dataclasses", "dataclass"), ("dataclasses", "replace"), ("pathlib", "Path"),
    }
    if imports != expected_imports:
        errors.append(f"{relative}: API policy static import allowlist mismatch")
    return errors


