        errors.append(f"consumer dependency must be exactly {SNAPSHOT_COORDINATE}: {dependencies}")
    for token in (
        'kotlin = "2.3.10"', 'htsp = "0.1.0-SNAPSHOT"',
        f'module = "{GROUP}:htsp"', 'id = "org.jetbrains.kotlin.jvm"',
    ):
        if catalog.count(token) != 1:
            errors.append(f"consumer dependency must be exactly {SNAPSHOT_COORDINATE}: {token}")
    expected_production_dependencies = '''        val expectedProductionDependencies = listOf(
            "api:org.jetbrains.kotlin:kotlin-stdlib:2.3.10",
            "implementation:$htspGroup:$htspModule:$htspVersion",
        )'''
    if build.count(expected_production_dependencies) != 1:
        errors.append("consumer production dependency scope or order mismatch")
    expected_tokens = {
        "exclusiveContent {": 1, 'file("../build/local-maven")': 1,
        'name = "htspCheckoutLocal"': 1, 'includeGroup("at.bernhardberger.tvheadend")': 2,
        'excludeGroup("at.bernhardberger.tvheadend")': 1,
        "RepositoriesMode.FAIL_ON_PROJECT_REPOS": 1, "gradlePluginPortal()": 1,
        "mavenCentral": 2, "toRealPath()": 1,
        'tasks.register("verifyConsumerDependencyGraph")': 1,
        '"at.bernhardberger.tvheadend:htsp:0.1.0-SNAPSHOT"': 1,
        "import org.gradle.api.artifacts.ExternalModuleDependency": 1,
        "import org.gradle.api.artifacts.FileCollectionDependency": 1,
        "import org.gradle.api.artifacts.ProjectDependency": 1,
        "import java.nio.file.Files as NioFiles": 1,
        "import java.nio.file.LinkOption as NioLinkOption": 1,
        'dependsOn("classes")': 1,
        "check(gradle.includedBuilds.isEmpty())": 1,
        "configuration.isCanBeDeclared": 1,
        "is ProjectDependency ->": 2,
        "is FileCollectionDependency ->": 2,
        "productionDependencyDeclarations == expectedProductionDependencies": 1,
        "resolvedExternalComponents == expectedExternalComponents": 1,
        "runtimeClasspath.incoming.artifacts.artifacts": 1,
        "artifact.id.componentIdentifier as? ModuleComponentIdentifier": 2,
        '?: error("The HTSP consumer resolved a local artifact: ${artifact.file}")': 1,
        "runtimeArtifactCoordinates == expectedArtifactCoordinates": 1,
        'extension in setOf("aar", "so", "dll", "dylib")': 1,
        '.dir("../build/local-maven")': 1,
        "val versionDirectory = expectedVersionDirectory.canonicalFile": 1,
        "check(versionDirectory == expectedVersionDirectory)": 1,
        'val metadata = versionDirectory.resolve("maven-metadata.xml")': 1,
        "primarySuffixes == expectedPrimarySuffixes": 1,
        'file.name.replace(snapshotStem, "") == ".jar"': 1,
        "NioFiles.isSymbolicLink(": 1,
        "NioFiles.isRegularFile(": 2,
        "NioLinkOption.NOFOLLOW_LINKS": 2,
        "stagedMainJar.toPath()": 1,
        "file.name !in allowedFiles": 1,
        "check(htspArtifacts.size == 1)": 1,
        "htspArtifact.toPath()": 1,
        "htspArtifact.readBytes().contentEquals(stagedMainJar.readBytes())": 1,
    }
    combined = build + "\n" + settings
    for token, count in expected_tokens.items():
        if combined.count(token) != count:
            errors.append(f"consumer isolation policy missing or duplicated: {token}")
    for token in (
        "mavenLocal", "includeBuild", "project(", "files(", "fileTree(", "flatDir",
        "dependencySubstitution", "maven-publish", "signing", "credentials", "http://", "https://",
    ):
        if token in combined:
            errors.append(f"consumer repository or dependency bypass is forbidden: {token}")
    local_notation = re.compile(
        r"(?m)^\s*(?:api|implementation|compileOnly|runtimeOnly)\s*"
        r"\(\s*(?:file|files|fileTree|project)\s*\(",
    )
    if local_notation.search(build):
        errors.append("consumer repository or dependency bypass is forbidden: local dependency notation")
    return errors


def package_errors(root: Path) -> list[str]:
    errors: list[str] = []
    packages: set[str] = set()
    for source in sorted((root / "src/main/kotlin").rglob("*.kt")):
        text = read(root, source.relative_to(root).as_posix(), errors)
        match = re.search(r"(?m)^package\s+([A-Za-z0-9_.]+)\s*$", text)
        if match:
            packages.add(match.group(1))
    if packages != PACKAGES:
        errors.append(f"production package set mismatch: {sorted(packages)}")
    return errors


def governance_errors(root: Path) -> list[str]:
    errors: list[str] = []
    readme = read(root, "README.md", errors)
    index = read(root, "docs/README.md", errors)
    releasing = read(root, "docs/releasing.md", errors)
    agents = read(root, "AGENTS.md", errors)
    key_policy = read(root, "release/openpgp/README.md", errors)
    for token in ("independently maintained GPLv3", "Preclikos/tvhstream", "not official TVHeadend software", "not affiliated"):
        if token not in readme:
            errors.append(f"README governance mismatch: {token}")
    for token in ("[`releasing.md`](releasing.md)", "[`CHANGELOG.md`](../CHANGELOG.md)", "[`../release/openpgp/README.md`](../release/openpgp/README.md)"):
        if index.count(token) != 1:
            errors.append(f"documentation index governance mismatch: {token}")
    combined = "\n".join((index, releasing, agents, key_policy))
    for token in (
        "MAVEN_GPG_PRIVATE_KEY", "MAVEN_GPG_PASSPHRASE", "CENTRAL_PORTAL_TOKEN",
        "EAB02E488E7B944EAA6D65814BF0412FD2A3B741", "GitHub Actions",
        "exact tag", "publication has not occurred",
    ):
        if token.casefold() not in combined.casefold():
            errors.append(f"release trust documentation mismatch: {token}")
    for stale in (
        "check-release-candidate", "sign-central-bundle", "candidate TAR", "evidence TAR",
        "isolated signing host", "Central Portal UI", "Publish or Drop",
    ):
        if stale.casefold() in combined.casefold():
            errors.append(f"superseded release documentation remains: {stale}")
    for relative, expected in (
        ("docs/extraction/source-to-filtered.tsv", MAP_HASH),
        ("docs/extraction/manifest.json", MANIFEST_HASH),
    ):
        path = root / relative
        if not path.is_file() or path.is_symlink() or sha256_file(path) != expected:
            errors.append(f"extraction provenance digest mismatch: {relative}")
    return errors


def workflow_errors(root: Path) -> list[str]:
    errors: list[str] = []
    ci = read(root, ".github/workflows/ci.yml", errors)
    release = read(root, ".github/workflows/release.yml", errors)
    verify = read(root, "tools/verify-htsp", errors)
    if ci.count(f"actions/checkout@{CHECKOUT_SHA}") != 1 or ci.count(f"actions/setup-java@{JAVA_SHA}") != 1:
        errors.append("normal CI action pins differ from the approved full SHAs")
    for token in (
        "branches: [main]", "pull_request:", "contents: read", "runs-on: ubuntu-24.04",
        "persist-credentials: false", "./tools/check-standalone-repository --wrapper-only",
        "./tools/verify-htsp",
    ):
        if ci.count(token) != 1:
            errors.append(f"normal CI policy missing or duplicated: {token}")
    if "secrets." in ci or "publish-central-release" in ci or "upload-artifact" in ci:
        errors.append("normal CI contains release-only behavior")
    if not release or release.count("tools/publish-central-release --publish") != 1:
        errors.append("tag release workflow is missing its single Central publish call")
    if release.count("tools/publish-central-release --finalize-github-release") != 1:
        errors.append("tag release workflow is missing its single GitHub finalizer call")
    if "gh release create" in release or "build/release/github-assets/*" in release or "build/release/htsp-*" in release:
        errors.append("tag release workflow retains non-idempotent GitHub CLI wildcard publication")
    publish_position = release.find("tools/publish-central-release --publish")
    finalizer_position = release.find("tools/publish-central-release --finalize-github-release")
    if min(publish_position, finalizer_position) < 0 or publish_position >= finalizer_position:
        errors.append("GitHub finalizer must run only after Central publish and resolution")
    job_guard_tokens = (
        "if: >-",
        "github.repository == 'bernhardberger/tvheadend-htsp'",
        "github.ref_type == 'tag'",
        "startsWith(github.ref, 'refs/tags/v')",
    )
    if any(release.count(token) != 1 for token in job_guard_tokens):
        errors.append("release job repository and v-tag guard is missing or duplicated")
    bytecode = "export PYTHONDONTWRITEBYTECODE=1"
    first_command = min(position for position in (verify.find("./tools/"), verify.find("python3 "), verify.find("./gradlew ")) if position >= 0)
    if verify.count(bytecode) != 1 or verify.find(bytecode) > first_command:
        errors.append("verifier must suppress Python bytecode before checker execution")
    required_order = (
        "./tools/check-standalone-repository --self-test",
        "./tools/check-standalone-repository",
        "./tools/publish-central-release --self-test",
        "./tools/publish-central-release --check-setup",
        "./tools/check-api-compatibility-policy --self-test",
        "./tools/check-api-compatibility-policy",
        "./tools/check-published-jvm-compatibility --self-test",
        'if [ "${1-}" = "--non-gradle" ]; then',
        "./gradlew --no-daemon clean build test check checkLegacyAbi verifyClassMajor61 verifyProductionDependencyGraph stageLocalPublication",
        "\n./tools/check-published-jvm-compatibility\n",
        "./gradlew --no-daemon --refresh-dependencies -p consumer-contract clean compileKotlin verifyConsumerDependencyGraph",
    )
    positions = [verify.find(token) for token in required_order]
    if any(position < 0 for position in positions) or positions != sorted(positions):
        errors.append("verifier check, single stage, publication verification, and consumer ordering mismatch")
    for obsolete in ("--write-manifest", "publication-first.json", "rm -rf build/local-maven", "--compare-manifest"):
        if obsolete in verify:
            errors.append(f"verifier retains obsolete publication restaging machinery: {obsolete}")
    if verify.count("stageLocalPublication") != 1:
        errors.append("verifier must stage the publication exactly once")
    if verify.count("\n./tools/check-published-jvm-compatibility\n") != 1:
        errors.append("verifier must run production publication verification exactly once")
    if verify.count("./gradlew ") != 2 or verify.count("--no-daemon") != 2:
        errors.append("every and only the two verifier Gradle calls must use --no-daemon")
    for stale in ("check-release-candidate", "sign-central-bundle", "candidate.tar", "evidence.tar"):
        if stale in verify or stale in ci or stale in release:
            errors.append(f"superseded release path remains active: {stale}")
    return errors


def release_topology_errors(root: Path) -> list[str]:
    errors: list[str] = []
    for relative in (".github/workflows/release.yml", "tools/publish-central-release"):
        path = root / relative
        if not path.is_file() or path.is_symlink():
            errors.append(f"required automatic release path is missing: {relative}")
    for relative in ("tools/check-release-candidate", "tools/sign-central-bundle"):
        if (root / relative).exists() or (root / relative).is_symlink():
            errors.append(f"superseded release path is forbidden: {relative}")
    return errors


def repository_errors(root: Path) -> list[str]:
    errors = topology_errors(root)
    errors.extend(immutable_errors(root))
    errors.extend(wrapper_errors(root))
    errors.extend(build_errors(root))
    errors.extend(consumer_errors(root))
    errors.extend(package_errors(root))
    errors.extend(quick_start_errors(root))
    errors.extend(governance_errors(root))
    errors.extend(workflow_errors(root))
    errors.extend(release_topology_errors(root))
    return sorted(set(errors))


def append(root: Path, relative: str, text: str) -> None:
    path = root / relative
    path.write_text(path.read_text(encoding="utf-8") + text, encoding="utf-8")


def replace_once(root: Path, relative: str, old: str, new: str) -> None:
    path = root / relative
    text = path.read_text(encoding="utf-8")
    if old not in text:
        raise AssertionError(f"self-test fixture lacks {old!r} in {relative}")
    path.write_text(text.replace(old, new, 1), encoding="utf-8")


def copy_fixture(source: Path, target: Path) -> None:
    shutil.copytree(source, target, symlinks=True, ignore=shutil.ignore_patterns(".git", "build"))
    (target / ".git").mkdir()


def self_test() -> list[str]:
    errors: list[str] = []
    baseline = repository_errors(ROOT)
    if baseline:
        return ["clean repository fixture failed: " + "; ".join(baseline)]
    production = "src/main/kotlin/at/bernhardberger/tvheadend/htsp/connection/HtspConnection.kt"
    test = next(path.relative_to(ROOT).as_posix() for path in sorted((ROOT / "src/test/kotlin").rglob("*.kt")))
    golden = next(path.relative_to(ROOT).as_posix() for path in sorted((ROOT / "src/test/resources").rglob("*.hex")))
    mutations: list[tuple[str, str, Callable[[Path], None]]] = [
        ("unsupported root version", "root build version", lambda root: replace_once(root, "build.gradle.kts", 'version = "0.1.0"', 'version = "1.0.0"')),
        ("extra production dependency", "exactly one declared production dependency", lambda root: append(root, "build.gradle.kts", '\nimplementation("example:bad:1")\n')),
        ("remote publication", "forbidden remote", lambda root: append(root, "build.gradle.kts", '\nval remote = "sonatype"\n')),
        ("signing configuration", "forbidden remote", lambda root: append(root, "build.gradle.kts", "\nsigning {}\n")),
        ("consumer coordinate", "consumer dependency", lambda root: replace_once(root, "consumer-contract/gradle/libs.versions.toml", 'htsp = "0.1.0-SNAPSHOT"', 'htsp = "1.0.0"')),
        ("consumer local dependency", "consumer repository or dependency bypass", lambda root: append(root, "consumer-contract/build.gradle.kts", '\nimplementation(files("../bad.jar"))\n')),
        ("README coordinate", "README dependency differs", lambda root: replace_once(root, "README.md", f'implementation("{GROUP}:htsp:0.1.0")', 'implementation("example:wrong:1")')),
        ("production drift", "immutable production drift", lambda root: append(root, production, "\n")),
        ("test drift", "immutable tests drift", lambda root: append(root, test, "\n")),
        ("golden drift", "immutable golden drift", lambda root: append(root, golden, "\n")),
        ("API drift", "immutable api drift", lambda root: append(root, "api/htsp.api", "\n")),
        ("protocol drift", "immutable protocol evidence drift", lambda root: append(root, "docs/htsp-protocol/htsp_spec.json", "\n")),
        ("generated drift", "immutable generated drift", lambda root: append(root, "src/main/kotlin/at/bernhardberger/tvheadend/htsp/requests/GeneratedHtspRequests.kt", "\n")),
        ("generator drift", "immutable generators drift", lambda root: append(root, "docs/htsp-protocol/generate_typed_requests.py", "\n")),
        ("license drift", "immutable license", lambda root: append(root, "LICENSE", "\n")),
        ("wrapper drift", "wrapper hash", lambda root: append(root, "gradlew", "\n")),
        ("CI secret", "normal CI contains release-only behavior", lambda root: append(root, ".github/workflows/ci.yml", "\n# secrets.BAD\n")),
        ("old release tool", "superseded release path", lambda root: (root / "tools/check-release-candidate").write_text("old\n", encoding="utf-8")),
        ("missing release workflow", "required automatic release path", lambda root: (root / ".github/workflows/release.yml").unlink()),
        ("missing release setup call", "verifier check", lambda root: replace_once(root, "tools/verify-htsp", "./tools/publish-central-release --check-setup\n", "")),
        ("missing release job guard", "release job repository and v-tag guard", lambda root: replace_once(root, ".github/workflows/release.yml", "      github.repository == 'bernhardberger/tvheadend-htsp' &&\n", "")),
        ("missing GitHub finalizer", "GitHub finalizer", lambda root: replace_once(root, ".github/workflows/release.yml", "./tools/publish-central-release --finalize-github-release", "true")),
        ("one-shot GitHub CLI release", "GitHub CLI wildcard", lambda root: append(root, ".github/workflows/release.yml", "\n# gh release create build/release/github-assets/*\n")),
        ("GitHub finalizer before Central", "only after Central", lambda root: (
            replace_once(root, ".github/workflows/release.yml", "./tools/publish-central-release --publish", "true"),
            append(root, ".github/workflows/release.yml", "\n# tools/publish-central-release --publish\n"),
        )),
        ("duplicate publication stage", "stage the publication exactly once", lambda root: append(root, "tools/verify-htsp", "\n./gradlew --no-daemon stageLocalPublication\n")),
        ("duplicate publication verification", "publication verification exactly once", lambda root: append(root, "tools/verify-htsp", "\n./tools/check-published-jvm-compatibility\n")),
        ("legacy publication manifest", "obsolete publication restaging machinery", lambda root: append(root, "tools/verify-htsp", "\n# --write-manifest publication-first.json\n")),
        ("release tool mode", "executable mode", lambda root: (root / "tools/publish-central-release").chmod(0o644)),
        ("Python cache", "Python cache", lambda root: ((root / "tools/__pycache__").mkdir(), (root / "tools/__pycache__/bad.pyc").write_bytes(b"cache"))),
    ]
    with tempfile.TemporaryDirectory() as temporary:
        temporary_root = Path(temporary)
        for index, (name, expected, mutate) in enumerate(mutations):
            case = temporary_root / f"case-{index}"
            copy_fixture(ROOT, case)
            mutate(case)
            actual = repository_errors(case)
            if not any(expected in error for error in actual):
                errors.append(f"self-test accepted {name} without {expected!r}: {actual}")
        case = temporary_root / "case-symlink"
        copy_fixture(ROOT, case)
        target = case / "README.md"
        target.unlink()
        target.symlink_to("/etc/passwd")
        actual = repository_errors(case)
        if not any("symlink/escape" in error or "expected regular file" in error for error in actual):
            errors.append(f"self-test accepted repository symlink: {actual}")
    return errors


def release_setup_call() -> list[str]:
    environment = {name: os.environ[name] for name in ("PATH", "HOME", "TMPDIR") if name in os.environ}
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    result = subprocess.run(
        (str(ROOT / "tools/publish-central-release"), "--check-setup"),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        env=environment,
    )
    if result.returncode == 0:
        return []
    return ["automatic release setup call-through failed"]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--wrapper-only", action="store_true")
    arguments = parser.parse_args()
    if arguments.self_test and arguments.wrapper_only:
        parser.error("--self-test and --wrapper-only are mutually exclusive")
    if arguments.wrapper_only:
        errors = wrapper_errors(ROOT)
        success = "Standalone wrapper policy passed"
    elif arguments.self_test:
        errors = self_test()
        success = "Standalone repository focused self-tests passed"
    else:
        errors = repository_errors(ROOT)
        if not errors:
            errors.extend(release_setup_call())
        success = "Standalone repository policy passed"
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(success)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
