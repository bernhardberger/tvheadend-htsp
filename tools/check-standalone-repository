    fixture_build = read(root / "consumer-contract/build.gradle.kts", errors)
    dependency_lines = re.findall(
        r'^\s*(?:api|implementation|compileOnly|runtimeOnly)\("([^"]+)"\)\s*$',
        fixture_build,
        flags=re.M,
    )
    if dependency_lines != [COORDINATE]:
        errors.append(f"consumer fixture dependency must be exactly {COORDINATE}")
    fixture_required_counts = {
        'kotlin("jvm") version "2.3.10"': 1,
        "jvmToolchain(21)": 1,
