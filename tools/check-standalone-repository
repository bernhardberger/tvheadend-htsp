def package_errors(root: Path) -> list[str]:
    errors: list[str] = []
    packages: set[str] = set()
    for source in sorted((root / "src/main/kotlin").rglob("*.kt")):
        text = read(root, source.relative_to(root).as_posix(), errors)
        match = re.search(r"(?m)^package\s+([A-Za-z0-9_.]+)\s*$", text)
        if match:
            packages.add(match.group(1))
    if packages != PACKAGES:
        errors.append(f"production package set mismatch: {sorted(packages)}")
    return errors


def portable_temp_errors(root: Path) -> list[str]:
    errors: list[str] = []
    for relative in TEMP_CHECKERS:
        text = read(root, relative, errors)
        try:
            tree = ast.parse(text, filename=relative)
        except SyntaxError as error:
            errors.append(f"{relative}: cannot inspect temporary-directory policy ({error})")
            continue
        parents = {
            child: parent
            for parent in ast.walk(tree)
            for child in ast.iter_child_nodes(parent)
        }
        tempfile_imports = [
            (node, alias)
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.name == "tempfile" or alias.name.startswith("tempfile.")
        ]
        canonical_import = (
            len(tempfile_imports) == 1
            and tempfile_imports[0][1].name == "tempfile"
            and tempfile_imports[0][1].asname is None
            and len(tempfile_imports[0][0].names) == 1
        )
        imported_factories = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom)
            and (node.module == "tempfile" or (node.module or "").startswith("tempfile."))
        ]
        alternate_tempfile_import_bindings = [
            alias
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.asname == "tempfile"
        ] + [
            alias
            for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom)
            for alias in node.names
            if (alias.asname or alias.name) == "tempfile"
        ]
        tempfile_rebindings = [
            node for node in ast.walk(tree)
            if (
                isinstance(node, ast.Name)
                and not isinstance(node.ctx, ast.Load)
                and node.id == "tempfile"
            ) or (
                isinstance(node, ast.arg) and node.arg == "tempfile"
            ) or (
                isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
                and node.name == "tempfile"
            ) or (
                isinstance(node, ast.ExceptHandler) and node.name == "tempfile"
            )
        ]
        loaded_modules = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Name)
            and isinstance(node.ctx, ast.Load)
            and node.id == "tempfile"
        ]
        attributes = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Attribute)
            and isinstance(node.ctx, ast.Load)
            and node.attr == "TemporaryDirectory"
        ]
        bare_factories = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Name)
            and isinstance(node.ctx, ast.Load)
            and node.id == "TemporaryDirectory"
        ]
        forbidden_builtin_calls = [
            node for node in ast.walk(tree)
            if isinstance(node, ast.Call)
            and isinstance(node.func, ast.Name)
            and node.func.id in {"getattr", "setattr", "__import__"}
        ]
        importlib_bindings = {
            alias.asname or "importlib"
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.name == "importlib"
        }
        imported_import_module_bindings = {
            alias.asname or alias.name
            for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom) and node.module == "importlib"
            for alias in node.names
            if alias.name == "import_module"
        }
        dynamic_imports = [
            node for node in ast.walk(tree)
            if (
                isinstance(node, ast.Attribute)
                and isinstance(node.ctx, ast.Load)
                and node.attr == "import_module"
                and isinstance(node.value, ast.Name)
                and node.value.id in importlib_bindings
            ) or (
                isinstance(node, ast.Name)
                and isinstance(node.ctx, ast.Load)
                and node.id in imported_import_module_bindings
            )
        ]
        sys_bindings = {
            alias.asname or "sys"
            for node in ast.walk(tree)
            if isinstance(node, ast.Import)
            for alias in node.names
            if alias.name == "sys"
        }
        imported_sys_modules_bindings = {
            alias.asname or alias.name
            for node in ast.walk(tree)
            if isinstance(node, ast.ImportFrom) and node.module == "sys"
            for alias in node.names
            if alias.name == "modules"
        }
        module_lookups = [
            node for node in ast.walk(tree)
            if (
                isinstance(node, ast.Attribute)
                and isinstance(node.ctx, ast.Load)
                and node.attr == "modules"
                and isinstance(node.value, ast.Name)
                and node.value.id in sys_bindings
            ) or (
                isinstance(node, ast.Name)
                and isinstance(node.ctx, ast.Load)
                and node.id in imported_sys_modules_bindings
            )
        ]
        functions = [
            node for node in ast.walk(tree)
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == "self_test"
        ]
        call = parents.get(attributes[0]) if len(attributes) == 1 else None
        item = parents.get(call) if isinstance(call, ast.Call) else None
        statement = parents.get(item) if isinstance(item, ast.withitem) else None
        anchored = (
            canonical_import
            and len(loaded_modules) == 1
            and len(attributes) == 1
            and attributes[0].value is loaded_modules[0]
            and isinstance(call, ast.Call)
            and call.func is attributes[0]
            and isinstance(item, ast.withitem)
            and item.context_expr is call
            and isinstance(statement, ast.With)
            and len(statement.items) == 1
            and len(functions) == 1
            and parents.get(statement) is functions[0]
            and not bare_factories
            and not imported_factories
            and not alternate_tempfile_import_bindings
            and not tempfile_rebindings
            and not forbidden_builtin_calls
            and not dynamic_imports
            and not module_lookups
        )
        if not anchored:
            errors.append(
                f"{relative}: temporary-directory policy requires one direct "
                "with tempfile.TemporaryDirectory() context in self_test and no alternate access"
            )
        elif call.args or call.keywords:
            errors.append(f"{relative}: tempfile.TemporaryDirectory must use the platform default base")
    return errors


def governance_errors(root: Path) -> list[str]:
    errors: list[str] = []
    readme = read(root, "README.md", errors)
    index = read(root, "docs/README.md", errors)
    versioning = read(root, "docs/versioning.md", errors)
    releasing = read(root, "docs/releasing.md", errors)
    changelog = read(root, "CHANGELOG.md", errors)
    for value in (
        "independently maintained GPLv3", "Preclikos/tvhstream",
        "not official TVHeadend software", "not affiliated",
        "mutable, local-only snapshot", "not available\nfrom Maven Central",
    ):
        if value not in readme:
            errors.append(f"README governance mismatch: {value}")
    for value in ("[`releasing.md`](releasing.md)", "[`CHANGELOG.md`](../CHANGELOG.md)"):
        if index.count(value) != 1:
            errors.append(f"documentation index governance mismatch: {value}")
    for document, label, values in (
        (versioning, "versioning", (COORDINATE, "published release bytes must never be replaced", "next minor version, not a patch version", "No source, binary, or behavioral compatibility is promised")),
        (releasing, "releasing", ("planned first release", "It has not been released", "initial provisional baseline", "do not promise compatibility or support", "separate owner authorization")),
        (changelog, "changelog", ("## [Unreleased]", "not a release, publication, compatibility baseline, or support promise", "initial provisional baseline")),
    ):
        normalized_document = re.sub(r"\s+", " ", document)
        for value in values:
            if value not in normalized_document:
                errors.append(f"{label} governance mismatch: {value}")
    for relative, expected in (("docs/extraction/source-to-filtered.tsv", MAP_HASH), ("docs/extraction/manifest.json", MANIFEST_HASH)):
        path = root / relative
        if not path.is_file() or path.is_symlink() or sha256(path) != expected:
            errors.append(f"extraction provenance digest mismatch: {relative}")
    return errors


def ci_verify_errors(root: Path) -> list[str]:
    errors: list[str] = []
    ci = read(root, ".github/workflows/ci.yml", errors)
    verify = read(root, "tools/verify-htsp", errors)
    for value in (
        "runs-on: ubuntu-24.04", f"actions/checkout@{CHECKOUT_SHA}",
        "persist-credentials: false", f"actions/setup-java@{JAVA_SHA}",
        "distribution: temurin", "java-version: '21'", "permissions:\n  contents: read",
        "run: ./tools/check-standalone-repository --wrapper-only", "run: ./tools/verify-htsp",
    ):
        if ci.count(value) != 1:
            errors.append(f"CI exact policy mismatch: {value}")
    uses = re.findall(r"^\s*uses:\s*(\S+)\s*$", ci, re.M)
    if uses != [f"actions/checkout@{CHECKOUT_SHA}", f"actions/setup-java@{JAVA_SHA}"]:
        errors.append(f"CI action inventory mismatch: {uses}")
    runs = re.findall(r"^\s*run:\s*(.+?)\s*$", ci, re.M)
    if runs != ["./tools/check-standalone-repository --wrapper-only", "./tools/verify-htsp"]:
        errors.append(f"CI command inventory mismatch: {runs}")
    required_order = [
        "./tools/check-standalone-repository --self-test",
        "./tools/check-standalone-repository",
        "./tools/check-api-compatibility-policy --self-test",
        "./tools/check-api-compatibility-policy",
        "./tools/check-published-jvm-compatibility --self-test",
        "if [ \"${1-}\" = \"--non-gradle\" ]; then",
        "./gradlew --no-daemon clean build test check checkLegacyAbi verifyClassMajor61 verifyProductionDependencyGraph stageLocalPublication",
        "./tools/check-published-jvm-compatibility --write-manifest build/publication-first.json",
        "rm -rf build/local-maven",
        "./gradlew --no-daemon stageLocalPublication",
        "./tools/check-published-jvm-compatibility --compare-manifest build/publication-first.json",
        "./gradlew --no-daemon --refresh-dependencies -p consumer-contract clean compileKotlin verifyConsumerDependencyGraph",
    ]
    positions = [verify.find(value) for value in required_order]
    if any(position < 0 for position in positions) or positions != sorted(positions):
        errors.append("verifier P3-E2 stage/inspect/recreate/compare/consumer ordering mismatch")
    if verify.count("./tools/check-api-compatibility-policy") != 2 or verify.count("./tools/check-published-jvm-compatibility") != 4:
        errors.append("verifier P3-E2 checker activation count mismatch")
    if verify.count("./gradlew ") != 3 or verify.count("--no-daemon") != 3:
        errors.append("every and only the three verifier Gradle calls must use --no-daemon")
    non_gradle = verify.find('if [ "${1-}" = "--non-gradle" ]; then')
    first_gradle = verify.find("./gradlew ")
    if non_gradle < 0 or first_gradle < non_gradle:
        errors.append("--non-gradle must exit before staging, artifact inspection, and consumer compilation")
    for token in ("credentials {", "signing", "gh ", "git push", "publishToMavenLocal"):
        if token in ci or token in verify:
            errors.append(f"CI/verifier forbidden outbound/signing/credential operation: {token}")
    return errors


def repository_errors(root: Path) -> list[str]:
    errors = topology_errors(root)
    errors.extend(immutable_errors(root))
    errors.extend(wrapper_errors(root))
    errors.extend(build_errors(root))
    errors.extend(consumer_errors(root))
    errors.extend(package_errors(root))
    errors.extend(portable_temp_errors(root))
    errors.extend(quick_start_errors(root))
    errors.extend(governance_errors(root))
    errors.extend(ci_verify_errors(root))
    return sorted(set(errors))


def append(root: Path, relative: str, text: str) -> None:
    path = root / relative
    path.write_text(path.read_text(encoding="utf-8") + text, encoding="utf-8")


def replace_once(root: Path, relative: str, old: str, new: str) -> None:
    path = root / relative
    text = path.read_text(encoding="utf-8")
    if old not in text:
        raise AssertionError(f"self-test cannot mutate {relative}: {old!r}")
    path.write_text(text.replace(old, new, 1), encoding="utf-8")


def insert_before_dependency_contract(root: Path, text: str) -> None:
    replace_once(
        root,
        "build.gradle.kts",
        "\n" + DEPENDENCY_TASK_CONTRACT + "\n",
        "\n" + text.rstrip() + "\n\n" + DEPENDENCY_TASK_CONTRACT + "\n",
    )


def replace_temp_context(root: Path, relative: str, replacement: str) -> None:
    target = "with tempfile." + "TemporaryDirectory() as temporary:"
    replace_once(root, relative, target, replacement)


def append_temp_noncode(root: Path, relative: str) -> None:
    append(
        root,
