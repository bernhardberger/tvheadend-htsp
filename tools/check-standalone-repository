def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read(path: Path, errors: list[str]) -> str:
    try:
        if path.is_symlink() or not path.is_file():
            raise OSError("not a regular file")
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        errors.append(f"{path}: required UTF-8 file is unavailable ({error})")
        return ""


def category_files(root: Path) -> dict[str, list[Path]]:
    return {
        "production": sorted((root / "src/main/kotlin").rglob("*.kt")),
        "tests": sorted((root / "src/test/kotlin").rglob("*.kt")),
        "golden": sorted((root / "src/test/resources").rglob("*.hex")),
        "api": [root / "api/htsp.api"],
        "protocol evidence": sorted(
            path for path in (root / "docs/htsp-protocol").iterdir()
            if path.name != "README.md"
        ) if (root / "docs/htsp-protocol").is_dir() else [],
        "generated": sorted((root / "src/main/kotlin").rglob("Generated*.kt")),
    }


def category_digest(root: Path, paths: list[Path]) -> str:
    manifest = "".join(
        f"{sha256(path)}  {path.relative_to(root).as_posix()}\n" for path in paths
    )
    return hashlib.sha256(manifest.encode()).hexdigest()


def topology_errors(root: Path) -> list[str]:
    errors: list[str] = []
    try:
        mode = root.lstat().st_mode
    except OSError as error:
        return [f"repository topology is unavailable: {error}"]
    if stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
        return ["repository root must be a real directory"]
    actual_root = {entry.name for entry in os.scandir(root)}
    if actual_root != ROOT_ENTRIES:
        errors.append(
            f"root topology mismatch; missing={sorted(ROOT_ENTRIES - actual_root)}, "
            f"extra={sorted(actual_root - ROOT_ENTRIES)}"
        )

    files: set[str] = set()
    for directory, names, names_files in os.walk(root, followlinks=False):
        current = Path(directory)
        relative_directory = current.relative_to(root)
        if relative_directory == Path(".git"):
            names[:] = []
            continue
        names[:] = sorted(name for name in names if name != "__pycache__" and not (
            relative_directory == Path(".") and name == ".git"
        ))
        if relative_directory != Path(".") and not names and not names_files:
            errors.append(f"{relative_directory.as_posix()}: empty directory is not allowed")
        for name in [*names, *(name for name in names_files if not name.endswith(".pyc"))]:
            path = current / name
            relative = path.relative_to(root).as_posix()
            try:
                entry_mode = path.lstat().st_mode
            except OSError:
                errors.append(f"{relative}: topology entry cannot be inspected")
                continue
            if stat.S_ISLNK(entry_mode):
                errors.append(f"{relative}: topology must not contain symlinks or escapes")
                if name in names:
                    names.remove(name)
            elif name in names and not stat.S_ISDIR(entry_mode):
                errors.append(f"{relative}: topology directory must be real")
            elif name in names_files and not stat.S_ISREG(entry_mode):
                errors.append(f"{relative}: topology file must be regular")
            elif name in names_files:
                files.add(relative)

    fixed = {
        ".gitattributes", ".gitignore", "AGENTS.md", "CONTRIBUTING.md", "LICENSE",
        "NOTICE.md", "README.md", "build.gradle.kts", "gradlew", "gradlew.bat",
        "settings.gradle.kts", ".github/workflows/ci.yml", "api/htsp.api",
        "gradle/wrapper/gradle-wrapper.jar", "gradle/wrapper/gradle-wrapper.properties",
        *DOC_FILES, *TOOL_FILES, *FIXTURE_FILES,
    }
    dynamic = {
        path for path in files if (
            (path.startswith("src/main/kotlin/") and path.endswith(".kt"))
            or (path.startswith("src/test/kotlin/") and path.endswith(".kt"))
            or (path.startswith("src/test/resources/") and path.endswith(".hex"))
        )
    }
    if files != fixed | dynamic:
        errors.append(
            f"file topology mismatch; missing={sorted((fixed | dynamic) - files)}, "
            f"extra={sorted(files - fixed - dynamic)}"
        )
    for executable in {"gradlew", *TOOL_FILES}:
        path = root / executable
        try:
            if path.stat().st_mode & 0o111 == 0:
                errors.append(f"{executable}: required executable mode is missing")
        except OSError:
            pass
    return errors


def immutable_errors(root: Path) -> list[str]:
    errors: list[str] = []
    for label, paths in category_files(root).items():
        expected_count, expected_digest = IMMUTABLE[label]
        regular = [path for path in paths if path.is_file() and not path.is_symlink()]
        actual_digest = category_digest(root, regular)
        if len(regular) != expected_count or actual_digest != expected_digest:
            errors.append(
                f"immutable {label} drift: count={len(regular)}/{expected_count}, "
                f"digest={actual_digest}/{expected_digest}"
            )
    return errors


