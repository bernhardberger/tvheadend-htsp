def ci_and_verify_errors(root: Path) -> list[str]:
    errors: list[str] = []
    ci = read(root / ".github/workflows/ci.yml", errors)
    verify = read(root / "tools/verify-htsp", errors)
    required_ci = (
        "runs-on: ubuntu-24.04", f"actions/checkout@{CHECKOUT_SHA}",
        "persist-credentials: false", f"actions/setup-java@{JAVA_SHA}",
        "distribution: temurin", "java-version: '21'", "permissions:\n  contents: read",
        "run: ./tools/check-standalone-repository --wrapper-only",
        "run: ./tools/verify-htsp",
    )
    for value in required_ci:
        if ci.count(value) != 1:
            errors.append(f"CI exact policy mismatch: {value}")
    trigger_and_permissions = (
        "on:\n  push:\n    branches: [main]\n  pull_request:\n\n"
        "permissions:\n  contents: read\n"
    )
    if ci.count(trigger_and_permissions) != 1 or ci.count("permissions:") != 1:
        errors.append("CI triggers/permissions must be exactly main push, pull request, and contents read")
    uses = re.findall(r"^\s*uses:\s*(\S+)\s*$", ci, flags=re.M)
    if uses != [f"actions/checkout@{CHECKOUT_SHA}", f"actions/setup-java@{JAVA_SHA}"]:
        errors.append(f"CI action set/order mismatch: {uses}")
    runs = re.findall(r"^\s*run:\s*(.+?)\s*$", ci, flags=re.M)
    expected_runs = [
        "./tools/check-standalone-repository --wrapper-only",
        "./tools/verify-htsp",
    ]
    if runs != expected_runs:
        errors.append(f"CI command set/order mismatch: {runs}")
    if ci.find("--wrapper-only") > ci.find("run: ./tools/verify-htsp"):
        errors.append("CI must verify wrapper provenance before default verification")
    if "run: ./tools/verify-htsp --non-gradle" in ci:
        errors.append("CI bypasses default Gradle verification")
    gradle_command = (
        "./gradlew --no-daemon clean test check checkLegacyAbi "
        "verifyClassMajor61 verifyProductionDependencyGraph"
    )
    if verify.count(gradle_command) != 1:
        errors.append("default verifier Gradle 9 task contract mismatch")
    expected_verify_commands = [
        "./tools/check-standalone-repository --self-test",
        "./tools/check-standalone-repository",
        "./tools/check-htsp-protocol-boundary --self-test",
        "./tools/check-htsp-protocol-boundary",
        "./tools/check-htsp-generated-drift --self-test",
        "./tools/check-htsp-generated-drift",
        "./tools/check-htsp-public-kdoc --self-test",
        "./tools/check-htsp-public-kdoc",
        "./tools/check-htsp-json-api-containment --self-test",
        "./tools/check-htsp-json-api-containment",
        "./tools/check-single-package-per-module --self-test",
        "./tools/check-single-package-per-module",
        "./tools/check-public-api-outcomes --self-test",
        "./tools/check-public-api-outcomes",
        "./tools/check-license-attribution --self-test",
        "./tools/check-license-attribution",
        "python3 docs/htsp-protocol/report.py --check",
        "python3 docs/htsp-protocol/generate_typed_requests.py --self-test",
        "python3 docs/htsp-protocol/generate_typed_request_models.py --self-test",
        "python3 docs/htsp-protocol/generate_typed_server_messages.py --self-test",
        "python3 docs/htsp-protocol/generate_typed_server_message_models.py --self-test",
        gradle_command,
    ]
    actual_verify_commands = [
        line.strip()
        for line in verify.splitlines()
        if line.startswith(("./tools/", "python3 docs/", "./gradlew "))
    ]
    if actual_verify_commands != expected_verify_commands:
        errors.append("verifier static/Gradle command set or order mismatch")
    if verify.count('if [ "${1-}" = "--non-gradle" ]; then') != 1:
        errors.append("verifier must gate Gradle only after the --non-gradle exit")
    forbidden = ("consumer-contract", "maven-publish", "publish", "signing", "local-maven")
    for token in forbidden:
        if token in verify or token in ci:
            errors.append(f"CI/default verifier contains forbidden consumer/publication path: {token}")
    return errors


def repository_errors(root: Path) -> list[str]:
    errors = topology_errors(root)
    errors.extend(immutable_errors(root))
    errors.extend(wrapper_errors(root))
    errors.extend(build_errors(root))
    errors.extend(package_and_outcome_errors(root))
    errors.extend(quick_start_errors(root))
    errors.extend(governance_errors(root))
    errors.extend(ci_and_verify_errors(root))
    return sorted(set(errors))


def append(root: Path, relative: str, text: str) -> None:
    path = root / relative
    path.write_text(path.read_text(encoding="utf-8") + text, encoding="utf-8")


def replace(root: Path, relative: str, old: str, new: str) -> None:
    path = root / relative
    text = path.read_text(encoding="utf-8")
    if old not in text:
        raise AssertionError(f"self-test cannot mutate {relative}: {old!r}")
    path.write_text(text.replace(old, new, 1), encoding="utf-8")


def self_test() -> None:
    baseline = repository_errors(ROOT)
    if baseline:
        raise AssertionError("clean repository fixture failed: " + "; ".join(baseline))

    generated = "src/main/kotlin/at/bernhardberger/tvheadend/htsp/requests/GeneratedHtspRequests.kt"
    production = "src/main/kotlin/at/bernhardberger/tvheadend/htsp/connection/HtspConnection.kt"
    test_source = next(path.relative_to(ROOT).as_posix() for path in sorted((ROOT / "src/test/kotlin").rglob("*.kt")))
    golden = next(path.relative_to(ROOT).as_posix() for path in sorted((ROOT / "src/test/resources").rglob("*.hex")))
    mutations: list[tuple[str, str, Callable[[Path], None]]] = [
        ("extra topology", "root topology mismatch", lambda root: (root / "unexpected.txt").write_text("x")),
        ("extra package", "production package set mismatch", lambda root: (root / "src/main/kotlin/hostile/Extra.kt").parent.mkdir(parents=True, exist_ok=True) or (root / "src/main/kotlin/hostile/Extra.kt").write_text("package hostile.sixth\n", encoding="utf-8")),
        ("extra dependency", "one production dependency", lambda root: append(root, "build.gradle.kts", '\nimplementation("example:bad:1")\n')),
        ("wrong version", "root build policy missing", lambda root: replace(root, "build.gradle.kts", 'version = "0.1.0-alpha.1-SNAPSHOT"', 'version = "9.9"')),
        ("wrong toolchain", "root build policy missing", lambda root: replace(root, "build.gradle.kts", "jvmToolchain(21)", "jvmToolchain(17)")),
        ("untyped public suspend API", "typed outcome", lambda root: append(root, production, "\npublic suspend fun hostile(): String = \"bad\"\n")),
        ("stale generated", "immutable generated drift", lambda root: append(root, generated, "\n")),
        ("stale API", "immutable api drift", lambda root: append(root, "api/htsp.api", "\n")),
        ("stale production", "immutable production drift", lambda root: append(root, production, "\n")),
        ("stale test", "immutable tests drift", lambda root: append(root, test_source, "\n")),
        ("stale golden", "immutable golden drift", lambda root: append(root, golden, "\n")),
        ("stale spec", "immutable protocol evidence drift", lambda root: append(root, "docs/htsp-protocol/htsp_spec.json", "\n")),
        ("stale matrix", "immutable protocol evidence drift", lambda root: append(root, "docs/htsp-protocol/HTSP_METHOD_MATRIX.md", "\n")),
        ("stale catalog", "immutable protocol evidence drift", lambda root: append(root, "docs/htsp-protocol/htsp_surface.py", "\n")),
        ("stale generator", "immutable protocol evidence drift", lambda root: append(root, "docs/htsp-protocol/generate_typed_requests.py", "\n")),
        ("fixture source identity", "static source identity mismatch", lambda root: append(root, next(iter(FIXTURE_FILES - {"consumer-contract/build.gradle.kts", "consumer-contract/settings.gradle.kts"})), "\n")),
        ("fixture project bypass", "repository/dependency bypass", lambda root: append(root, "consumer-contract/build.gradle.kts", '\nimplementation(project(":"))\n')),
        ("fixture repository bypass", "repository/dependency bypass", lambda root: append(root, "consumer-contract/settings.gradle.kts", "\nmavenLocal()\n")),
        ("README source mismatch", "root README: static source identity mismatch", lambda root: replace(root, "README.md", "enum class ProtocolFailurePolicy", "enum class ChangedProtocolFailurePolicy")),
        ("wrapper hash", "wrapper hash mismatch", lambda root: append(root, "gradlew", "\n")),
        ("wrapper URL", "wrapper properties", lambda root: replace(root, "gradle/wrapper/gradle-wrapper.properties", "gradle-9.0.0-bin.zip", "gradle-9.1.0-bin.zip")),
        ("wrapper checksum", "wrapper properties", lambda root: replace(root, "gradle/wrapper/gradle-wrapper.properties", DIST_HASH, "0" * 64)),
        ("action SHA", "CI exact policy mismatch", lambda root: replace(root, ".github/workflows/ci.yml", CHECKOUT_SHA, "0" * 40)),
        ("CI permissions", "CI exact policy mismatch", lambda root: replace(root, ".github/workflows/ci.yml", "contents: read", "contents: write")),
        ("CI bypass", "CI bypasses default", lambda root: replace(root, ".github/workflows/ci.yml", "run: ./tools/verify-htsp\n", "run: ./tools/verify-htsp --non-gradle\n")),
        ("missing attribution", "missing GPLv3/lineage/unofficial attribution", lambda root: replace(root, "README.md", "not official TVHeadend software", "third-party software")),
        ("pending activation", "P3-E2-pending checker was activated", lambda root: append(root, "tools/verify-htsp", "\n./tools/check-api-compatibility-policy\n")),
        ("pending weakening", "P3-E2-pending checker was weakened", lambda root: append(root, "tools/check-api-compatibility-policy", "\n")),
        ("map drift", "source-to-filtered map digest mismatch", lambda root: append(root, "docs/extraction/source-to-filtered.tsv", "\n")),
    ]

    def symlink_mutation(root: Path) -> None:
        target = root.parent / "outside.txt"
        target.write_text("outside", encoding="utf-8")
        path = root / "README.md"
        path.unlink()
        path.symlink_to(target)

    mutations.append(("symlink/escape topology", "symlinks or escapes", symlink_mutation))

    failures: list[str] = []
    for label, expected, mutate in mutations:
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary) / "repository"
            shutil.copytree(ROOT, root, symlinks=True, ignore=shutil.ignore_patterns(".git", ".gradle", "build"))
            mutate(root)
            findings = repository_errors(root)
            if not any(expected in finding for finding in findings):
                failures.append(f"{label} mutation was accepted or had wrong diagnostic: {findings}")
    if failures:
        raise AssertionError("; ".join(failures))


def main() -> int:
    parser = argparse.ArgumentParser()
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--self-test", action="store_true")
    group.add_argument("--wrapper-only", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        self_test()
        print("Standalone repository hostile self-tests passed.")
        return 0
    errors = wrapper_errors(ROOT) if args.wrapper_only else repository_errors(ROOT)
    if errors:
        print("Standalone repository policy failed:")
        for error in errors:
            print(f"  - {error}")
        return 1
    label = "wrapper/provenance" if args.wrapper_only else "repository/CI/fixture"
    print(f"Standalone {label} policy passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
