def package_and_outcome_errors(root: Path) -> list[str]:
    errors: list[str] = []
    packages: set[str] = set()
    for source in sorted((root / "src/main/kotlin").rglob("*.kt")):
        text = read(source, errors)
        match = re.search(r"(?m)^package\s+([A-Za-z0-9_.]+)\s*$", text)
        if match is None:
            errors.append(f"{source.relative_to(root)}: production source has no exact package")
        else:
            packages.add(match.group(1))
        for declaration in re.finditer(r"public\s+suspend\s+fun(?:\s*<[^>]+>)?\s+(?:[^\s(]+\.)?([A-Za-z_]\w*)\s*\(", text):
            opening = text.find("(", declaration.start())
            depth = 0
            closing = -1
            for index in range(opening, len(text)):
                depth += text[index] == "("
                depth -= text[index] == ")"
                if depth == 0:
                    closing = index
                    break
            tail = text[closing + 1:] if closing >= 0 else ""
            return_match = re.match(r"\s*:\s*([^=\n{]+)", tail)
            returned = "Unit" if return_match is None else return_match.group(1).strip()
            outer = returned.split("<", 1)[0].rstrip("?").rsplit(".", 1)[-1]
            if outer not in {"Unit", "HtspResult", "HtspConnectOutcome"}:
                line = text.count("\n", 0, declaration.start()) + 1
                errors.append(
                    f"{source.relative_to(root)}:{line}: public suspend call must return a typed outcome, not {returned}"
                )
    if packages != PACKAGES:
        errors.append(f"production package set mismatch: {sorted(packages)}")
    return errors


