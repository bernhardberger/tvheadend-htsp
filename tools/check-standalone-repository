def governance_errors(root: Path) -> list[str]:
    errors: list[str] = []
    readme = read(root, "README.md", errors)
    index = read(root, "docs/README.md", errors)
    versioning = read(root, "docs/versioning.md", errors)
    releasing = read(root, "docs/releasing.md", errors)
    changelog = read(root, "CHANGELOG.md", errors)
    build = read(root, "build.gradle.kts", errors)
    versions = re.findall(r'(?m)^version\s*=\s*"([^"]+)"\s*$', build)
    mode = versions[0] if len(versions) == 1 and versions[0] in {"0.1.0-SNAPSHOT", "0.1.0"} else None
    normalized_readme = normalized_markdown(readme)
    normalized_index = normalized_markdown(index)
    normalized_versioning = normalized_markdown(versioning)
    normalized_releasing = normalized_markdown(releasing)
    normalized_changelog = normalized_markdown(changelog)
    for value in (
        "independently maintained GPLv3", "Preclikos/tvhstream",
        "not official TVHeadend software", "not affiliated",
    ):
        if value not in normalized_readme:
            errors.append(f"README governance mismatch: {value}")
    for value in ("[`releasing.md`](releasing.md)", "[`CHANGELOG.md`](../CHANGELOG.md)", "[`../release/openpgp/README.md`](../release/openpgp/README.md)"):
        if index.count(value) != 1:
            errors.append(f"documentation index governance mismatch: {value}")
    tracked_key_claims = (
        (normalized_index, "tracked, reviewed public-only OpenPGP key export and exact primary fingerprint"),
        (normalized_releasing, "repository now tracks the reviewed public-only key export and exact primary fingerprint"),
        (normalized_releasing, "Setup verifies both in an isolated temporary keyring"),
        (normalized_releasing, "verification material and setup evidence only"),
        (normalized_releasing, "does not provide or prove access to the private key or passphrase, signing, candidate creation, publication, distribution, or release readiness"),
    )
    for document, claim in tracked_key_claims:
        if claim not in document:
            errors.append(f"tracked public-key documentation mismatch: {claim}")
    for document, stale_claim in (
        (normalized_index, "future tracked public-only OpenPGP key"),
        (normalized_releasing, "are still an owner prerequisite"),
        (normalized_releasing, "Until those files are reviewed and present"),
    ):
        if stale_claim in document:
            errors.append(f"tracked public-key documentation retains stale claim: {stale_claim}")
    common_claims = (
        (normalized_versioning, "While the major version is zero, the public API and behavior are provisional."),
        (normalized_versioning, "next minor version, not a patch version"),
        (normalized_versioning, "No source, binary, or behavioral compatibility is promised"),
        (normalized_releasing, "initial provisional baseline"),
        (normalized_releasing, "do not promise compatibility or support"),
        (normalized_releasing, "separate owner authorization"),
        (normalized_changelog, "initial provisional baseline"),
    )
    if mode == "0.1.0-SNAPSHOT":
        mode_name = "snapshot"
        mode_claims = (
            (normalized_readme, f"The checkout currently uses the mutable, local-only snapshot `{COORDINATE}`."),
            (normalized_readme, "It is not available from Maven Central or another public repository."),
            (normalized_index, "unreleased, non-normative baseline notes"),
            (normalized_versioning, f"The current coordinate is `{COORDINATE}`."),
            (normalized_versioning, "published release bytes must never be replaced"),
            (normalized_releasing, "planned first provisional major-zero release"),
            (normalized_releasing, "It has not been released or published."),
            (normalized_changelog, "## [Unreleased]"),
            (normalized_changelog, "not a release, publication, compatibility baseline, or support promise"),
        )
    elif mode == "0.1.0":
        mode_name = "release"
        mode_claims = (
            (normalized_readme, "The Gradle dependency uses the exact immutable release coordinate `at.bernhardberger.tvheadend:htsp:0.1.0`."),
            (normalized_readme, "Availability from Maven Central or another public repository must be independently verified; this repository does not claim that publication has occurred."),
            (normalized_index, "the `0.1.0` initial provisional baseline notes"),
            (normalized_versioning, "The current immutable release coordinate is `at.bernhardberger.tvheadend:htsp:0.1.0`."),
            (normalized_versioning, "Release bytes for this coordinate are immutable and must never be replaced."),
            (normalized_versioning, "Availability from Maven Central or any other public repository is independently verified external state."),
            (normalized_releasing, "`0.1.0` is the first provisional major-zero release."),
            (normalized_releasing, "Candidate preparation and local staging do not establish external publication or availability."),
            (normalized_releasing, "Publication and availability are independently verified external state."),
            (normalized_changelog, "## [0.1.0]"),
            (normalized_changelog, "does not promise source, binary, or behavioral compatibility or support"),
        )
    else:
        mode_name = "unsupported"
        mode_claims = ()
        errors.append(f"unsupported mode documentation: root versions {versions}")
        if any(re.fullmatch(r"0\.1\.0-(?:alpha|beta|rc)(?:[.-][0-9A-Za-z]+)*(?:-SNAPSHOT)?", version) for version in versions):
            errors.append("stale alpha version is forbidden in the root version assignment")
    for document, claim in (*common_claims, *mode_claims):
        if claim not in document:
            errors.append(f"{mode_name} mode documentation mismatch: {claim}")
    combined_governance = " ".join((normalized_readme, normalized_index, normalized_versioning, normalized_releasing, normalized_changelog))
    contradictions = (
        (r"\bThe Maven version must include an alpha suffix\.", "required Maven alpha suffix"),
        (r"\bThe GitHub pre-release marker changes the Maven coordinate\.", "GitHub marker changes coordinate"),
        (r"\b(?:release|0\.1\.0) (?:is|has been) (?:published|available)\b", "false release publication or availability"),
        (r"\brelease bytes (?:may|can) be (?:replaced|overwritten|republished)\b", "mutable release"),
        (r"\b0\.1\.0-(?:alpha|beta|rc)(?:[.-][0-9A-Za-z]+)*\b", "legacy prerelease version"),
    )
    for pattern, description in contradictions:
        if re.search(pattern, combined_governance, re.IGNORECASE):
            errors.append(f"contradictory version documentation is forbidden: {description}")
    errors.extend(api_policy_static_errors(root))
    for relative, expected in (("docs/extraction/source-to-filtered.tsv", MAP_HASH), ("docs/extraction/manifest.json", MANIFEST_HASH)):
        path = root / relative
        if not path.is_file() or path.is_symlink() or sha256(path) != expected:
            errors.append(f"extraction provenance digest mismatch: {relative}")
    return errors


def ast_call(expression: str) -> str:
    return ast.dump(ast.parse(expression, mode="eval").body, include_attributes=False)


def literal_ast_string(node: ast.AST) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        left = literal_ast_string(node.left)
        right = literal_ast_string(node.right)
        if left is not None and right is not None:
            return left + right
    return None


def enclosing_function(node: ast.AST, parents: dict[ast.AST, ast.AST]) -> str | None:
    current: ast.AST | None = node
    while current is not None:
        if isinstance(current, (ast.FunctionDef, ast.AsyncFunctionDef)):
            return current.name
        current = parents.get(current)
