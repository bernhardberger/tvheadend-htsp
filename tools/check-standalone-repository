                errors.append(f"self-test rejected temporary-policy comment/string fixture in {relative}: {actual}")
        case = temporary_root / "case-positive-unrelated-collection-removal"
        shutil.copytree(ROOT, case, symlinks=True, ignore=shutil.ignore_patterns(".git", "build", "__pycache__", "*.pyc"))
        (case / ".git").mkdir()
        replace_once(
            case,
            "build.gradle.kts",
            "\n" + DEPENDENCY_TASK_CONTRACT + "\n",
            '\nval unrelatedItems = mutableListOf("stale", "keep")\n'
            'unrelatedItems.removeIf { item -> item == "stale" }\n'
            'unrelatedItems.remove("keep")\n\n'
            + DEPENDENCY_TASK_CONTRACT
            + "\n",
        )
        actual = repository_errors(case)
        if actual:
            errors.append(f"self-test rejected unrelated collection removal fixture: {actual}")
        case = temporary_root / "case-symlink"
        shutil.copytree(ROOT, case, symlinks=True, ignore=shutil.ignore_patterns(".git", "build", "__pycache__", "*.pyc"))
        (case / ".git").mkdir()
        target = case / "README.md"
        target.unlink()
        target.symlink_to("/etc/passwd")
        actual = repository_errors(case)
        if not any("symlink/escape" in error for error in actual):
            errors.append(f"self-test accepted repository symlink/escape: {actual}")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--wrapper-only", action="store_true")
    arguments = parser.parse_args()
    if arguments.self_test and arguments.wrapper_only:
        parser.error("--self-test and --wrapper-only are mutually exclusive")
    if arguments.wrapper_only:
        errors = wrapper_errors(ROOT)
        success = "Standalone wrapper policy passed"
    elif arguments.self_test:
        errors = self_test()
        success = "Standalone repository hostile self-tests passed"
    else:
        errors = repository_errors(ROOT)
        success = "Standalone P3-E2 repository policy passed"
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(success)
    return 0


if __name__ == "__main__":
    import sys
    raise SystemExit(main())
