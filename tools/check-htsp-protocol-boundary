                    f"package {PROTOCOL_PACKAGE}\nclass Valid\n",
                )
            actual = boundary_errors(root)
            if expected is None and actual:
                errors.append(f"{label} self-test unexpectedly failed")
            elif expected is not None and not any(expected in error for error in actual):
                errors.append(f"{label} mutation self-test was not rejected")

    with tempfile.TemporaryDirectory() as temporary_directory:
        sandbox = Path(temporary_directory)
        root = sandbox / "repository"
        outside = sandbox / "outside"
        root.mkdir()
        outside.mkdir()
        source_parent = root / PROTOCOL_ROOT.parent
        source_parent.mkdir(parents=True)
        (source_parent / PROTOCOL_ROOT.name).symlink_to(outside, target_is_directory=True)
        actual = boundary_errors(root)
        if not any("must not traverse a symlink" in error for error in actual):
            errors.append("symlinked protocol source-root self-test was not rejected")

    with tempfile.TemporaryDirectory() as temporary_directory:
        sandbox = Path(temporary_directory)
        root = sandbox / "repository"
        outside = sandbox / "outside.kt"
        root.mkdir()
        outside.write_text(
            f"package {PROTOCOL_PACKAGE}\nclass Outside\n",
            encoding="utf-8",
        )
        write_source(
            root,
            PROTOCOL_ROOT / "Valid.kt",
            f"package {PROTOCOL_PACKAGE}\nclass Valid\n",
        )
        (root / PROTOCOL_ROOT / "Escaped.kt").symlink_to(outside)
        actual = boundary_errors(root)
        if not any("must not traverse a symlink" in error for error in actual):
            errors.append("symlinked protocol source-file self-test was not rejected")

    with tempfile.TemporaryDirectory() as temporary_directory:
        root = Path(temporary_directory) / "repository"
        root.mkdir()
        write_source(
            root,
            PROTOCOL_ROOT / "Valid.kt",
            f"package {PROTOCOL_PACKAGE}\nclass Valid\n",
        )
        fifo = root / PROTOCOL_ROOT / "Invalid.kt"
        os.mkfifo(fifo)
        actual = boundary_errors(root)
        if not any("must be a regular file" in error for error in actual):
            errors.append("non-regular protocol source self-test was not rejected")
    return errors


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        errors = self_test_errors()
        label = "HTSP protocol boundary self-tests"
    elif not sys.argv[1:]:
        errors = boundary_errors(ROOT)
        label = "HTSP protocol boundary"
    else:
        print("usage: check-htsp-protocol-boundary [--self-test]", file=sys.stderr)
        return 2
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(f"{label} passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
