@dataclass(frozen=True)
class Token:
    value: str
    line: int
    kind: str


def preprocess_java_unicode_escapes(text: str) -> tuple[str, list[str]]:
    translated: list[str] = []
    errors: list[str] = []
    index = 0
    while index < len(text):
        if text[index] != "\\" or index + 1 >= len(text) or text[index + 1] != "u":
            translated.append(text[index])
            index += 1
            continue
        escape_start = index
        index += 2
        while index < len(text) and text[index] == "u":
            index += 1
        digits = text[index : index + 4]
        if len(digits) != 4 or any(character not in "0123456789abcdefABCDEF" for character in digits):
            errors.append("malformed Java Unicode escape")
            translated.append(text[escape_start])
            index = escape_start + 1
            continue
        translated.append(chr(int(digits, 16)))
        index += 4
    return "".join(translated).replace("\r\n", "\n").replace("\r", "\n"), errors


def relative_display(path: Path, root: Path) -> str:
    return path.relative_to(root).as_posix()


def source_set_name(path: Path, root: Path) -> str | None:
    relative = path.relative_to(root)
    parts = relative.parts
    for index, part in enumerate(parts[:-1]):
        if part == "src":
            return parts[index + 1]
    return None


def is_test_source_set(name: str) -> bool:
    lowered = name.lower()
    return any(lowered.endswith(suffix) for suffix in TEST_SOURCE_SET_SUFFIXES)


def is_production_location(path: Path, root: Path) -> bool:
    if path.is_relative_to(root / PROTOCOL_MODULE_MAIN):
        return True
    source_set = source_set_name(path, root)
    return source_set is not None and not is_test_source_set(source_set)


def is_production_source(path: Path, root: Path) -> bool:
    return path.suffix in SOURCE_SUFFIXES and is_production_location(path, root)


def source_relevant_symlink(path: Path, root: Path) -> bool:
    relative = path.relative_to(root)
    parts = relative.parts
    module_parts = PROTOCOL_MODULE_MAIN.parts
    is_protocol_component = (
        parts == module_parts[: len(parts)]
        or module_parts == parts[: len(module_parts)]
    )
    source_set = source_set_name(path, root)
    is_source_component = (
        parts[-1:] == ("src",)
        or (source_set is not None and not is_test_source_set(source_set))
    )
    return is_protocol_component or is_source_component


def production_sources(root: Path) -> tuple[list[Path], list[str]]:
    sources: list[Path] = []
    errors: list[str] = []

    def visit(directory: Path) -> None:
        try:
            entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
        except OSError:
            errors.append(
                f"{relative_display(directory, root) or '.'}: cannot inspect repository directory"
            )
            return
        for entry in entries:
            candidate = Path(entry.path)
            relative = relative_display(candidate, root)
            try:
                if entry.is_symlink():
                    if source_relevant_symlink(candidate, root):
                        errors.append(
                            f"{relative}: production source path must not traverse a symlink"
                        )
                    continue
                if entry.is_dir(follow_symlinks=False):
                    if (
                        entry.name not in IGNORED_DIRECTORIES
                        or is_production_location(candidate, root)
                    ):
                        visit(candidate)
                    continue
                if is_production_source(candidate, root):
                    if entry.is_file(follow_symlinks=False):
                        sources.append(candidate)
                    else:
                        errors.append(
                            f"{relative}: production source candidate must be a regular file"
                        )
            except OSError:
                if is_production_source(candidate, root):
                    errors.append(
                        f"{relative}: cannot inspect production source candidate"
                    )

    visit(root)
    return sorted(sources), errors


class Lexer:
    def __init__(self, text: str, language: str) -> None:
        self.text = text
        self.language = language
        self.index = 0
        self.line = 1
        self.tokens: list[Token] = []
        self.errors: list[str] = []

    def advance(self, count: int = 1) -> None:
        consumed = self.text[self.index : self.index + count]
        self.line += consumed.count("\n")
        self.index += count

    def scan_block_comment(self) -> None:
        start_line = self.line
        depth = 1
        self.advance(2)
        while self.index < len(self.text) and depth:
            pair = self.text[self.index : self.index + 2]
            if pair == "/*" and self.language == "kotlin":
                depth += 1
                self.advance(2)
            elif pair == "*/":
                depth -= 1
                self.advance(2)
            else:
                self.advance()
        if depth:
            self.errors.append(f"line {start_line}: unterminated block comment")

    def scan_quoted(self, quote: str, interpolated: bool) -> None:
        start_line = self.line
        self.advance(len(quote))
        while self.index < len(self.text):
            if self.text.startswith(quote, self.index):
                self.advance(len(quote))
                return
            if len(quote) == 1 and self.text[self.index] == "\\":
                self.advance(min(2, len(self.text) - self.index))
                continue
            if (
                interpolated
                and self.text[self.index : self.index + 2] == "${"
            ):
                self.advance(2)
                self.scan_code(stop_at_closing_brace=True)
                continue
            self.advance()
        self.errors.append(f"line {start_line}: unterminated quoted literal")

    def scan_identifier(self) -> None:
        start = self.index
        line = self.line
        self.advance()
        while self.index < len(self.text) and (
            self.text[self.index].isalnum() or self.text[self.index] == "_"
        ):
            self.advance()
        self.tokens.append(Token(self.text[start : self.index], line, "identifier"))

    def scan_escaped_identifier(self) -> None:
        line = self.line
        self.advance()
        start = self.index
        while self.index < len(self.text) and self.text[self.index] not in "`\n":
            self.advance()
        if self.index == len(self.text) or self.text[self.index] != "`":
            self.errors.append(f"line {line}: unterminated escaped identifier")
            return
        value = self.text[start : self.index]
        self.advance()
        if not value:
            self.errors.append(f"line {line}: empty escaped identifier")
        else:
            self.tokens.append(Token(value, line, "escaped_identifier"))

    def scan_code(self, stop_at_closing_brace: bool = False) -> None:
        while self.index < len(self.text):
            character = self.text[self.index]
            pair = self.text[self.index : self.index + 2]
            triple = self.text[self.index : self.index + 3]
            if character.isspace():
                self.advance()
            elif pair == "//":
                newline = self.text.find("\n", self.index + 2)
                self.advance(
                    len(self.text) - self.index
                    if newline < 0
                    else newline - self.index
                )
            elif pair == "/*":
                self.scan_block_comment()
            elif triple == '\"\"\"':
                self.scan_quoted(triple, interpolated=self.language == "kotlin")
            elif character == '"':
                self.scan_quoted(character, interpolated=self.language == "kotlin")
            elif character == "'":
                self.scan_quoted(character, interpolated=False)
            elif character == "`" and self.language == "kotlin":
                self.scan_escaped_identifier()
            elif character.isalpha() or character == "_":
                self.scan_identifier()
            elif character == "{":
                self.tokens.append(Token(character, self.line, "symbol"))
                self.advance()
                self.scan_code(stop_at_closing_brace=True)
            elif character == "}" and stop_at_closing_brace:
                self.advance()
                return
            else:
                self.tokens.append(Token(character, self.line, "symbol"))
                self.advance()
        if stop_at_closing_brace:
            self.errors.append(f"line {self.line}: unterminated brace expression")

    def run(self) -> tuple[list[Token], list[str]]:
        self.scan_code()
        return self.tokens, self.errors


def parse_qualified_name(
    tokens: list[Token], start: int, allow_wildcard: bool
) -> tuple[str, int] | None:
    if start >= len(tokens) or tokens[start].kind not in {
        "identifier",
        "escaped_identifier",
    }:
        return None
    parts = [tokens[start].value]
    index = start + 1
    while index + 1 < len(tokens) and tokens[index].value == ".":
        next_token = tokens[index + 1]
        if next_token.kind in {"identifier", "escaped_identifier"}:
            parts.append(next_token.value)
        elif allow_wildcard and next_token.value == "*":
            parts.append("*")
            index += 2
            break
        else:
            return None
        index += 2
    if index < len(tokens) and tokens[index].value == ".":
        return None
    return ".".join(parts), index


def parse_directives(
    tokens: list[Token], keyword: str, language: str
) -> tuple[list[tuple[str, int, int]], list[int]]:
    directives: list[tuple[str, int, int]] = []
    unrecognized: list[int] = []
    for start, token in enumerate(tokens):
        if token.kind != "identifier" or token.value != keyword:
            continue
        index = start + 1
        if keyword == "import" and language == "java":
            if index < len(tokens) and tokens[index].value == "static":
                index += 1
        parsed = parse_qualified_name(tokens, index, allow_wildcard=keyword == "import")
        if parsed is None:
            unrecognized.append(start)
            continue
        name, index = parsed
        if keyword == "import" and language == "kotlin":
            if index < len(tokens) and tokens[index].value == "as":
                index += 1
                if index >= len(tokens) or tokens[index].kind not in {
                    "identifier",
                    "escaped_identifier",
                }:
                    unrecognized.append(start)
                    continue
                index += 1
        last_line = tokens[index - 1].line
        if index < len(tokens) and tokens[index].value == ";":
            index += 1
        elif language == "java" or (
            index < len(tokens) and tokens[index].line == last_line
        ):
            unrecognized.append(start)
            continue
        directives.append((name, start, index))
    return directives, unrecognized


def dependency_allowed(name: str) -> bool:
    normalized = name.removesuffix(".*")
    if normalized == PROTOCOL_PACKAGE:
        return True
    if normalized.startswith(f"{PROTOCOL_PACKAGE}."):
        first_suffix_segment = normalized[len(PROTOCOL_PACKAGE) + 1 :].split(".", 1)[0]
        return first_suffix_segment[:1].isupper()
    return any(
        normalized == package or normalized.startswith(f"{package}.")
        for package in ALLOWED_DEPENDENCY_PACKAGES
    )


def qualified_references(
    tokens: list[Token], excluded_indexes: set[int]
) -> list[tuple[str, int]]:
    references: list[tuple[str, int]] = []
    index = 0
    while index < len(tokens):
        if (
            index in excluded_indexes
            or tokens[index].kind not in {"identifier", "escaped_identifier"}
            or (index > 0 and tokens[index - 1].value == ".")
        ):
            index += 1
            continue
        parsed = parse_qualified_name(tokens, index, allow_wildcard=False)
        if parsed is None:
            index += 1
            continue
        name, end = parsed
        parts = name.split(".")
        known_root = any(
            name == root or name.startswith(f"{root}.")
            for root in KNOWN_PACKAGE_ROOTS
        )
        package_shaped_class = (
            len(parts) >= 2
            and parts[0][:1].islower()
            and any(part[:1].isupper() for part in parts[1:])
        )
        if end > index + 1 and (known_root or package_shaped_class):
            references.append((name, tokens[index].line))
        index = max(index + 1, end)
    return references


def source_errors(path: Path, root: Path) -> list[str]:
    relative = relative_display(path, root)
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return [f"{relative}: production source must be readable UTF-8"]
    language = "kotlin" if path.suffix == ".kt" else "java"
    preprocessing_errors: list[str] = []
    if language == "java":
        text, preprocessing_errors = preprocess_java_unicode_escapes(text)
    tokens, lexical_errors = Lexer(text, language).run()
    package_directives, unrecognized_packages = parse_directives(
        tokens, "package", language
    )
    inside_protocol_module = path.is_relative_to(root / PROTOCOL_MODULE_MAIN)
    errors = [
        f"{relative}: production source contains an unrecognized lexical structure"
        for _ in preprocessing_errors + lexical_errors
    ]

    if unrecognized_packages:
        errors.append(f"{relative}: production source contains an unrecognized package")

    if inside_protocol_module:
        if len(package_directives) != 1 or unrecognized_packages:
            errors.append(
                f"{relative}: protocol source must declare exactly one package"
            )
        else:
            if (
                not path.is_relative_to(root / PROTOCOL_ROOT)
                or package_directives[0][0] != PROTOCOL_PACKAGE
            ):
                errors.append(
                    f"{relative}: protocol source must declare the single rooted module package"
                )
    else:
        for declared, _, _ in package_directives:
            if declared == PROTOCOL_PACKAGE or declared.startswith(
                f"{PROTOCOL_PACKAGE}."
            ):
                errors.append(
                    f"{relative}: protocol package declaration is outside its rooted source directory"
                )
                break
        return errors

    import_directives, unrecognized_imports = parse_directives(
        tokens, "import", language
    )
    if unrecognized_imports:
        errors.append(f"{relative}: protocol source contains an unrecognized import")
    for name, start, _ in import_directives:
        if not dependency_allowed(name):
            errors.append(
                f"{relative}:{tokens[start].line}: protocol dependency is outside the allowed surface"
            )

    excluded_indexes = {
        index
        for _, start, end in package_directives + import_directives
        for index in range(start, end)
    }
    for token in tokens:
        if token.kind in {"identifier", "escaped_identifier"} and token.value in FORBIDDEN_MODULE_SYMBOLS:
            errors.append(
                f"{relative}:{token.line}: protocol module references forbidden client runtime ownership"
            )
    for name, line in qualified_references(tokens, excluded_indexes):
        if not dependency_allowed(name):
            errors.append(
                f"{relative}:{line}: fully qualified protocol dependency is outside the allowed surface"
            )
    return errors


def boundary_errors(root: Path) -> list[str]:
    protocol_root = root / PROTOCOL_ROOT
    errors: list[str] = []
    if protocol_root.is_symlink() or not protocol_root.is_dir():
        errors.append(
            f"{PROTOCOL_ROOT.as_posix()}: rooted protocol source directory must be a real directory"
        )
    sources, discovery_errors = production_sources(root)
    errors.extend(discovery_errors)
    for source in sources:
        errors.extend(source_errors(source, root))
    if protocol_root.is_dir() and not any(
        source.is_relative_to(protocol_root) for source in sources
    ):
        errors.append(
            f"{PROTOCOL_ROOT.as_posix()}: rooted protocol source directory has no production sources"
        )
    return sorted(set(errors))


def write_source(root: Path, relative: Path, content: str) -> Path:
    path = root / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8", newline="\n")
    return path


