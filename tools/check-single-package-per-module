@dataclass(frozen=True)
class Token:
    value: str
    line: int


def display(path: Path, root: Path) -> str:
    return path.relative_to(root).as_posix()


def is_readable(mode: int) -> bool:
    return bool(mode & (stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH))


def is_traversable(mode: int) -> bool:
    return bool(mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH))


def is_test_source_set(name: str) -> bool:
    return name in {"test", "testFixtures"} or name.endswith(("Test", "TestFixtures"))


def preprocess_java_unicode_escapes(text: str) -> tuple[str, list[str]]:
    translated: list[str] = []
    errors: list[str] = []
    index = 0
    while index < len(text):
        if text[index] != "\\" or index + 1 >= len(text) or text[index + 1] != "u":
            translated.append(text[index])
            index += 1
            continue
        index += 2
        while index < len(text) and text[index] == "u":
            index += 1
        digits = text[index : index + 4]
        if len(digits) != 4 or any(character not in "0123456789abcdefABCDEF" for character in digits):
            errors.append("malformed Java Unicode escape")
            return text, errors
        translated.append(chr(int(digits, 16)))
        index += 4
    return "".join(translated).replace("\r\n", "\n").replace("\r", "\n"), errors


class Lexer:
    def __init__(self, text: str, language: str) -> None:
        self.text = text
        self.language = language
        self.index = 0
        self.line = 1
        self.tokens: list[Token] = []
        self.errors: list[str] = []

    def advance(self, count: int = 1) -> None:
        consumed = self.text[self.index : self.index + count]
        self.line += consumed.count("\n")
        self.index += count

    def quoted(self, quote: str) -> None:
        start_line = self.line
        self.advance(len(quote))
        while self.index < len(self.text):
            if self.text.startswith(quote, self.index):
                self.advance(len(quote))
                return
            if len(quote) == 1 and self.text[self.index] == "\\":
                self.advance(min(2, len(self.text) - self.index))
            else:
                self.advance()
        self.errors.append(f"line {start_line}: unterminated quoted literal")

    def block_comment(self) -> None:
        start_line = self.line
        depth = 1
        self.advance(2)
        while self.index < len(self.text) and depth:
            pair = self.text[self.index : self.index + 2]
            if pair == "/*" and self.language == "kotlin":
                depth += 1
                self.advance(2)
            elif pair == "*/":
                depth -= 1
                self.advance(2)
            else:
                self.advance()
        if depth:
            self.errors.append(f"line {start_line}: unterminated block comment")

    def run(self) -> tuple[list[Token], list[str]]:
        while self.index < len(self.text):
            character = self.text[self.index]
            pair = self.text[self.index : self.index + 2]
            triple = self.text[self.index : self.index + 3]
            if character.isspace():
                self.advance()
            elif pair == "//":
                newline = self.text.find("\n", self.index + 2)
                self.advance(len(self.text) - self.index if newline < 0 else newline - self.index)
            elif pair == "/*":
                self.block_comment()
            elif triple == '\"\"\"' and self.language == "kotlin":
                self.quoted(triple)
            elif character in {'"', "'"}:
                self.quoted(character)
            elif character.isalpha() or character == "_":
                start = self.index
                line = self.line
                self.advance()
                while self.index < len(self.text) and (
                    self.text[self.index].isalnum() or self.text[self.index] == "_"
                ):
                    self.advance()
                self.tokens.append(Token(self.text[start : self.index], line))
            elif character in ".;":
                self.tokens.append(Token(character, self.line))
                self.advance()
            else:
                self.advance()
        return self.tokens, self.errors


def declared_package(path: Path, root: Path) -> tuple[str | None, list[str]]:
    relative = display(path, root)
    try:
        mode = path.stat(follow_symlinks=False).st_mode
    except OSError:
        return None, [f"{relative}: cannot inspect production source"]
    if not stat.S_ISREG(mode):
        return None, [f"{relative}: production source must be a regular file"]
    if not is_readable(mode):
        return None, [f"{relative}: production source must be readable"]
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return None, [f"{relative}: production source must be readable UTF-8"]
    language = "java" if path.suffix == ".java" else "kotlin"
    preprocessing_errors: list[str] = []
    if language == "java":
        text, preprocessing_errors = preprocess_java_unicode_escapes(text)
    tokens, lexical_errors = Lexer(text, language).run()
    if preprocessing_errors or lexical_errors:
        return None, [f"{relative}: production source has ambiguous lexical structure"]

    declarations: list[str] = []
    index = 0
    while index < len(tokens):
        if tokens[index].value != "package":
            index += 1
            continue
        cursor = index + 1
        parts: list[str] = []
        expect_identifier = True
        while cursor < len(tokens):
            token = tokens[cursor]
            if expect_identifier and token.value not in {".", ";", "package"}:
                parts.append(token.value)
                expect_identifier = False
                cursor += 1
            elif not expect_identifier and token.value == ".":
                expect_identifier = True
                cursor += 1
            else:
                break
        valid_terminator = (
            not expect_identifier
            and (
                (language == "java" and cursor < len(tokens) and tokens[cursor].value == ";")
                or (language == "kotlin" and (cursor == len(tokens) or tokens[cursor].line > tokens[index].line))
            )
        )
        if not valid_terminator:
            return None, [f"{relative}: production source has an ambiguous package declaration"]
        declarations.append(".".join(parts))
        index = cursor + (1 if language == "java" else 0)

    if len(declarations) != 1:
        return None, [
            f"{relative}: production source must declare exactly one unambiguous package"
        ]
    return declarations[0], []


def module_roots(root: Path) -> tuple[list[Path], list[str]]:
    sdk_root = root / SDK_ROOT
    if sdk_root.is_symlink() or not sdk_root.is_dir():
        return [], ["sdk: SDK module root must be one real directory"]
    modules: list[Path] = []
    errors: list[str] = []
    try:
        entries = sorted(os.scandir(sdk_root), key=lambda entry: entry.name)
    except OSError:
        return [], ["sdk: cannot inspect SDK module root"]
    for entry in entries:
        module = Path(entry.path)
        if entry.name in STANDALONE_FIXTURE_MODULES:
            continue
        if entry.is_symlink():
            errors.append(f"sdk/{entry.name}: SDK module path must not be a symlink")
            continue
        if not entry.is_dir(follow_symlinks=False):
            continue
        build_file = module / "build.gradle.kts"
        if build_file.is_symlink():
            errors.append(f"sdk/{entry.name}/build.gradle.kts: module marker must not be a symlink")
        elif build_file.is_file():
            modules.append(module)
    return modules, errors


def production_sources(module: Path, root: Path) -> tuple[list[Path], list[str]]:
    source_root = module / "src"
    relative_root = display(source_root, root)
    try:
        source_root_mode = source_root.stat(follow_symlinks=False).st_mode
    except FileNotFoundError:
        return [], []
    except OSError:
        return [], [f"{relative_root}: cannot inspect production source root"]
    if stat.S_ISLNK(source_root_mode) or not stat.S_ISDIR(source_root_mode):
        return [], [f"{relative_root}: production source root must be one real directory"]
    if not is_readable(source_root_mode):
        return [], [f"{relative_root}: production source root must be readable"]
    if not is_traversable(source_root_mode):
        return [], [f"{relative_root}: production source root must be traversable"]
    sources: list[Path] = []
    errors: list[str] = []
    try:
        source_sets = sorted(os.scandir(source_root), key=lambda entry: entry.name)
    except OSError:
        return [], [f"{relative_root}: cannot inspect production source root"]

    def visit(directory: Path) -> None:
        relative = display(directory, root)
        try:
            mode = directory.stat(follow_symlinks=False).st_mode
            if not is_readable(mode):
                errors.append(f"{relative}: production source directory must be readable")
                return
            if not is_traversable(mode):
                errors.append(f"{relative}: production source directory must be traversable")
                return
            entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
        except OSError:
            errors.append(f"{relative}: cannot inspect production source directory")
            return
        for entry in entries:
            candidate = Path(entry.path)
            candidate_relative = display(candidate, root)
            if entry.is_symlink():
                errors.append(f"{candidate_relative}: production source path must not traverse a symlink")
            elif entry.is_dir(follow_symlinks=False):
                if entry.name not in IGNORED_DIRECTORIES:
                    visit(candidate)
            elif candidate.suffix in SOURCE_SUFFIXES:
                if entry.is_file(follow_symlinks=False):
                    sources.append(candidate)
                else:
                    errors.append(f"{candidate_relative}: production source candidate must be a regular file")

    for source_set_entry in source_sets:
        source_set = Path(source_set_entry.path)
        source_set_relative = display(source_set, root)
        if source_set_entry.is_symlink():
            errors.append(f"{source_set_relative}: production source set must not be a symlink")
        elif not source_set_entry.is_dir(follow_symlinks=False):
            errors.append(
                f"{source_set_relative}: production source set must be one real directory"
            )
        elif is_test_source_set(source_set_entry.name):
            continue
        else:
            visit(source_set)
    return sorted(sources), errors


def package_ownership_errors(
    root: Path,
    expected_package_sets: dict[str, set[str]] = EXPECTED_PACKAGE_SETS,
) -> list[str]:
    modules, errors = module_roots(root)
    owners: dict[str, set[str]] = {}
    module_packages: dict[str, set[str]] = {}
    discovered_module_names = {module.name for module in modules}
    for module_name in sorted(set(expected_package_sets) - discovered_module_names):
        errors.append(f"sdk/{module_name}: expected retained SDK module was not discovered")
    for module in modules:
        module_packages[module.name] = set()
        sources, discovery_errors = production_sources(module, root)
        errors.extend(discovery_errors)
        for source in sources:
            package_name, source_errors = declared_package(source, root)
            errors.extend(source_errors)
            if package_name is not None:
                owners.setdefault(package_name, set()).add(module.name)
                module_packages[module.name].add(package_name)
    for module_name in sorted(set(module_packages) - set(expected_package_sets)):
        errors.append(f"sdk/{module_name}: SDK module has no declared package-set contract")
    for module_name, expected_packages in sorted(expected_package_sets.items()):
        actual_packages = module_packages.get(module_name, set())
        missing = sorted(expected_packages - actual_packages)
        extra = sorted(actual_packages - expected_packages)
        if missing or extra:
            details: list[str] = []
            if missing:
                details.append(f"missing [{', '.join(missing)}]")
            if extra:
                details.append(f"extra [{', '.join(extra)}]")
            errors.append(
                f"sdk/{module_name}: declared production package set mismatch; "
                + "; ".join(details)
            )
    for package_name, package_modules in sorted(owners.items()):
        if len(package_modules) > 1:
            errors.append(
                f"production package {package_name} is declared in SDK modules "
                f"{', '.join(sorted(package_modules))}"
            )
    return sorted(set(errors))


def standalone_package_errors(root: Path) -> list[str]:
    sources, errors = production_sources(root, root)
    actual: set[str] = set()
    for source in sources:
        package_name, source_errors = declared_package(source, root)
        errors.extend(source_errors)
        if package_name is not None:
            actual.add(package_name)
    missing = sorted(STANDALONE_PACKAGES - actual)
    extra = sorted(actual - STANDALONE_PACKAGES)
    if missing or extra:
        details = []
        if missing:
            details.append(f"missing [{', '.join(missing)}]")
        if extra:
            details.append(f"extra [{', '.join(extra)}]")
        errors.append("htsp: declared production package set mismatch; " + "; ".join(details))
    return sorted(set(errors))


def write_module_source(root: Path, module: str, source_set: str, package_name: str) -> Path:
    module_root = root / "sdk" / module
    module_root.mkdir(parents=True, exist_ok=True)
    (module_root / "build.gradle.kts").write_text("// fixture\n", encoding="utf-8")
    source = module_root / "src" / source_set / "kotlin" / "example" / "Fixture.kt"
    source.parent.mkdir(parents=True, exist_ok=True)
    source.write_text(f"package {package_name}\nclass Fixture\n", encoding="utf-8")
    return source


def self_test_errors() -> list[str]:
    errors: list[str] = []
    expected_package_sets = {
        "absent-source": set(),
        "alpha": {"example.alpha"},
        "beta": {"example.beta"},
    }

    def check(root: Path) -> list[str]:
        return package_ownership_errors(root, expected_package_sets)

    with tempfile.TemporaryDirectory() as temporary_directory:
        root = Path(temporary_directory) / "repository"
        root.mkdir()
        alpha = write_module_source(root, "alpha", "main", "example.alpha")
        beta = write_module_source(root, "beta", "main", "example.beta")
        write_module_source(root, "beta", "test", "example.alpha")
        write_module_source(root, "beta", "integrationTest", "example.alpha")
        write_module_source(root, "beta", "testFixtures", "example.alpha")
        write_module_source(root, "beta", "androidTest", "example.alpha")
        write_module_source(root, "beta", "debugAndroidTest", "example.alpha")
        write_module_source(root, "htsp-consumer-contract", "main", "example.alpha")
        write_module_source(root, "playback-consumer-contract", "main", "example.alpha")
        write_module_source(root, "protocol-consumer-contract", "main", "example.alpha")
        absent_source_module = root / "sdk" / "absent-source"
        absent_source_module.mkdir()
        (absent_source_module / "build.gradle.kts").write_text("// fixture\n", encoding="utf-8")
        if check(root):
            errors.append(
                "distinct production packages with test/fixture duplicates or absent src were rejected"
            )

        absent_source_marker = absent_source_module / "build.gradle.kts"
        absent_source_marker.unlink()
        expected_missing_module = (
            "sdk/absent-source: expected retained SDK module was not discovered"
        )
        if check(root) != [expected_missing_module]:
            errors.append("missing empty-package retained module was not rejected exactly")
        absent_source_marker.write_text("// fixture\n", encoding="utf-8")

        topology_drift = write_module_source(
            root,
            "protocol-consumer-contract-copy",
            "main",
            "example.alpha",
        )
        expected_fixture_drift = (
            "production package example.alpha is declared in SDK modules "
            "alpha, protocol-consumer-contract-copy"
        )
        if expected_fixture_drift not in check(root):
            errors.append("standalone fixture topology drift was not rejected exactly")
        topology_drift.unlink()
        topology_drift.parents[0].rmdir()
        topology_drift.parents[1].rmdir()
        topology_drift.parents[2].rmdir()
        topology_drift.parents[3].rmdir()
        (root / "sdk" / "protocol-consumer-contract-copy" / "build.gradle.kts").unlink()
        (root / "sdk" / "protocol-consumer-contract-copy").rmdir()

        contest = write_module_source(root, "beta", "contest", "example.alpha")
        expected_duplicate = (
            "production package example.alpha is declared in SDK modules alpha, beta"
        )
        if expected_duplicate not in check(root):
            errors.append("contest production source-set duplicate was not rejected exactly")
        contest.unlink()

        dangling_module = root / "sdk" / "dangling"
        dangling_module.mkdir()
        (dangling_module / "build.gradle.kts").write_text("// fixture\n", encoding="utf-8")
        dangling_src = dangling_module / "src"
        dangling_src.symlink_to(dangling_module / "missing-src")
        expected_dangling = "sdk/dangling/src: production source root must be one real directory"
        if expected_dangling not in check(root):
            errors.append("dangling production source-root symlink was not rejected exactly")
        dangling_src.unlink()
        (dangling_module / "build.gradle.kts").unlink()
        dangling_module.rmdir()

        alpha_source_root = root / "sdk" / "alpha" / "src"
        alpha_source_root.chmod(stat.S_IXUSR)
        expected_unreadable_root = "sdk/alpha/src: production source root must be readable"
        if expected_unreadable_root not in check(root):
            errors.append("unreadable production source root was not rejected exactly")
        alpha_source_root.chmod(stat.S_IRUSR | stat.S_IWUSR)
        expected_untraversable_root = "sdk/alpha/src: production source root must be traversable"
        if expected_untraversable_root not in check(root):
            errors.append("untraversable production source root was not rejected exactly")
        alpha_source_root.chmod(stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR)

        invalid_source_set = alpha_source_root / "not-a-source-set"
        invalid_source_set.write_text("not a directory\n", encoding="utf-8")
        expected_invalid_source_set = (
            "sdk/alpha/src/not-a-source-set: production source set must be one real directory"
        )
        if expected_invalid_source_set not in check(root):
            errors.append("non-directory production source-set entry was not rejected exactly")
        invalid_source_set.unlink()

        nested_source_directory = alpha.parent
        nested_relative = display(nested_source_directory, root)
        nested_source_directory.chmod(stat.S_IXUSR)
        expected_unreadable_directory = (
            f"{nested_relative}: production source directory must be readable"
        )
        if expected_unreadable_directory not in check(root):
            errors.append("unreadable nested production source directory was not rejected exactly")
        nested_source_directory.chmod(stat.S_IRUSR | stat.S_IWUSR)
        expected_untraversable_directory = (
            f"{nested_relative}: production source directory must be traversable"
        )
        if expected_untraversable_directory not in check(root):
            errors.append("untraversable nested production source directory was not rejected exactly")
        nested_source_directory.chmod(stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR)

        beta.write_text("package example.alpha\nclass Fixture\n", encoding="utf-8")
        duplicate_errors = check(root)
        if expected_duplicate not in duplicate_errors:
            errors.append("duplicate production package mutation was not rejected exactly")

        beta.write_text(
            "package example.beta\npackage example.other\nclass Fixture\n",
            encoding="utf-8",
        )
        if not any("exactly one unambiguous package" in error for error in check(root)):
            errors.append("multiple package declarations mutation was not rejected")

        beta.write_text("package example.beta\nclass Fixture\n", encoding="utf-8")
        alpha.chmod(0)
        if not any("production source must be readable" in error for error in check(root)):
            errors.append("unreadable production source mutation was not rejected")
        alpha.chmod(stat.S_IRUSR | stat.S_IWUSR)

        outside = root / "outside.kt"
        outside.write_text("package example.escape\nclass Escape\n", encoding="utf-8")
        escaped = alpha.parent / "Escaped.kt"
        escaped.symlink_to(outside)
        if not any("must not traverse a symlink" in error for error in check(root)):
            errors.append("symlinked production source mutation was not rejected")
        escaped.unlink()

        java = root / "sdk" / "alpha" / "src" / "main" / "java" / "example" / "Unicode.java"
        java.parent.mkdir(parents=True, exist_ok=True)
        java.write_text("p\\u0061ckage example.alpha; final class Unicode {}\n", encoding="utf-8")
        if check(root):
            errors.append("valid Java Unicode package declaration was rejected")

        java.unlink()
        alpha.unlink()
        missing_error = (
            "sdk/alpha: declared production package set mismatch; missing [example.alpha]"
        )
        if missing_error not in check(root):
            errors.append("missing declared package mutation was not rejected exactly")

        alpha.write_text("package example.alpha\nclass Fixture\n", encoding="utf-8")
        extra = alpha.parent / "Extra.kt"
        extra.write_text("package example.extra\nclass Extra\n", encoding="utf-8")
        extra_error = (
            "sdk/alpha: declared production package set mismatch; extra [example.extra]"
        )
        if extra_error not in check(root):
            errors.append("extra declared package mutation was not rejected exactly")
        extra.unlink()

        alpha.write_text("package example.beta\nclass Fixture\n", encoding="utf-8")
        beta.write_text("package example.alpha\nclass Fixture\n", encoding="utf-8")
        moved_alpha_error = (
            "sdk/alpha: declared production package set mismatch; "
            "missing [example.alpha]; extra [example.beta]"
        )
        moved_beta_error = (
            "sdk/beta: declared production package set mismatch; "
            "missing [example.beta]; extra [example.alpha]"
        )
        moved_errors = check(root)
        if moved_alpha_error not in moved_errors or moved_beta_error not in moved_errors:
            errors.append("moved module/package-set mutation was not rejected exactly")
    return errors


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        errors = self_test_errors()
        label = "Exact production package-set checker self-tests"
    elif not sys.argv[1:]:
        errors = standalone_package_errors(ROOT)
        label = "Exact production package-set check"
    else:
        print("usage: check-single-package-per-module [--self-test]", file=sys.stderr)
        return 2
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(f"{label} passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
