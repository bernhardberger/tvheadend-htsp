#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

if [ "${1-}" != "" ] && [ "${1-}" != "--non-gradle" ]; then
    echo "usage: ./tools/verify-htsp [--non-gradle]" >&2
    exit 2
fi

./tools/check-standalone-repository --self-test
./tools/check-standalone-repository
./tools/check-htsp-protocol-boundary --self-test
./tools/check-htsp-protocol-boundary
./tools/check-htsp-generated-drift --self-test
./tools/check-htsp-generated-drift
./tools/check-htsp-public-kdoc --self-test
./tools/check-htsp-public-kdoc
./tools/check-htsp-json-api-containment --self-test
./tools/check-htsp-json-api-containment
./tools/check-single-package-per-module --self-test
./tools/check-single-package-per-module
./tools/check-public-api-outcomes --self-test
./tools/check-public-api-outcomes
./tools/check-license-attribution --self-test
./tools/check-license-attribution

python3 docs/htsp-protocol/report.py --check
python3 docs/htsp-protocol/generate_typed_requests.py --self-test
python3 docs/htsp-protocol/generate_typed_request_models.py --self-test
python3 docs/htsp-protocol/generate_typed_server_messages.py --self-test
python3 docs/htsp-protocol/generate_typed_server_message_models.py --self-test

if [ "${1-}" = "--non-gradle" ]; then
    echo "HTSP non-Gradle verification passed."
    exit 0
fi

./gradlew --no-daemon clean test check checkLegacyAbi verifyClassMajor61 verifyProductionDependencyGraph
