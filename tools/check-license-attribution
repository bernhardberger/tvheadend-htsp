#!/usr/bin/env python3
"""Verify visible library licensing, lineage, and independence documentation."""

from __future__ import annotations

import posixpath
import re
import sys
from dataclasses import dataclass, replace
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
AUTHORITY_PATH = "docs/licensing.md"
ROOT_README_PATH = "README.md"
DOCUMENTATION_INDEX_PATH = "docs/README.md"
NOTICE_PATH = "NOTICE.md"

PREDECESSOR_URL = "https://github.com/Preclikos/tvhstream"
TVHEADEND_URL = "https://github.com/tvheadend/tvheadend"

GPL_STATEMENT = (
    "The combined HTSP library work is licensed under the GNU General Public License v3.0."
)
INDEPENDENCE_STATEMENT = (
    "The library is developed and maintained independently of the TVHeadend project."
)
NOT_WHOLLY_ORIGINAL_STATEMENT = (
    "It incorporates predecessor work and is not wholly original."
)
EXTRACTION_BOUNDARY_STATEMENT = (
    "The standalone repository begins with the HTSP protocol extraction baseline instead "
    "of embedding the predecessor application's unrelated Git history."
)


@dataclass(frozen=True)
class Documents:
    authority: str
    root_readme: str
    documentation_index: str
    notice: str


def markdown_fence(line: str) -> tuple[str, int, str] | None:
    candidate = line
    while True:
        candidate = candidate.lstrip(" \t")
        if candidate.startswith(">"):
            candidate = candidate[1:]
            continue
        list_marker = re.match(r"(?:[-+*]|[0-9]+[.)])[ \t]+", candidate)
        if list_marker is not None:
            candidate = candidate[list_marker.end():]
            continue
        break
    if not candidate or candidate[0] not in {"`", "~"}:
        return None
    marker = candidate[0]
    run_length = len(candidate) - len(candidate.lstrip(marker))
    if run_length < 3:
        return None
    remainder = candidate[run_length:]
    if marker == "`" and "`" in remainder:
        return None
    return marker, run_length, remainder


def is_indented_markdown_code(line: str) -> bool:
    candidate = line
    while True:
        leading_spaces = len(candidate) - len(candidate.lstrip(" "))
        prefix = candidate[:leading_spaces]
        remainder = candidate[leading_spaces:]
        if leading_spaces <= 3 and remainder.startswith(">"):
            candidate = remainder[1:]
            if candidate.startswith(" "):
                candidate = candidate[1:]
            continue
        if "\t" in prefix or leading_spaces >= 4:
            return bool(remainder)
        return remainder.startswith("\t")


def visible_markdown(document: str) -> str:
    without_comments = re.sub(r"(?s)<!--.*?(?:-->|\Z)", "", document)
    visible_lines: list[str] = []
    open_fence: tuple[str, int] | None = None
    for line in without_comments.splitlines():
        fence = markdown_fence(line)
        if open_fence is not None:
            if (
                fence is not None
                and fence[0] == open_fence[0]
                and fence[1] >= open_fence[1]
                and not fence[2].strip()
            ):
                open_fence = None
            continue
        if fence is not None:
            open_fence = fence[0], fence[1]
            continue
        if is_indented_markdown_code(line):
            continue
        visible_lines.append(line)
    return "\n".join(visible_lines)


def normalized_visible_markdown(document: str) -> str:
    return re.sub(r"\s+", " ", visible_markdown(document)).strip()


def resolved_link_target(source_path: str, target: str) -> str:
    target_without_fragment = target.split("#", 1)[0]
    if re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://", target_without_fragment):
        return target_without_fragment.rstrip("/")
    return posixpath.normpath(
        posixpath.join(posixpath.dirname(source_path), target_without_fragment),
    )


def visible_link_count(document: str, source_path: str, expected: str) -> int:
    link_pattern = re.compile(
        r"(?<!!)\[[^\]\n]+\]\(\s*([^\s)]+)"
        r"(?:\s+(?:\"[^\"]*\"|'[^']*'))?\s*\)",
    )
    return sum(
        resolved_link_target(source_path, match.group(1)) == expected
        for match in link_pattern.finditer(visible_markdown(document))
    )


def require_visible_link(
    errors: list[str],
    document: str,
    source_path: str,
    target: str,
    description: str,
    label: str,
) -> None:
    count = visible_link_count(document, source_path, target)
    if count != 1:
        errors.append(
            f"{label}: visible {description} links total {count}, expected 1",
        )


def require_visible_pattern(
    errors: list[str],
    normalized_document: str,
    pattern: str,
    description: str,
    label: str,
) -> None:
    if re.search(pattern, normalized_document, re.IGNORECASE) is None:
        errors.append(f"{label}: missing visible {description}")


def validate_documents(documents: Documents, label: str) -> list[str]:
    errors: list[str] = []
    visible_authority = visible_markdown(documents.authority)
    normalized_authority = normalized_visible_markdown(documents.authority)
    normalized_root = normalized_visible_markdown(documents.root_readme)
    normalized_notice = normalized_visible_markdown(documents.notice)

    headings = re.findall(r"(?m)^#{1,6} [^\n]+$", visible_authority)
    authority_heading = "# Licensing, attribution, and independence"
    heading_count = headings.count(authority_heading)
    if heading_count != 1:
        errors.append(
            f"{label}: expected visible heading {authority_heading!r} exactly once, "
            f"found {heading_count}",
        )

    authority_patterns = (
        (re.escape(GPL_STATEMENT), "GPLv3 license statement"),
        (
            r"license text controls; this summary does not replace it",
            "controlling-license boundary",
        ),
        (
            r"conveying covered library work.*keep intact applicable copyright, "
            r"license, and no-warranty notices.*give recipients a copy of GPLv3",
            "source-conveyance notice obligation",
        ),
        (
            r"modified source.*mark.*changed.*relevant date.*GPLv3",
            "modified-source obligation",
        ),
        (
            r"object code.*Corresponding Source.*method permitted by GPLv3",
            "object-code corresponding-source obligation",
        ),
        (
            r"independently maintained descendant of.*Preclikos/tvhstream",
            "TVHStream predecessor attribution",
        ),
        (re.escape(NOT_WHOLLY_ORIGINAL_STATEMENT), "not-wholly-original statement"),
        (
            re.escape(EXTRACTION_BOUNDARY_STATEMENT),
            "library extraction-history boundary",
        ),
        (re.escape(INDEPENDENCE_STATEMENT), "independence statement"),
        (
            r"not affiliated with, endorsed by, or sponsored by the TVHeadend project",
            "unaffiliated and unendorsed statement",
        ),
        (
            r"TVHeadend name describes compatibility only",
            "compatibility-name boundary",
        ),
    )
    for pattern, description in authority_patterns:
        require_visible_pattern(
            errors,
            normalized_authority,
            pattern,
            description,
            label,
        )

    root_patterns = (
        (r"independently maintained GPLv3", "root GPLv3 identity"),
        (
            r"not official TVHeadend software.*not affiliated with or endorsed by "
            r"the TVHeadend project",
            "root independence statement",
        ),
        (r"descends from.*Preclikos/tvhstream", "root predecessor attribution"),
        (
            re.escape(EXTRACTION_BOUNDARY_STATEMENT),
            "root library extraction-history boundary",
        ),
    )
    for pattern, description in root_patterns:
        require_visible_pattern(errors, normalized_root, pattern, description, label)

    notice_patterns = (
        (
            r"independently maintained GPLv3 software derived from.*Preclikos/tvhstream",
            "notice predecessor attribution",
        ),
        (
            r"not affiliated with, endorsed by, or sponsored by the.*Tvheadend project",
            "notice independence statement",
        ),
        (
            re.escape(EXTRACTION_BOUNDARY_STATEMENT),
            "notice library extraction-history boundary",
        ),
    )
    for pattern, description in notice_patterns:
        require_visible_pattern(errors, normalized_notice, pattern, description, label)

    authority_links = (
        ("LICENSE", "controlling LICENSE"),
        ("NOTICE.md", "NOTICE attribution"),
        (PREDECESSOR_URL, "predecessor attribution"),
        (TVHEADEND_URL, "TVHeadend project identity"),
    )
    for target, description in authority_links:
        require_visible_link(
            errors,
            documents.authority,
            AUTHORITY_PATH,
            target,
            description,
            label,
        )

    require_visible_link(
        errors,
        documents.root_readme,
        ROOT_README_PATH,
        AUTHORITY_PATH,
        "root licensing authority",
        label,
    )
    require_visible_link(
        errors,
        documents.documentation_index,
        DOCUMENTATION_INDEX_PATH,
        AUTHORITY_PATH,
        "documentation-index licensing authority",
        label,
    )
    require_visible_link(
        errors,
        documents.notice,
        NOTICE_PATH,
        PREDECESSOR_URL,
        "notice predecessor attribution",
        label,
    )
    require_visible_link(
        errors,
        documents.notice,
        NOTICE_PATH,
        TVHEADEND_URL,
        "notice TVHeadend project identity",
        label,
    )

    combined_visible = " ".join(
        (
            normalized_authority,
            normalized_root,
            normalized_visible_markdown(documents.documentation_index),
            normalized_notice,
        ),
    )
    contradictory_patterns = (
        (
            r"(?<!L)\bGPL(?:\s+version|\s*v|\s*[-])?\s*"
            r"(?:[0124-9])(?:\.\d+)?\b",
            "contradictory GPL version claim",
        ),
        (
            r"\bGNU\s+General\s+Public\s+License"
            r"(?:\s+version|\s*v)?\s*(?:[0124-9])(?:\.\d+)?\b",
            "contradictory GPL version claim",
        ),
        (
            r"\b(?:is|are)\s+(?:an?\s+)?official\s+TVHeadend\b",
            "contradictory official claim",
        ),
        (
            r"\b(?:is|are)\s+affiliated\s+with\s+(?:the\s+)?TVHeadend\b",
            "contradictory affiliation claim",
        ),
        (
            r"\b(?:is|are)\s+endorsed\s+by\s+(?:the\s+)?TVHeadend\b",
            "contradictory endorsement claim",
        ),
        (
            r"\b(?:is|are)\s+sponsored\s+by\s+(?:the\s+)?TVHeadend\b",
            "contradictory sponsorship claim",
        ),
        (r"\b(?:is|are)\s+wholly original\b", "contradictory originality claim"),
        (
            r"\b(?:preserves?|retains?)\s+(?:(?:the|that)\s+)?(?:complete\s+)?"
            r"(?:predecessor|project(?:'s)?)\s+Git history\b",
            "contradictory embedded-history claim",
        ),
        (
            r"\b(?:the\s+)?TVHeadend project\s+officially\s+"
            r"(?:develops|maintains|publishes|supports)\s+(?:this|the)\s+"
            r"(?:TVHeadend Player\s+)?(?:SDK|repository|project)\b",
            "contradictory active official claim",
        ),
        (
            r"\b(?:the\s+)?TVHeadend project\s+(?:officially\s+)?"
            r"affiliates(?:\s+itself)?\s+with\s+(?:this|the)\s+"
            r"(?:TVHeadend Player\s+)?(?:SDK|repository|project)\b",
            "contradictory active affiliation claim",
        ),
        (
            r"\b(?:the\s+)?TVHeadend project\s+(?:officially\s+)?"
            r"endorses\s+(?:this|the)\s+(?:TVHeadend Player\s+)?"
            r"(?:SDK|repository|project)\b",
            "contradictory active endorsement claim",
        ),
        (
            r"\b(?:the\s+)?TVHeadend project\s+(?:officially\s+)?"
            r"sponsors\s+(?:this|the)\s+(?:TVHeadend Player\s+)?"
            r"(?:SDK|repository|project)\b",
            "contradictory active sponsorship claim",
        ),
    )
    for pattern, description in contradictory_patterns:
        if re.search(pattern, combined_visible, re.IGNORECASE):
            errors.append(f"{label}: contains {description}")
    return errors


def verify_mutation_coverage(documents: Documents, errors: list[str]) -> None:
    mutations: list[tuple[str, Documents, str]] = []

    def mutate_authority(
        name: str,
        old: str,
        new: str,
        required_error: str,
    ) -> None:
        mutated = documents.authority.replace(old, new, 1)
        if mutated == documents.authority:
            errors.append(f"governance self-test could not create {name}")
            return
        mutations.append(
            (name, replace(documents, authority=mutated), required_error),
        )

    mutate_authority(
        "missing GPLv3 claim",
        GPL_STATEMENT,
        "",
        "GPLv3 license statement",
    )
    mutate_authority(
        "stale GPL version",
        "GNU General Public License v3.0",
        "GNU General Public License v2.0",
        "GPLv3 license statement",
    )
    mutate_authority(
        "stale predecessor link",
        PREDECESSOR_URL,
        "https://github.com/example/tvhstream",
        "predecessor attribution links total 0",
    )
    mutate_authority(
        "comment-hidden independence claim",
        INDEPENDENCE_STATEMENT,
        f"<!-- {INDEPENDENCE_STATEMENT} -->",
        "independence statement",
    )
    mutate_authority(
        "fence-only originality claim",
        NOT_WHOLLY_ORIGINAL_STATEMENT,
        f"```text\n{NOT_WHOLLY_ORIGINAL_STATEMENT}\n```",
        "not-wholly-original statement",
    )
    mutations.append(
        (
            "contradictory official claim",
            replace(
                documents,
                authority=(
                    documents.authority
                    + "\nTVHeadend Player SDK is official TVHeadend software.\n"
                ),
            ),
            "contradictory official claim",
        ),
    )
    contradiction_mutations = (
        (
            "contradictory GPL version claim",
        "The combined HTSP library work is licensed under GPLv2 only.",
            "contradictory GPL version claim",
        ),
        (
            "contradictory active official claim",
            "The TVHeadend project officially develops this SDK.",
            "contradictory active official claim",
        ),
        (
            "contradictory active affiliation claim",
            "The TVHeadend project affiliates itself with this SDK.",
            "contradictory active affiliation claim",
        ),
        (
            "contradictory active endorsement claim",
            "The TVHeadend project officially endorses this SDK.",
            "contradictory active endorsement claim",
        ),
        (
            "contradictory active sponsorship claim",
            "The TVHeadend project sponsors this SDK.",
            "contradictory active sponsorship claim",
        ),
        (
            "contradictory embedded-history claim",
            "The standalone repository preserves the complete predecessor Git history.",
            "contradictory embedded-history claim",
        ),
    )
    for name, claim, required_error in contradiction_mutations:
        mutations.append(
            (
                name,
                replace(documents, authority=documents.authority + f"\n{claim}\n"),
                required_error,
            ),
        )

    predecessor_link = f"[Preclikos/tvhstream]({PREDECESSOR_URL})"
    hidden_predecessor_link = (
        "Preclikos/tvhstream\n"
        f"<!-- {predecessor_link} -->"
    )
    mutate_authority(
        "comment-hidden predecessor attribution link",
        predecessor_link,
        hidden_predecessor_link,
        "predecessor attribution links total 0",
    )

    for name, mutated_documents, required_error in mutations:
        mutation_errors = validate_documents(
            mutated_documents,
            f"synthetic {name}",
        )
        if not any(required_error in error for error in mutation_errors):
            errors.append(
                f"governance self-test accepted {name} without "
                f"{required_error!r}",
            )


def read_documents(errors: list[str]) -> Documents:
    contents: dict[str, str] = {}
    for path in (
        AUTHORITY_PATH,
        ROOT_README_PATH,
        DOCUMENTATION_INDEX_PATH,
        NOTICE_PATH,
    ):
        candidate = ROOT / path
        try:
            contents[path] = candidate.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            errors.append(f"{path}: unable to read required document: {error}")
            contents[path] = ""
    return Documents(
        authority=contents[AUTHORITY_PATH],
        root_readme=contents[ROOT_README_PATH],
        documentation_index=contents[DOCUMENTATION_INDEX_PATH],
        notice=contents[NOTICE_PATH],
    )


def main() -> int:
    if sys.argv[1:] not in ([], ["--self-test"]):
        print("usage: check-license-attribution [--self-test]", file=sys.stderr)
        return 2
    errors: list[str] = []
    documents = read_documents(errors)
    errors.extend(validate_documents(documents, "current documentation"))
    verify_mutation_coverage(documents, errors)

    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1

    label = " hostile self-tests" if sys.argv[1:] else " governance"
    print(
        f"Licensing and attribution{label} passed: visible GPLv3 obligations, "
        "TVHStream lineage, and independent TVHeadend identity",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
