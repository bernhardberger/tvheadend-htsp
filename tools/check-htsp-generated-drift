    expect_rejection("wrong minimum version", "minVersion=None", references=(replace(reference, minimum_version=None),))
    expect_rejection("absent needed waiver", "spec is missing", references=(replace(reference, wire_name="legacy"),))
    expect_rejection("unused waiver", "unused waiver", waivers=((reference.identity, "not needed"),))
    expect_rejection(
        "blank waiver reason",
