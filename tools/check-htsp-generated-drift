#!/usr/bin/env python3
"""Fail closed when checked-in HTSP generated sources drift from their catalogs."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
GENERATORS = (
    "docs/htsp-protocol/generate_typed_requests.py",
    "docs/htsp-protocol/generate_typed_request_models.py",
    "docs/htsp-protocol/generate_typed_server_messages.py",
    "docs/htsp-protocol/generate_typed_server_message_models.py",
)


def main() -> int:
    errors: list[str] = []
    for relative in GENERATORS:
        generator = ROOT / relative
        if not generator.is_file() or generator.is_symlink():
            errors.append(f"required generator must be a regular file: {relative}")
            continue
        for mode in ("--self-test", "--check"):
            completed = subprocess.run(
                [sys.executable, str(generator), mode],
                cwd=ROOT,
                check=False,
                capture_output=True,
                text=True,
            )
            if completed.returncode != 0:
                detail = (completed.stderr or completed.stdout).strip()
                errors.append(f"{relative} {mode} failed: {detail or completed.returncode}")
    if errors:
        for error in errors:
            print(f"error: {error}", file=sys.stderr)
        return 1
    print("HTSP generated-source drift check passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
