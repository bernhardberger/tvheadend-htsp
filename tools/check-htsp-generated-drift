    malformed = copy.deepcopy(spec)
    malformed["clientMethods"][0]["requestFields"][0]["name"] = 3
    expect_rejection("malformed spec record", "malformed field identity", mutated_spec=malformed)
    ambiguous = copy.deepcopy(spec)
    ambiguous["clientMethods"].append(copy.deepcopy(ambiguous["clientMethods"][0]))
    expect_rejection("ambiguous spec identity", "ambiguous identity", mutated_spec=ambiguous)

    def field(owner: str, name: str, *wire_names: str, decoder: str = "u32", nested_shape=None):
        return SimpleNamespace(
            owner=owner,
            kotlin_property=name,
            wire_names=tuple(wire_names),
