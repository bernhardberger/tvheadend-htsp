def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args(argv)
    if args.self_test:
        self_test()
        print("HTSP generated-source drift checker self-test passed")
        return 0

    errors: list[str] = []
    if Path(__file__).is_symlink():
        errors.append("drift checker must be invoked from a regular non-symlink file")
    try:
        self_test()
        check_spec_consistency()
        validate_generated_outputs(ROOT)
    except (AssertionError, ImportError, ValueError) as error:
        errors.append(str(error))
    if errors:
        for error in errors:
            print(f"error: {error}", file=sys.stderr)
        return 1
    projection = projected_generator_root()
    projected_root = Path(projection.name)
    for relative in GENERATORS:
        generator = ROOT / relative
        if not generator.is_file() or generator.is_symlink():
            errors.append(f"required generator must be a regular file: {relative}")
            continue
        for mode in ("--self-test", "--check"):
            execution_root = ROOT if mode == "--self-test" else projected_root
            execution_generator = execution_root / relative
            completed = subprocess.run(
                [sys.executable, str(execution_generator), mode],
                cwd=execution_root,
                check=False,
                capture_output=True,
                text=True,
            )
            if completed.returncode != 0:
                detail = (completed.stderr or completed.stdout).strip()
                errors.append(f"{relative} {mode} failed: {detail or completed.returncode}")
    projection.cleanup()
    if errors:
        for error in errors:
            print(f"error: {error}", file=sys.stderr)
        return 1
    print("HTSP generated-source drift check passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
