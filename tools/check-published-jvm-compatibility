#!/usr/bin/env python3
"""Verify the one checkout-local standalone HTSP Maven publication."""

from __future__ import annotations

import copy
import hashlib
import json
import re
import struct
import sys
import tempfile
import zipfile
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
REPOSITORY = ROOT / "build/local-maven"
GROUP = "at.bernhardberger.tvheadend"
ARTIFACT = "htsp"
ALLOWED_VERSIONS = {"0.1.0-alpha.1-SNAPSHOT", "0.1.0-alpha.1"}


def configured_version() -> str:
    try:
        text = (ROOT / "build.gradle.kts").read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return ""
    matches = re.findall(r'^version = "([^"]+)"$', text, re.M)
    return matches[0] if len(matches) == 1 else ""


VERSION = configured_version()
RELEASE_BASE = VERSION.removesuffix("-SNAPSHOT")
JVM_VERSION = 17
CLASS_MAJOR = 61
PROJECT_URL = "https://github.com/bernhardberger/tvheadend-htsp"
ISSUES_URL = f"{PROJECT_URL}/issues"
SCM = f"scm:git:{PROJECT_URL}.git"
SCM_DEVELOPER = "scm:git:ssh://git@github.com/bernhardberger/tvheadend-htsp.git"
GPL_NAME = "GNU General Public License v3.0"
GPL_URL = "https://www.gnu.org/licenses/gpl-3.0.html"
DEVELOPER = {"id": "bernhardberger", "name": "Bernhard Berger", "url": "https://github.com/bernhardberger"}
PROPERTIES = {
    "tvheadend.htsp.predecessor.name": "TVHStream",
    "tvheadend.htsp.predecessor.url": "https://github.com/Preclikos/tvhstream",
    "tvheadend.htsp.notice.path": "NOTICE.md",
}
POM_DEPENDENCIES = {
    ("org.jetbrains.kotlin", "kotlin-stdlib", "2.3.10"),
    ("org.jetbrains.kotlinx", "kotlinx-coroutines-core-jvm", "1.10.2"),
}
MODULE_DEPENDENCIES = {
    ("org.jetbrains.kotlin", "kotlin-stdlib", "2.3.10"),
    ("org.jetbrains.kotlinx", "kotlinx-coroutines-core", "1.10.2"),
}
FORBIDDEN_TEXT = re.compile(r"android|media3|decoder|\.aar\b|\.so\b|com\.android", re.IGNORECASE)
KINDS = {
    "pom": ("pom", None),
    "module": ("module", None),
    "main": ("jar", None),
    "sources": ("jar", "sources"),
    "javadoc": ("jar", "javadoc"),
}


@dataclass(frozen=True)
class ResolvedPublication:
    files: dict[str, Path]
    snapshot_value: str


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def local_name(tag: str) -> str:
    return tag.rsplit("}", 1)[-1]


def children(parent: ET.Element, name: str) -> list[ET.Element]:
    return [child for child in parent if local_name(child.tag) == name]


def one_child(parent: ET.Element, name: str, label: str, errors: list[str]) -> ET.Element | None:
    found = children(parent, name)
    if len(found) != 1:
        errors.append(f"{label}: expected exactly one <{name}>, found {len(found)}")
        return None
    return found[0]


def one_text(parent: ET.Element, name: str, label: str, errors: list[str]) -> str | None:
    node = one_child(parent, name, label, errors)
    if node is None:
        return None
    value = (node.text or "").strip()
    if not value:
        errors.append(f"{label}: <{name}> is empty")
        return None
    return value


def parse_xml(path: Path, label: str, errors: list[str]) -> ET.Element | None:
    try:
        return ET.parse(path).getroot()
    except (OSError, ET.ParseError) as error:
        errors.append(f"{label}: malformed XML: {error}")
        return None


def reject_symlinks(root: Path, errors: list[str]) -> None:
    if root.is_symlink():
        errors.append(f"publication repository must not be a symlink: {root}")
        return
    if not root.is_dir():
        return
    for path in root.rglob("*"):
        if path.is_symlink():
            errors.append(f"publication repository contains symlink/escape: {path.relative_to(root)}")


def snapshot_entries(metadata: ET.Element, errors: list[str]) -> tuple[dict[tuple[str, str | None], str], str]:
    label = "snapshot metadata"
    for name, expected in (("groupId", GROUP), ("artifactId", ARTIFACT), ("version", VERSION)):
        actual = one_text(metadata, name, label, errors)
        if actual is not None and actual != expected:
            errors.append(f"{label}: {name} is {actual!r}, expected {expected!r}")
    versioning = one_child(metadata, "versioning", label, errors)
    if versioning is None:
        return {}, ""
    snapshot = one_child(versioning, "snapshot", label, errors)
    versions = one_child(versioning, "snapshotVersions", label, errors)
    if snapshot is None or versions is None:
        return {}, ""
    timestamp = one_text(snapshot, "timestamp", label, errors) or ""
    build_number = one_text(snapshot, "buildNumber", label, errors) or ""
    if not re.fullmatch(r"\d{8}\.\d{6}", timestamp):
        errors.append(f"{label}: invalid timestamp {timestamp!r}")
    if not re.fullmatch(r"[1-9]\d*", build_number):
        errors.append(f"{label}: invalid build number {build_number!r}")
    expected_value = f"{RELEASE_BASE}-{timestamp}-{build_number}"
    entries: dict[tuple[str, str | None], str] = {}
    for index, entry in enumerate(children(versions, "snapshotVersion")):
        entry_label = f"{label} entry {index}"
        extension = one_text(entry, "extension", entry_label, errors)
        value = one_text(entry, "value", entry_label, errors)
        classifiers = children(entry, "classifier")
        if len(classifiers) > 1:
            errors.append(f"{entry_label}: duplicate classifier")
            continue
        classifier = (classifiers[0].text or "").strip() if classifiers else None
        if classifiers and not classifier:
            errors.append(f"{entry_label}: empty classifier")
            continue
        if extension is None or value is None:
            continue
        key = (extension, classifier)
        if key in entries:
            errors.append(f"{entry_label}: duplicate artifact entry {key}")
        entries[key] = value
        if value != expected_value:
            errors.append(f"{entry_label}: snapshot value {value!r} does not match {expected_value!r}")
    if set(entries) != set(KINDS.values()):
        errors.append(f"{label}: artifact entries {sorted(map(str, entries))} do not match the five required entries")
    return entries, expected_value


def resolve_publication(repository: Path, errors: list[str]) -> ResolvedPublication | None:
    if VERSION not in ALLOWED_VERSIONS:
        errors.append(f"publication version must be exactly one of {sorted(ALLOWED_VERSIONS)}: {VERSION!r}")
        return None
    expected = REPOSITORY.absolute()
    if repository.absolute() != expected:
        errors.append(f"publication repository must be exactly {expected}")
        return None
    for component in (ROOT / "build", repository):
        if component.is_symlink():
            errors.append(f"publication path must not traverse symlink: {component}")
            return None
    if not repository.is_dir():
        errors.append(f"published repository is missing: {repository}")
        return None
    reject_symlinks(repository, errors)
    group_dir = repository.joinpath(*GROUP.split("."))
    module_dir = group_dir / ARTIFACT
    version_dir = module_dir / VERSION
    if not version_dir.is_dir():
        errors.append(f"published version directory is missing: {version_dir}")
        return None
    if not group_dir.is_dir() or {path.name for path in group_dir.iterdir() if path.is_dir()} != {ARTIFACT}:
        errors.append("published group must contain exactly the htsp module")
    current = repository
    for component in GROUP.split("."):
        entries_at_level = list(current.iterdir()) if current.is_dir() else []
        directories_at_level = {path.name for path in entries_at_level if path.is_dir()}
        files_at_level = {path.name for path in entries_at_level if path.is_file()}
        if directories_at_level != {component} or files_at_level:
            errors.append(
                f"publication group path level {current}: expected only directory "
                f"{component!r}, found directories={sorted(directories_at_level)}, "
                f"files={sorted(files_at_level)}",
            )
        current /= component
    module_entries = list(module_dir.iterdir()) if module_dir.is_dir() else []
    module_directories = {path.name for path in module_entries if path.is_dir()}
    module_files = {path.name for path in module_entries if path.is_file()}
    allowed_module_files = {
        "maven-metadata.xml",
        "maven-metadata.xml.md5",
        "maven-metadata.xml.sha1",
        "maven-metadata.xml.sha256",
        "maven-metadata.xml.sha512",
    }
    if module_directories != {VERSION} or not module_files <= allowed_module_files:
        errors.append(
            "publication module topology mismatch: "
            f"directories={sorted(module_directories)}, files={sorted(module_files)}",
        )
    files: dict[str, Path] = {}
    snapshot_value = VERSION
    metadata_name: str | None = None
    entries: dict[tuple[str, str | None], str] = {}
    if VERSION.endswith("-SNAPSHOT"):
        metadata_name = "maven-metadata.xml"
        metadata = parse_xml(version_dir / metadata_name, "snapshot metadata", errors)
        if metadata is None:
            return None
        entries, snapshot_value = snapshot_entries(metadata, errors)
    for kind, key in KINDS.items():
        extension, classifier = key
        value = entries.get(key, snapshot_value)
        suffix = f"-{classifier}" if classifier else ""
        path = version_dir / f"{ARTIFACT}-{value}{suffix}.{extension}"
        if not path.is_file() or path.is_symlink():
            errors.append(f"{kind}: required regular artifact is missing: {path.name}")
            continue
        files[kind] = path

    allowed_primary = {path.name for path in files.values()}
    if metadata_name is not None:
        allowed_primary.add(metadata_name)
    allowed_sidecars = {f"{name}.{algorithm}" for name in allowed_primary for algorithm in ("md5", "sha1", "sha256", "sha512")}
    actual = {path.name for path in version_dir.iterdir() if path.is_file()}
    extras = actual - allowed_primary - allowed_sidecars
    if extras:
        errors.append(f"published version contains extra files: {sorted(extras)}")
    directories = [path.name for path in version_dir.iterdir() if path.is_dir()]
    if directories:
        errors.append(f"published version contains extra directories: {sorted(directories)}")
    return ResolvedPublication(files, snapshot_value)


def checksum_errors(resolved: ResolvedPublication) -> list[str]:
    errors: list[str] = []
    for kind in KINDS:
        artifact = resolved.files.get(kind)
        if artifact is None:
            continue
        sidecar = artifact.with_name(artifact.name + ".sha256")
        if not sidecar.is_file() or sidecar.is_symlink():
            errors.append(f"{kind}: missing regular SHA-256 sidecar")
            continue
        try:
            value = sidecar.read_bytes()
        except OSError as error:
            errors.append(f"{kind}: unreadable SHA-256 sidecar: {error}")
            continue
        expected = (sha256(artifact) + "\n").encode("ascii")
        if value == expected:
            continue
        try:
            text = value.decode("ascii")
        except UnicodeError:
            text = ""
        if not re.fullmatch(r"[0-9a-f]{64}\n", text):
            errors.append(
                f"{kind}: malformed SHA-256 sidecar; expected exact lowercase digest and final newline",
            )
        else:
            errors.append(f"{kind}: SHA-256 sidecar does not match artifact bytes")
    return errors


def pom_errors(path: Path) -> list[str]:
    errors: list[str] = []
    root = parse_xml(path, "POM", errors)
    if root is None:
        return errors
    expected_text = {
        "modelVersion": "4.0.0", "groupId": GROUP, "artifactId": ARTIFACT,
        "version": VERSION, "name": "HTSP for Kotlin/JVM",
        "description": "A standalone Kotlin/JVM client library for the TVHeadend HTSP protocol.",
        "url": PROJECT_URL,
    }
    for name, expected in expected_text.items():
        actual = one_text(root, name, "POM", errors)
        if actual is not None and actual != expected:
            errors.append(f"POM: {name} is {actual!r}, expected {expected!r}")
    licenses = one_child(root, "licenses", "POM", errors)
    if licenses is not None:
        values = children(licenses, "license")
        if len(values) != 1:
            errors.append(f"POM: expected one license, found {len(values)}")
        elif {name: one_text(values[0], name, "POM license", errors) for name in ("name", "url", "distribution")} != {
            "name": GPL_NAME, "url": GPL_URL, "distribution": "repo"
        }:
            errors.append("POM: GPLv3 license metadata mismatch")
    developers = one_child(root, "developers", "POM", errors)
    if developers is not None:
        values = children(developers, "developer")
        if len(values) != 1:
            errors.append(f"POM: expected one developer, found {len(values)}")
        elif {name: one_text(values[0], name, "POM developer", errors) for name in DEVELOPER} != DEVELOPER:
            errors.append("POM: developer metadata mismatch")
    scm = one_child(root, "scm", "POM", errors)
    if scm is not None:
        actual = {name: one_text(scm, name, "POM SCM", errors) for name in ("connection", "developerConnection", "url")}
        expected = {"connection": SCM, "developerConnection": SCM_DEVELOPER, "url": PROJECT_URL}
        tags = children(scm, "tag")
        tag = "HEAD"
        if len(tags) > 1:
            errors.append(f"POM SCM: expected at most one <tag>, found {len(tags)}")
            tag = None
        elif tags:
            tag = (tags[0].text or "").strip()
            if not tag:
                errors.append("POM SCM: <tag> is empty")
        if actual != expected or tag != "HEAD":
            errors.append("POM: SCM metadata mismatch")
    issues = one_child(root, "issueManagement", "POM", errors)
    if issues is not None:
        if {name: one_text(issues, name, "POM issues", errors) for name in ("system", "url")} != {"system": "GitHub Issues", "url": ISSUES_URL}:
            errors.append("POM: issue-management metadata mismatch")
    properties = one_child(root, "properties", "POM", errors)
    if properties is not None:
        actual = {local_name(child.tag): (child.text or "").strip() for child in properties}
        if actual != PROPERTIES:
            errors.append(f"POM: predecessor/notice properties mismatch: {actual}")
    dependency_root = one_child(root, "dependencies", "POM", errors)
    actual_dependencies: set[tuple[str, str, str]] = set()
    if dependency_root is not None:
        for dependency in children(dependency_root, "dependency"):
            scope = one_text(dependency, "scope", "POM dependency", errors)
            item = tuple(one_text(dependency, name, "POM dependency", errors) or "" for name in ("groupId", "artifactId", "version"))
            if scope != "compile":
                errors.append(f"POM: dependency {item} has non-compile scope {scope!r}")
            actual_dependencies.add(item)
    if actual_dependencies != POM_DEPENDENCIES:
        errors.append(f"POM: dependencies {sorted(actual_dependencies)} do not match {sorted(POM_DEPENDENCIES)}")
    serialized = ET.tostring(root, encoding="unicode")
    if FORBIDDEN_TEXT.search(serialized):
        errors.append("POM: Android, Media3, decoder, or native metadata is forbidden")
    return errors


def mapping(value: Any, label: str, errors: list[str]) -> dict[str, Any] | None:
    if not isinstance(value, dict) or not all(isinstance(key, str) for key in value):
        errors.append(f"{label}: expected JSON object with string keys")
        return None
    return value


def module_errors(path: Path) -> list[str]:
    errors: list[str] = []
    try:
        model = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        return [f"module metadata: malformed JSON: {error}"]
    root = mapping(model, "module metadata", errors)
    if root is None:
        return errors
    if root.get("formatVersion") != "1.1":
        errors.append("module metadata: formatVersion must be 1.1")
    component = mapping(root.get("component"), "module component", errors)
    if component is not None:
        actual = {name: component.get(name) for name in ("group", "module", "version")}
        if actual != {"group": GROUP, "module": ARTIFACT, "version": VERSION}:
            errors.append(f"module metadata: wrong component {actual}")
    variants = root.get("variants")
    if not isinstance(variants, list):
        return errors + ["module metadata: variants must be an array"]
    by_name: dict[str, dict[str, Any]] = {}
    for index, value in enumerate(variants):
        variant = mapping(value, f"module variant {index}", errors)
        if variant is None:
            continue
        name = variant.get("name")
        if not isinstance(name, str) or name in by_name:
            errors.append(f"module metadata: missing or duplicate variant name {name!r}")
            continue
        by_name[name] = variant
    expected_names = {"apiElements", "runtimeElements", "sourcesElements", "javadocElements"}
    if set(by_name) != expected_names:
        errors.append(f"module metadata: variants {sorted(by_name)} do not match {sorted(expected_names)}")
    for name in expected_names & set(by_name):
        variant = by_name[name]
        attributes = mapping(variant.get("attributes"), f"module variant {name} attributes", errors)
        if attributes is None:
            continue
        files = variant.get("files")
        if not isinstance(files, list) or len(files) != 1 or not isinstance(files[0], dict):
            errors.append(f"module variant {name}: expected exactly one file")
        else:
            classifier = "-sources" if name == "sourcesElements" else "-javadoc" if name == "javadocElements" else ""
            expected_file = f"{ARTIFACT}-{VERSION}{classifier}.jar"
            if files[0].get("name") != expected_file or files[0].get("url") != expected_file:
                errors.append(f"module variant {name}: published file must be {expected_file}")
        if name in {"apiElements", "runtimeElements"}:
            if attributes.get("org.gradle.category") != "library" or attributes.get("org.gradle.jvm.version") != JVM_VERSION:
                errors.append(f"module variant {name}: must advertise JVM library version {JVM_VERSION}")
            actual_dependencies: set[tuple[str, str, str]] = set()
            dependencies = variant.get("dependencies")
            if not isinstance(dependencies, list):
                errors.append(f"module variant {name}: dependencies must be an array")
            else:
                for dependency in dependencies:
                    item = mapping(dependency, f"module variant {name} dependency", errors)
                    if item is None:
                        continue
                    version = mapping(item.get("version"), f"module variant {name} dependency version", errors)
                    actual_dependencies.add((str(item.get("group")), str(item.get("module")), str(version.get("requires")) if version else ""))
            if actual_dependencies != MODULE_DEPENDENCIES:
                errors.append(f"module variant {name}: dependencies {sorted(actual_dependencies)} do not match {sorted(MODULE_DEPENDENCIES)}")
        else:
            expected_docs_type = "sources" if name == "sourcesElements" else "javadoc"
            if attributes.get("org.gradle.category") != "documentation" or attributes.get("org.gradle.docstype") != expected_docs_type:
                errors.append(f"module variant {name}: documentation attributes mismatch")
            if variant.get("dependencies") not in (None, []):
                errors.append(f"module variant {name}: documentation artifact must have no dependencies")
    if FORBIDDEN_TEXT.search(json.dumps(model, sort_keys=True)):
        errors.append("module metadata: Android, Media3, decoder, or native metadata is forbidden")
    return errors


def archive_errors(kind: str, path: Path) -> list[str]:
    errors: list[str] = []
    try:
        with zipfile.ZipFile(path) as archive:
            names = archive.namelist()
            if len(names) != len(set(names)):
                errors.append(f"{kind}: archive contains duplicate entries")
            forbidden = [name for name in names if re.search(r"(?i)\.(?:so|aar|dll|dylib|exe)$", name)]
            if forbidden:
                errors.append(f"{kind}: archive contains compiled/native binaries: {forbidden}")
            for required in ("META-INF/LICENSE", "META-INF/NOTICE.md"):
                if names.count(required) != 1:
                    errors.append(f"{kind}: archive must contain exactly one {required}")
            if names.count("META-INF/LICENSE") == 1 and "GNU GENERAL PUBLIC LICENSE" not in archive.read("META-INF/LICENSE").decode("utf-8", "replace"):
                errors.append(f"{kind}: archived LICENSE does not contain GPLv3 evidence")
            if names.count("META-INF/NOTICE.md") == 1 and "Preclikos/tvhstream" not in archive.read("META-INF/NOTICE.md").decode("utf-8", "replace"):
                errors.append(f"{kind}: archived NOTICE lacks predecessor evidence")
            classes = [name for name in names if name.endswith(".class")]
            if kind == "main":
                if not classes:
                    errors.append("main: archive contains no JVM classes")
                for name in classes:
                    if not name.startswith("at/bernhardberger/tvheadend/htsp/"):
                        errors.append(f"main: class lies outside the standalone HTSP package root: {name}")
                    data = archive.read(name)
                    if len(data) < 8 or data[:4] != b"\xca\xfe\xba\xbe":
                        errors.append(f"main: malformed class header: {name}")
                    elif struct.unpack(">H", data[6:8])[0] != CLASS_MAJOR:
                        errors.append(f"main: {name} is not class major {CLASS_MAJOR}")
            elif classes:
                errors.append(f"{kind}: documentation/source archive contains class files")
            kotlin_sources = [name for name in names if name.endswith(".kt")]
            if kind == "sources" and len(kotlin_sources) != 24:
                errors.append(f"sources: expected 24 Kotlin sources, found {len(kotlin_sources)}")
            if kind == "javadoc" and kotlin_sources:
                errors.append("javadoc: documentation archive contains Kotlin source")
    except (OSError, zipfile.BadZipFile) as error:
        errors.append(f"{kind}: malformed ZIP/JAR: {error}")
    return errors


def semantic_manifest(resolved: ResolvedPublication) -> dict[str, str]:
    return {kind: sha256(resolved.files[kind]) for kind in sorted(KINDS) if kind in resolved.files}


def verify(repository: Path = REPOSITORY) -> tuple[list[str], dict[str, str]]:
    errors: list[str] = []
    resolved = resolve_publication(repository, errors)
    if resolved is None:
        return errors, {}
    errors.extend(checksum_errors(resolved))
    if "pom" in resolved.files:
        errors.extend(pom_errors(resolved.files["pom"]))
    if "module" in resolved.files:
        errors.extend(module_errors(resolved.files["module"]))
    for kind in ("main", "sources", "javadoc"):
        if kind in resolved.files:
            errors.extend(archive_errors(kind, resolved.files[kind]))
    return sorted(set(errors)), semantic_manifest(resolved)


def pom_text() -> str:
    dependencies = "".join(f"<dependency><groupId>{group}</groupId><artifactId>{module}</artifactId><version>{version}</version><scope>compile</scope></dependency>" for group, module, version in sorted(POM_DEPENDENCIES))
    properties = "".join(f"<{name}>{value}</{name}>" for name, value in PROPERTIES.items())
    return f"""<project><modelVersion>4.0.0</modelVersion><groupId>{GROUP}</groupId><artifactId>{ARTIFACT}</artifactId><version>{VERSION}</version><name>HTSP for Kotlin/JVM</name><description>A standalone Kotlin/JVM client library for the TVHeadend HTSP protocol.</description><url>{PROJECT_URL}</url><licenses><license><name>{GPL_NAME}</name><url>{GPL_URL}</url><distribution>repo</distribution></license></licenses><developers><developer><id>{DEVELOPER['id']}</id><name>{DEVELOPER['name']}</name><url>{DEVELOPER['url']}</url></developer></developers><scm><connection>{SCM}</connection><developerConnection>{SCM_DEVELOPER}</developerConnection><url>{PROJECT_URL}</url></scm><issueManagement><system>GitHub Issues</system><url>{ISSUES_URL}</url></issueManagement><properties>{properties}</properties><dependencies>{dependencies}</dependencies></project>"""


def module_model() -> dict[str, Any]:
    dependencies = [{"group": group, "module": module, "version": {"requires": version}} for group, module, version in sorted(MODULE_DEPENDENCIES)]
    variants: list[dict[str, Any]] = []
    for name in ("apiElements", "runtimeElements"):
        variants.append({"name": name, "attributes": {"org.gradle.category": "library", "org.gradle.jvm.version": JVM_VERSION}, "dependencies": copy.deepcopy(dependencies), "files": [{"name": f"{ARTIFACT}-{VERSION}.jar", "url": f"{ARTIFACT}-{VERSION}.jar"}]})
    for name, classifier in (("sourcesElements", "sources"), ("javadocElements", "javadoc")):
        variants.append({"name": name, "attributes": {"org.gradle.category": "documentation", "org.gradle.docstype": classifier}, "files": [{"name": f"{ARTIFACT}-{VERSION}-{classifier}.jar", "url": f"{ARTIFACT}-{VERSION}-{classifier}.jar"}]})
    return {"formatVersion": "1.1", "component": {"group": GROUP, "module": ARTIFACT, "version": VERSION}, "variants": variants}


def write_jar(path: Path, kind: str, wrong_major: bool = False) -> None:
    with zipfile.ZipFile(path, "w") as archive:
        archive.writestr("META-INF/LICENSE", "GNU GENERAL PUBLIC LICENSE Version 3")
        archive.writestr("META-INF/NOTICE.md", "Derived from Preclikos/tvhstream")
        if kind == "main":
            major = 60 if wrong_major else CLASS_MAJOR
            archive.writestr("at/bernhardberger/tvheadend/htsp/wire/Synthetic.class", b"\xca\xfe\xba\xbe\x00\x00" + struct.pack(">H", major))
        elif kind == "sources":
            for index in range(24):
                archive.writestr(f"at/bernhardberger/tvheadend/htsp/wire/S{index}.kt", "package synthetic")
        else:
            archive.writestr("docs/index.md", "documentation")


def create_fixture(root: Path, version: str = "0.1.0-alpha.1-SNAPSHOT") -> Path:
    global VERSION, RELEASE_BASE
    VERSION = version
    RELEASE_BASE = VERSION.removesuffix("-SNAPSHOT")
    repository = root / "build/local-maven"
    version_dir = repository.joinpath(*GROUP.split("."), ARTIFACT, VERSION)
    version_dir.mkdir(parents=True)
    timestamp = "20260816.120000"
    snapshot = f"{RELEASE_BASE}-{timestamp}-1" if VERSION.endswith("-SNAPSHOT") else VERSION
    files = {
        "pom": version_dir / f"{ARTIFACT}-{snapshot}.pom",
        "module": version_dir / f"{ARTIFACT}-{snapshot}.module",
        "main": version_dir / f"{ARTIFACT}-{snapshot}.jar",
        "sources": version_dir / f"{ARTIFACT}-{snapshot}-sources.jar",
        "javadoc": version_dir / f"{ARTIFACT}-{snapshot}-javadoc.jar",
    }
    files["pom"].write_text(pom_text(), encoding="utf-8")
    files["module"].write_text(json.dumps(module_model()), encoding="utf-8")
    for kind in ("main", "sources", "javadoc"):
        write_jar(files[kind], kind)
    if VERSION.endswith("-SNAPSHOT"):
        entries = "".join(f"<snapshotVersion><extension>{extension}</extension>{f'<classifier>{classifier}</classifier>' if classifier else ''}<value>{snapshot}</value></snapshotVersion>" for extension, classifier in KINDS.values())
        (version_dir / "maven-metadata.xml").write_text(f"<metadata><groupId>{GROUP}</groupId><artifactId>{ARTIFACT}</artifactId><version>{VERSION}</version><versioning><snapshot><timestamp>{timestamp}</timestamp><buildNumber>1</buildNumber></snapshot><snapshotVersions>{entries}</snapshotVersions></versioning></metadata>", encoding="utf-8")
    for path in files.values():
        path.with_name(path.name + ".sha256").write_text(sha256(path) + "\n", encoding="ascii")
    return repository


def fixture_verify(repository: Path, version: str = "0.1.0-alpha.1-SNAPSHOT") -> tuple[list[str], dict[str, str]]:
    global REPOSITORY, VERSION, RELEASE_BASE
    original = REPOSITORY
    original_version = VERSION
    original_release_base = RELEASE_BASE
    REPOSITORY = repository
    VERSION = version
    RELEASE_BASE = VERSION.removesuffix("-SNAPSHOT")
    try:
        return verify(repository)
    finally:
        REPOSITORY = original
        VERSION = original_version
        RELEASE_BASE = original_release_base


def self_test() -> list[str]:
    errors: list[str] = []
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        for version in sorted(ALLOWED_VERSIONS):
            repository = create_fixture(root / version, version)
            baseline_errors, _ = fixture_verify(repository, version)
            if baseline_errors:
                errors.append(f"self-test rejected valid {version} publication fixture: " + "; ".join(baseline_errors))
        unsupported = "0.1.0-alpha.2"
        unsupported_repository = create_fixture(root / unsupported, unsupported)
        unsupported_errors, _ = fixture_verify(unsupported_repository, unsupported)
        if not any("publication version must be exactly" in error for error in unsupported_errors):
            errors.append(f"self-test accepted unsupported publication version: {unsupported_errors}")

        create_fixture(root, "0.1.0-alpha.1-SNAPSHOT")

        def mutate_and_check(name: str, mutate: Any, expected: str) -> None:
            case_root = root / name.replace(" ", "-")
            case_repository = create_fixture(case_root, "0.1.0-alpha.1-SNAPSHOT")
            mutate(case_repository)
            actual, _ = fixture_verify(case_repository, "0.1.0-alpha.1-SNAPSHOT")
            if not any(expected in error for error in actual):
                errors.append(f"self-test accepted {name} without {expected!r}: {actual}")

        def version_dir(repo: Path) -> Path:
            return repo.joinpath(*GROUP.split("."), ARTIFACT, VERSION)

        def artifact(repo: Path, suffix: str) -> Path:
            return next(version_dir(repo).glob(f"*{suffix}"))

        def mutate_pom(repo: Path, old: str, new: str) -> None:
            path = artifact(repo, ".pom")
            path.write_text(path.read_text().replace(old, new, 1))

        def mutate_module(repo: Path, mutate: Any) -> None:
            path = artifact(repo, ".module")
            model = json.loads(path.read_text())
            mutate(model)
            path.write_text(json.dumps(model))

        def mutate_checksum(repo: Path, content: bytes) -> None:
            path = artifact(repo, ".pom")
            path.with_name(path.name + ".sha256").write_bytes(content)

        def pom_digest(repo: Path) -> str:
            return sha256(artifact(repo, ".pom"))

        mutations = (
            ("wrong group", lambda repo: mutate_pom(repo, f"<groupId>{GROUP}</groupId>", "<groupId>wrong</groupId>"), "POM: groupId"),
            ("wrong artifact", lambda repo: mutate_pom(repo, f"<artifactId>{ARTIFACT}</artifactId>", "<artifactId>wrong</artifactId>"), "POM: artifactId"),
            ("wrong version", lambda repo: mutate_pom(repo, f"<version>{VERSION}</version>", "<version>0.1.0-alpha.2-SNAPSHOT</version>"), "POM: version"),
            ("missing GPL", lambda repo: mutate_pom(repo, GPL_NAME, "Other"), "GPLv3 license metadata"),
            ("wrong SCM", lambda repo: mutate_pom(repo, SCM, "scm:git:https://invalid",), "SCM metadata"),
            ("wrong explicit SCM tag", lambda repo: mutate_pom(repo, "</scm>", "<tag>release</tag></scm>"), "SCM metadata"),
            ("empty explicit SCM tag", lambda repo: mutate_pom(repo, "</scm>", "<tag></tag></scm>"), "<tag> is empty"),
            ("duplicate SCM tag", lambda repo: mutate_pom(repo, "</scm>", "<tag>HEAD</tag><tag>HEAD</tag></scm>"), "expected at most one <tag>"),
            ("wrong developer", lambda repo: mutate_pom(repo, f"<id>{DEVELOPER['id']}</id>", "<id>someone</id>"), "developer metadata"),
            ("wrong issues", lambda repo: mutate_pom(repo, ISSUES_URL, "https://invalid/issues"), "issue-management metadata"),
            ("missing predecessor", lambda repo: mutate_pom(repo, PROPERTIES["tvheadend.htsp.predecessor.name"], "Unknown"), "predecessor/notice properties"),
            ("forbidden dependency", lambda repo: mutate_pom(repo, "org.jetbrains.kotlinx", "androidx.media3"), "dependencies"),
            ("non-JVM POM coroutines dependency", lambda repo: mutate_pom(repo, "kotlinx-coroutines-core-jvm", "kotlinx-coroutines-core"), "dependencies"),
            ("wrong JVM metadata", lambda repo: mutate_module(repo, lambda model: model["variants"][0]["attributes"].update({"org.gradle.jvm.version": 11})), "advertise JVM library version"),
            ("forbidden metadata dependency", lambda repo: mutate_module(repo, lambda model: model["variants"][0]["dependencies"].append({"group": "androidx.media3", "module": "media3", "version": {"requires": "1"}})), "dependencies"),
            ("JVM-specific module coroutines dependency", lambda repo: mutate_module(repo, lambda model: model["variants"][0]["dependencies"][1].update({"module": "kotlinx-coroutines-core-jvm"})), "dependencies"),
            ("missing sources", lambda repo: artifact(repo, "-sources.jar").unlink(), "sources: required regular artifact is missing"),
            ("missing javadoc", lambda repo: artifact(repo, "-javadoc.jar").unlink(), "javadoc: required regular artifact is missing"),
            ("missing main", lambda repo: next(path for path in version_dir(repo).glob("*.jar") if "-sources.jar" not in path.name and "-javadoc.jar" not in path.name).unlink(), "main: required regular artifact is missing"),
            ("missing checksum", lambda repo: artifact(repo, ".pom.sha256").unlink(), "missing regular SHA-256 sidecar"),
            ("checksum appended tokens", lambda repo: mutate_checksum(repo, f"{pom_digest(repo)} tokens\n".encode("ascii")), "malformed SHA-256 sidecar"),
            ("checksum extra lines", lambda repo: mutate_checksum(repo, f"{pom_digest(repo)}\nextra\n".encode("ascii")), "malformed SHA-256 sidecar"),
            ("checksum whitespace change", lambda repo: mutate_checksum(repo, f" {pom_digest(repo)}\n".encode("ascii")), "malformed SHA-256 sidecar"),
            ("checksum uppercase", lambda repo: mutate_checksum(repo, f"{pom_digest(repo).upper()}\n".encode("ascii")), "malformed SHA-256 sidecar"),
            ("checksum missing newline", lambda repo: mutate_checksum(repo, pom_digest(repo).encode("ascii")), "malformed SHA-256 sidecar"),
            ("checksum malformed encoding", lambda repo: mutate_checksum(repo, b"\xff\n"), "malformed SHA-256 sidecar"),
            ("wrong checksum", lambda repo: mutate_checksum(repo, ("0" * 64 + "\n").encode("ascii")), "does not match artifact bytes"),
            ("wrong class major", lambda repo: write_jar(next(path for path in version_dir(repo).glob("*.jar") if "-sources.jar" not in path.name and "-javadoc.jar" not in path.name), "main", wrong_major=True), "not class major 61"),
            ("extra artifact", lambda repo: (version_dir(repo) / "unexpected.aar").write_bytes(b"x"), "extra files"),
            ("extra module", lambda repo: (repo.joinpath(*GROUP.split("."), "other")).mkdir(), "exactly the htsp module"),
            ("wrong notice", lambda repo: mutate_pom(repo, PROPERTIES["tvheadend.htsp.notice.path"], "MISSING.md"), "predecessor/notice properties"),
        )
        for name, mutate, expected in mutations:
            mutate_and_check(name, mutate, expected)

        def symlink_case(repo: Path) -> None:
            target = version_dir(repo) / "target"
            target.write_text("x")
            (version_dir(repo) / "escape").symlink_to(target)
        mutate_and_check("symlink escape", symlink_case, "symlink/escape")
    return errors


def manifest_path(argument: str) -> Path:
    path = Path(argument)
    if not path.is_absolute():
        path = ROOT / path
    absolute = path.absolute()
    build = (ROOT / "build").absolute()
    if absolute == build or build not in absolute.parents:
        raise ValueError("manifest path must be below checkout build/")
    current = ROOT
    for part in absolute.relative_to(ROOT).parts[:-1]:
        current /= part
        if current.exists() and current.is_symlink():
            raise ValueError("manifest path must not traverse symlinks")
    return absolute


def main() -> int:
    args = sys.argv[1:]
    if args == ["--self-test"]:
        errors = self_test()
        manifest: dict[str, str] = {}
        success = "Published JVM compatibility hostile self-tests passed"
    elif not args or (len(args) == 2 and args[0] in {"--write-manifest", "--compare-manifest"}):
        errors, manifest = verify()
        success = "Published JVM compatibility passed"
        if not errors and args:
            try:
                path = manifest_path(args[1])
                if args[0] == "--write-manifest":
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
                else:
                    expected = json.loads(path.read_text(encoding="utf-8"))
                    if expected != manifest:
                        errors.append(f"recreated publication bytes differ: expected {expected}, actual {manifest}")
            except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
                errors.append(f"publication manifest operation failed: {error}")
    else:
        print("usage: check-published-jvm-compatibility [--self-test|--write-manifest PATH|--compare-manifest PATH]", file=sys.stderr)
        return 2
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print(success + ": one JVM 17 htsp publication, five checksummed artifacts, exact metadata/dependencies, and no Android/native graph")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
